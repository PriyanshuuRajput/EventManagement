                            <!-- Footer -->
                            <div class=" d-flex justify-content-end align-items-center">
                                <button class="btn btn-outline-secondary m-2 shadow-lg" @onclick="() => showEventModal = false">Cancel</button>
                                <button class="btn btn-danger m-2 shadow-lg ">Save</button>
                            </div>

                        </EditForm>
                    </div>
                </div>
            @*</div>
                </div>*@


            }


            @if (showVenueModal)
            {
                <div class="modal fade show d-block" style="background:rgba(0,0,0,0.5);">
                    <div class="modal-dialog modal-md modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                            <div class="modal-header border-danger">
                                <h5 class="modal-title">@((editingVenue?.Id != 0 ? "Edit Venue" : "Add Venue"))</h5>
                                <button type="button" class="btn-close" @onclick="() => showVenueModal = false"></button>
                            </div>
                            <div class="modal-body">
                                <EditForm Model="editingVenue" OnValidSubmit="async () => await SaveVenue(editingVenue)">
                                    <DataAnnotationsValidator />
                                    <div class="mb-2">
                                        <label>Name</label>
                                        <InputText @bind-Value="editingVenue.VenueName" class="form-control" />
                                    </div>
                                    <div class="mb-2">
                                        <label>City</label>
                                        <select class="form-select" @bind="editingVenue.CityId">
                                            <option value="">Select City</option>
                                            @foreach (var city in citiesList)
                                            {
                                                <option value="@city.Id">@city.CityName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-2">
                                        <label>Address</label>
                                        <InputText @bind-Value="editingVenue.Address" class="form-control" />
                                    </div>
                                    <div class="mb-2">
                                        <label>Capacity</label>
                                        <InputNumber @bind-Value="editingVenue.Capacity" class="form-control" />
                                    </div>
                                </EditForm>
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-secondary" @onclick="() => showVenueModal = false">Cancel</button>
                                <button class="btn btn-danger" @onclick="async () => await SaveVenue(editingVenue)">Save</button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (showCityModal)
            {
                <div class="modal fade show d-block" style="background:rgba(0,0,0,0.5);">
                    <div class="modal-dialog modal-md modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                            <div class="modal-header border-danger">
                                <h5 class="modal-title">@((editingCity?.Id != 0 ? "Edit City" : "Add City"))</h5>
                                <button type="button" class="btn-close" @onclick="() => showCityModal = false"></button>
                            </div>

                            <div class="modal-body">
                                <EditForm Model="editingCity" OnValidSubmit="async () => await SaveCity(editingCity)">
                                    <DataAnnotationsValidator />

                                    <div class="mb-2">
                                        <label class="form-label fw-semibold text-secondary">City Name</label>
                                        <InputText @bind-Value="editingCity.CityName" class="form-control rounded-3 shadow-sm p-2" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-secondary">State</label>
                                        <select @bind="editingCity.StateId" class="form-control rounded-3 shadow-sm p-2" disabled="@(!filteredStates.Any())">
                                            <option value="">🏷️ Select a state...</option>
                                            @foreach (var state in filteredStates)
                                            {
                                                <option value="@state.Id">@state.Name</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-secondary">Country</label>
                                        <select value="@editingCity.CountryId" @onchange="OnCountryChanged" class="form-control rounded-3 shadow-sm p-2">
                                            <option value="">🌍 Select a country...</option>
                                            @foreach (var country in _allCountries)
                                            {
                                                <option value="@country.Id">@country.Name</option>
                                            }
                                        </select>
                                    </div>

                                </EditForm>
                            </div>

                            <div class="modal-footer">
                                <button class="btn btn-secondary" @onclick="() => showCityModal = false">Cancel</button>
                                <button class="btn btn-danger"
                                        @onclick="async () => await SaveCity(editingCity)"
                                        disabled="@(string.IsNullOrWhiteSpace(editingCity.CityName) ||
                    editingCity.CountryId == Guid.Empty ||
                    editingCity.StateId == Guid.Empty)">
                                    💾 Save
                                </button>

                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="promo-banner banner mt-4 text-center">
                <h4 class="fw-bold text-dark mb-1">
                    <i class="bi bi-collection-play text-danger me-2"></i>
                    Streamline Your Events
                </h4>

                <p class="text-muted small m-0">
                    Manage bookings, venues, and cities with ease.
                </p>
            </div>

        </div>
    </div>
</div>


@code {
    private List<EventDto> Events = new();
    private List<EventDto> FilteredEvents = new();
    private List<CountryDto> countries = new();
    private List<CountryDto> _allCountries = new();
    private List<StateDto> states = new();
    private List<StateDto> filteredStates = new();
    private List<string> cities = new();
    private Guid? selectedCountryId;
    private Guid? selectedStateId;
    private List<string> categories = new();

    private bool showEventModal = false;
    private bool isAdmin = false;
    private bool isManager = false;

    private EventDto editingEvent = new();

    private string selectedDateFilter = "all";
    private bool isCustomRangeEnabled = false;
    private DateTime? customStartDate;
    private DateTime? customEndDate;
    private string selectedCity = string.Empty;
    private List<string> selectedCategories = new();
    private (decimal min, decimal max)? selectedPriceRange;

    private string activeTab = "events";

    private List<VenueDto> venues = new();
    private VenueDto editingVenue = new();
    private bool showVenueModal = false;

    private List<CityDto> citiesList = new();
    private CityDto editingCity = new();
    private bool showCityModal = false;

    private string durationInput = string.Empty;
    private IBrowserFile? selectedImageFile;


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        isAdmin = user.IsInRole("Admin");
        isManager = user.IsInRole("Manager");

        if (isAdmin)
        {
            await LoadAdminEvents();
        }
        else if (isManager)
        {
            await LoadManagerEvents();
        }

        await LoadCities();
        await LoadVenues();
        await LoadCountriesAsync();

        cities = Events.Select(e => e.CityName).Distinct().OrderBy(c => c).ToList()!;
        categories = Events.Select(e => e.EventType).Distinct().OrderBy(c => c).ToList();

        CalculateVenueEventCounts();
        CalculateCityCounts();
    }

    private void HandleInvalidSubmit()
    {
        Console.WriteLine("Form validation failed. Please fill all required fields.");
    }



    private async Task LoadAdminEvents()
    {
        Events = await AdminService.GetAllEventsAsync();
        FilteredEvents = Events;
        CalculateCityCounts();
    }

    private async Task LoadManagerEvents()
    {
        Events = await Http.GetFromJsonAsync<List<EventDto>>("api/ManagerEvent/my-events");
        FilteredEvents = Events!;
    }

    private void ShowAddEventModal()
    {
        editingEvent = new EventDto();

        var now = DateTime.Now;
        var rounded = new DateTime(now.Year, now.Month, now.Day, now.Hour, (now.Minute < 30 ? 30 : 0), 0);
        if (rounded < now)
            rounded = rounded.AddHours(1);

        editingEvent.ShowDate = rounded;
        showEventModal = true;
    }

    private void ShowEditEventModal(EventDto evt)
    {
        editingEvent = new EventDto
        {
            Id = evt.Id,
            Title = evt.Title,
            EventType = evt.EventType,
            Description = evt.Description,
            Language = evt.Language,
            Genre = evt.Genre,
            VenueId = evt.VenueId,
            TicketPrice = evt.TicketPrice,
            ImageUrl = evt.ImageUrl,
            ShowDate = evt.ShowDate,
            Duration = evt.Duration,
            CityId = evt.CityId
        };

        showEventModal = true;
    }

    private async Task SaveEvent(EventDto evt)
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            // =============== Manager Restrictions ==================
            if (isManager)
            {
                var existing = Events.FirstOrDefault(e => e.Id == evt.Id);

                if (existing != null &&
                    (existing.Status == EventStatus.AdminApproved ||
                     existing.Status == EventStatus.PaymentConfirmed))
                {
                    toastService.ShowWarning("This event is approved or published. Manager cannot edit. Contact admin.");
                    return;
                }
            }
            // BUILD MULTIPART FORM ONLY ONCE (CRITICAL FIX)
            var content = new MultipartFormDataContent();

            content.Add(new StringContent(evt.Title), "Title");
            content.Add(new StringContent(evt.EventType), "EventType");
            content.Add(new StringContent(evt.Description ?? ""), "Description");
            content.Add(new StringContent(evt.Genre ?? ""), "Genre");
            content.Add(new StringContent(evt.Language ?? ""), "Language");
            content.Add(new StringContent(evt.VenueId.ToString()), "VenueId");
            content.Add(new StringContent(evt.CityId.ToString()), "CityId");


            // Ensure Duration format correct
            content.Add(new StringContent(evt.Duration.ToString(@"hh\:mm\:ss")), "Duration");

            content.Add(new StringContent(evt.ShowDate.ToString("yyyy-MM-ddTHH:mm:ss")), "ShowDate");
            //content.Add(new StringContent(evt.VenueId.ToString()), "VenueId");

            content.Add(new StringContent(evt.TicketPrice.ToString(
                System.Globalization.CultureInfo.InvariantCulture)), "TicketPrice");

            // =================== IMAGE UPLOAD ===================
            if (selectedImageFile != null)
            {
                var stream = selectedImageFile.OpenReadStream(maxAllowedSize: 5_000_000);
                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType =
                    new System.Net.Http.Headers.MediaTypeHeaderValue(selectedImageFile.ContentType);

                content.Add(fileContent, "ImageFile", selectedImageFile.Name);
            }

            HttpResponseMessage response;
            // ADMIN SECTION

            if (isAdmin)
            {
                if (evt.Id > 0)
                {
                    await AdminService.UpdateEventAsync(evt.Id, evt, selectedImageFile);
                    toastService.ShowSuccess("Event updated successfully.");
                }
                else
                {
                    await AdminService.AddEventAsync(evt, selectedImageFile);
                    toastService.ShowSuccess("Event created successfully.");
                }

                await LoadAdminEvents();
                showEventModal = false;
                selectedImageFile = null; // reset
                return;
            }
            // MANAGER SECTION

            if (isManager)
            {
                if (evt.Id > 0)
                {
                    // Update existing event
                    response = await Http.PutAsync($"api/ManagerEvent/update/{evt.Id}", content);
                }
                else
                {
                    // Create new event
                    response = await Http.PostAsync("api/ManagerEvent/create", content);
                }

                var body = await response.Content.ReadAsStringAsync();
                Console.WriteLine("MANAGER API RESPONSE: " + body);

                if (!response.IsSuccessStatusCode)
                {
                    toastService.ShowError(body);
                    return;
                }

                toastService.ShowSuccess("Event saved successfully!");
                await LoadManagerEvents();
                showEventModal = false;
            }

            selectedImageFile = null; // clear file after save
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error: " + ex.Message);
            Console.WriteLine("Save Event Error: " + ex);
        }
    }



    private async Task DeleteEvent(int eventId)
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        try
        {
            if (user.IsInRole("Admin"))
            {
                await AdminService.DeleteEventAsync(eventId);
            }
            else if (user.IsInRole("Manager"))
            {
                await Http.DeleteAsync($"api/ManagerEvent/delete/{eventId}");
            }

            // Refresh events after delete
            if (user.IsInRole("Admin"))
                await LoadAdminEvents();
            else if (user.IsInRole("Manager"))
                await LoadManagerEvents();

            CalculateCityCounts();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Delete failed: " + ex.Message);
        }
    }




    private async Task LoadCountriesAsync()
    {
        try
        {
            _allCountries = await Http.GetFromJsonAsync<List<CountryDto>>("api/countries");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading Countries :{ex.Message}");
        }
    }

    private async Task<IEnumerable<CountryDto>> SearchCountries(string searchText)
    {

        _allCountries = await AdminService.GetAllCountriesAsync();
        return _allCountries
            .Where(c => c.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
    private async Task OnCountryChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var countryId))
        {
            editingCity.CountryId = countryId;
            filteredStates = await AdminService.GetStatesByCountryAsync(countryId);
            editingCity.StateId = Guid.Empty;
        }
        else
        {
            filteredStates.Clear();
            editingCity.StateId = Guid.Empty;

        }
    }


    private async Task LoadVenues()
    {
        venues = await AdminService.GetAllVenuesAsync();
        CalculateCityCounts();
    }


    private void ShowAddVenueModal()
    {
        editingVenue = new VenueDto();
        showVenueModal = true;
    }


    private void EditVenue(VenueDto v)
    {
        editingVenue = v;

        showVenueModal = true;
    }

    private async Task SaveVenue(VenueDto v)
    {
        if (v.Id != 0)
            await AdminService.UpdateVenueAsync(v.Id, v);
        else
            await AdminService.AddVenueAsync(v);

        await LoadVenues();
        CalculateCityCounts();
        showVenueModal = false;
    }


    private async Task DeleteVenue(int id)
    {
        await AdminService.DeleteVenueAsync(id);
        await LoadVenues();
        CalculateCityCounts();
    }

    // ====== CITY MANAGEMENT ======


    private async Task LoadCities()
    {
        citiesList = await AdminService.GetAllCitiesAsync();
        CalculateCityCounts();
    }

    private void ShowAddCityModal()
    {
        editingCity = new CityDto();
        showCityModal = true;
    }

    private void EditCity(CityDto c)
    {
        editingCity = c;
        showCityModal = true;
    }

    private async Task SaveCity(CityDto c)
    {
        try
        {
            // 1️Validate dropdown selections (these stay Guid since Country/State use Guid)
            if (c.CountryId == Guid.Empty)
            {
                toastService.ShowError("Please select a country before saving the city.");
                return;
            }

            if (c.StateId == Guid.Empty)
            {
                toastService.ShowError("Please select a state before saving the city.");
                return;
            }

            if (string.IsNullOrWhiteSpace(c.CityName))
            {
                toastService.ShowError("City name cannot be empty.");
                return;
            }

            //  Build city object (no Guid.NewGuid here — because City.Id is int)
            var city = new CityDto
            {
                Id = c.Id, // leave it as is — backend will assign a new ID if it's 0
                CityName = c.CityName.Trim(),
                CountryId = c.CountryId,
                StateId = c.StateId
            };

            // 3 Save — call Add or Update depending on ID
            if (city.Id == 0)
            {
                await AdminService.AddCityAsync(city);
                toastService.ShowSuccess("✅ City added successfully!");
            }
            else
            {
                await AdminService.UpdateCityAsync(city.Id, city);
                toastService.ShowSuccess("✅ City updated successfully!");
            }

            showCityModal = false;
            await LoadCities(); // refresh list
            CalculateCityCounts();
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Unexpected error: {ex.Message}");
        }
    }


    private async Task DeleteCity(int id)
    {
        await AdminService.DeleteCityAsync(id);
        await LoadCities();
        CalculateCityCounts();
    }


    private void ApplyFilters()
    {
        var filtered = Events.AsEnumerable();
        if (selectedDateFilter == "today")
            filtered = filtered.Where(e => e.ShowDate.Date == DateTime.Today);
        else if (selectedDateFilter == "tomorrow")
            filtered = filtered.Where(e => e.ShowDate.Date == DateTime.Today.AddDays(1));
        else if (selectedDateFilter == "weekend")
            filtered = filtered.Where(e => new[] { DayOfWeek.Saturday, DayOfWeek.Sunday }.Contains(e.ShowDate.DayOfWeek));
        else if (selectedDateFilter == "custom" && customStartDate.HasValue && customEndDate.HasValue)
            filtered = filtered.Where(e => e.ShowDate.Date >= customStartDate.Value.Date && e.ShowDate.Date <= customEndDate.Value.Date);

        if (selectedCategories.Any())
            filtered = filtered.Where(e => selectedCategories.Contains(e.EventType));

        if (!string.IsNullOrWhiteSpace(selectedCity))
            filtered = filtered.Where(e => e.CityName.Equals(selectedCity, StringComparison.OrdinalIgnoreCase));

        if (selectedPriceRange.HasValue)
        {
            var (min, max) = selectedPriceRange.Value;
            if (min == 0 && max == 0)
                filtered = filtered.Where(e => e.TicketPrice == 0);
            else
                filtered = filtered.Where(e => e.TicketPrice >= min && e.TicketPrice <= max);
        }
        FilteredEvents = filtered.ToList();
    }

    private void ClearAllFilters()
    {
        selectedDateFilter = "all";
        isCustomRangeEnabled = false;
        customStartDate = null;
        customEndDate = null;
        selectedCategories.Clear();
        selectedCity = string.Empty;
        selectedPriceRange = null;
        FilteredEvents = Events;
    }

    private void SetDateFilter(string filter)
    {
        selectedDateFilter = filter;
        isCustomRangeEnabled = false;
        ApplyFilters();
    }

    private void ClearDateFilter()
    {
        selectedDateFilter = "all";
        isCustomRangeEnabled = false;
        customStartDate = null;
        customEndDate = null;
        ApplyFilters();
    }

    private void ApplyCustomDateFilter()
    {
        selectedDateFilter = "custom";
        ApplyFilters();
    }

    private string GetDateButtonClass(string filter)
        => selectedDateFilter == filter ? "btn btn-outline-danger btn-sm active" : "btn btn-outline-secondary btn-sm";

    private void ToggleCategory(string category)
    {
        if (selectedCategories.Contains(category))
            selectedCategories.Remove(category);
        else
            selectedCategories.Add(category);
        ApplyFilters();
    }

    private void FilterCity(ChangeEventArgs e)
    {
        selectedCity = e.Value?.ToString() ?? string.Empty;
        ApplyFilters();
    }

    private void SetPriceRange(decimal min, decimal max)
    {
        selectedPriceRange = (min, max);
        ApplyFilters();
    }

    private string GetPriceButtonClass(decimal min, decimal max)
    {
        if (selectedPriceRange.HasValue && selectedPriceRange.Value.min == min && selectedPriceRange.Value.max == max)
            return "btn btn-outline-danger btn-sm active";
        return "btn btn-outline-secondary btn-sm";
    }



    private void CalculateCityCounts()
    {
        if (citiesList == null || citiesList.Count == 0)
            return;

        foreach (var city in citiesList)
        {
            city.VenueCount = venues.Count(v => v.CityId == city.Id);
            city.EventCount = Events.Count(e => e.CityName.Equals(city.CityName, StringComparison.OrdinalIgnoreCase));
        }
    }
    private void CalculateVenueEventCounts()
    {
        foreach (var venue in venues)
        {
            // Count events that belong to this venue
            venue.EventCount = Events.Count(e =>
    e.CityName.Equals(venue.CityName, StringComparison.OrdinalIgnoreCase));

        }
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        selectedImageFile = e.File;
    }


}


