    private List<StateDto> states = new();
    private List<StateDto> filteredStates = new();
    private List<string> cities = new();
    private Guid? selectedCountryId;
    private Guid? selectedStateId;
    private List<string> categories = new();

    private bool showEventModal = false;
    private bool isAdmin = false;
    private bool isManager = false;

    private EventDto editingEvent = new();

    private string selectedDateFilter = "all";
    private bool isCustomRangeEnabled = false;
    private DateTime? customStartDate;
    private DateTime? customEndDate;
    private string selectedCity = string.Empty;
    private List<string> selectedCategories = new();
    private (decimal min, decimal max)? selectedPriceRange;

    private string activeTab = "events";

    private List<VenueDto> venues = new();
    private VenueDto editingVenue = new();
    private bool showVenueModal = false;
    private List<VenueDto> FilteredVenues = new();
    private string venueSearch = string.Empty;
    private List<VenueDto> filteredVenues = new();


    private List<CityDto> citiesList = new();
    private CityDto editingCity = new();
    private bool showCityModal = false;
    private List<CityDto> FilteredCities = new();
    private Guid? selectedCountryFilter;
    private Guid? selectedStateFilter;
    private string citySearch = string.Empty;

    private string durationInput = string.Empty;
    private string? durationError;
    private IBrowserFile? selectedImageFile;

    private bool showDeleteModal = false;
    private int deleteEventId;

    private string? eventTypeError;
    private string? genreError;


    private string managerSearch = string.Empty;

    private void ValidateTypeGenre()
    {
        var et = editingEvent.EventType?.Trim() ?? "";
        var ge = editingEvent.Genre?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(et) && string.IsNullOrWhiteSpace(ge))
        {
            eventTypeError = "EventType or Genre is required";
            genreError = "EventType or Genre is required";
        }
        else
        {
            eventTypeError = null;
            genreError = null;
        }
    }


    private void ValidateDuration(string value)
    {
        durationInput = value;


        if (!TimeSpan.TryParse(durationInput, out var _))
        {
            durationError = "Enter valid duration in HH:mm format (e.g., 02:30)";
        }
        else
        {
            durationError = null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        isAdmin = user.IsInRole("Admin");
        isManager = user.IsInRole("Manager");

        if (isAdmin)
        {
            await LoadAdminEvents();
        }
        else if (isManager)
        {
            await LoadManagerEvents();
        }

        await LoadCities();
        await LoadVenues();
        await LoadCountriesAsync();

        cities = Events.Select(e => e.CityName).Distinct().OrderBy(c => c).ToList()!;
        categories = Events.Select(e => e.EventType).Distinct().OrderBy(c => c).ToList();

        CalculateVenueEventCounts();
        CalculateCityCounts();
        filteredVenues = venues.ToList();

    }

    private void HandleInvalidSubmit()
    {
        Console.WriteLine("Form validation failed. Please fill all required fields.");
    }



    private async Task LoadAdminEvents()
    {
        Events = await AdminService.GetAllEventsAsync();
        FilteredEvents = Events;
        CalculateCityCounts();
    }

    private async Task LoadManagerEvents()
    {
        Events = await Http.GetFromJsonAsync<List<EventDto>>("api/ManagerEvent/my-events");
        FilteredEvents = Events!;
    }

    private void ShowAddEventModal()
    {
        editingEvent = new EventDto();

        var now = DateTime.Now;
        var rounded = new DateTime(now.Year, now.Month, now.Day, now.Hour, (now.Minute < 30 ? 30 : 0), 0);
        if (rounded < now)
            rounded = rounded.AddHours(1);

        editingEvent.ShowDate = rounded;
        showEventModal = true;
    }

    private void ShowEditEventModal(EventDto evt)
    {
        editingEvent = new EventDto
        {
            Id = evt.Id,
            Title = evt.Title,
            EventType = evt.EventType,
            Description = evt.Description,
            Language = evt.Language,
            Genre = evt.Genre,
            VenueId = evt.VenueId,
            TicketPrice = evt.TicketPrice,
            ImageUrl = evt.ImageUrl,
            ShowDate = evt.ShowDate,
            Duration = evt.Duration,
            CityId = evt.CityId
        };

        showEventModal = true;
    }

    private bool ConvertDuration()
    {
        durationError = string.Empty;

        if (!TimeSpan.TryParse(durationInput, out var ts))
        {
            durationError = "Invalid format. Use HH:mm (e.g., 01:30).";
            return false;
        }

        if (ts.TotalMinutes < 10)
        {
            durationError = "Duration must be at least 10 minutes.";
            return false;
        }

        editingEvent.Duration = ts;
        return true;
    }

    private async Task SaveEvent(EventDto evt)
    {
        try
        {
            if (!ConvertDuration())
            {
                toastService.ShowError("Invalid duration format. Use HH:mm (e.g., 02:30).");
                return;
            }
            if (string.IsNullOrWhiteSpace(editingEvent.EventType) &&
    string.IsNullOrWhiteSpace(editingEvent.Genre))
            {
                ValidateTypeGenre();
                toastService.ShowError("Please fill at least EventType or Genre.");
                return;
            }


            var content = new MultipartFormDataContent();

            content.Add(new StringContent(evt.Title ?? ""), "Title");
            content.Add(new StringContent(evt.EventType ?? ""), "EventType");
            content.Add(new StringContent(evt.Description ?? ""), "Description");
            content.Add(new StringContent(evt.Genre ?? ""), "Genre");
            content.Add(new StringContent(evt.Language ?? ""), "Language");

            if (evt.VenueId > 0)
                content.Add(new StringContent(evt.VenueId.ToString()), "VenueId");

            if (evt.CityId.HasValue && evt.CityId > 0)
                content.Add(new StringContent(evt.CityId.Value.ToString()), "CityId");

            content.Add(new StringContent(evt.Duration.ToString(@"hh\:mm\:ss")), "Duration");
            content.Add(new StringContent(evt.ShowDate.ToString("yyyy-MM-ddTHH:mm:ss")), "ShowDate");
            content.Add(new StringContent(evt.TicketPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)), "TicketPrice");

            // IMAGE
            if (selectedImageFile != null)
            {
                var stream = selectedImageFile.OpenReadStream(10_000_000);
                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(selectedImageFile.ContentType);
                content.Add(fileContent, "ImageFile", selectedImageFile.Name);
            }
            else if (evt.Id > 0)
            {
                content.Add(new StringContent(evt.ImageUrl ?? ""), "ImageUrl");
            }


            // MANAGER FLOW

            if (isManager)
            {
                HttpResponseMessage response;

                if (evt.Id > 0)
                    response = await Http.PutAsync($"api/ManagerEvent/update/{evt.Id}", content);
                else
                    response = await Http.PostAsync("api/ManagerEvent/create", content);

                string body = await response.Content.ReadAsStringAsync();

                if (!response.IsSuccessStatusCode)
                {
                    toastService.ShowError(body);
                    return;
                }

                toastService.ShowSuccess("Event saved successfully.");
                await LoadManagerEvents();

                showEventModal = false;
                selectedImageFile = null;
                return;
            }


            // ADMIN FLOW

            if (isAdmin)
            {
                if (evt.Id > 0)
                    await AdminService.UpdateEventAsync(evt.Id, evt, selectedImageFile);
                else
                    await AdminService.AddEventAsync(evt, selectedImageFile);

                toastService.ShowSuccess("Event saved successfully!");

                await LoadAdminEvents();

                showEventModal = false;
                selectedImageFile = null;
                return;
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error: " + ex.Message);
            Console.WriteLine("Save Event Error: " + ex);
        }
    }


    private void OpenDeleteModal(int id)
    {
        deleteEventId = id;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
    }

    private async Task DeleteConfirmed()
    {
        await DeleteEvent(deleteEventId);
        showDeleteModal = false;
    }

    private async Task DeleteEvent(int eventId)
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        try
        {
            if (user.IsInRole("Admin"))
            {
                await AdminService.DeleteEventAsync(eventId);
            }
            else if (user.IsInRole("Manager"))
            {
                await Http.DeleteAsync($"api/ManagerEvent/delete/{eventId}");
            }

            if (user.IsInRole("Admin"))
                await LoadAdminEvents();
            else
                await LoadManagerEvents();

            CalculateCityCounts();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Delete failed: " + ex.Message);
        }
    }



    private async Task LoadCountriesAsync()
    {
        try
        {
            _allCountries = await Http.GetFromJsonAsync<List<CountryDto>>("api/countries");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading Countries :{ex.Message}");
        }
    }

    private async Task<IEnumerable<CountryDto>> SearchCountries(string searchText)
    {

        _allCountries = await AdminService.GetAllCountriesAsync();
        return _allCountries
            .Where(c => c.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
    private async Task OnCountryChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var countryId))
        {
            editingCity.CountryId = countryId;
            filteredStates = await AdminService.GetStatesByCountryAsync(countryId);
            editingCity.StateId = Guid.Empty;
        }
        else
        {
            filteredStates.Clear();
            editingCity.StateId = Guid.Empty;

        }
    }


    private async Task LoadVenues()
    {
        venues = await AdminService.GetAllVenuesAsync();
        FilteredVenues = venues;
    }


    private void ShowAddVenueModal()
    {
        editingVenue = new VenueDto();
        showVenueModal = true;
    }


    private void EditVenue(VenueDto v)
    {
        editingVenue = v;

        showVenueModal = true;
    }

    private async Task SaveVenue(VenueDto v)
    {
        if (v.Id != 0)
            await AdminService.UpdateVenueAsync(v.Id, v);
        else
            await AdminService.AddVenueAsync(v);

        await LoadVenues();
        CalculateCityCounts();
        showVenueModal = false;
    }


    private async Task DeleteVenue(int id)
    {
        await AdminService.DeleteVenueAsync(id);
        await LoadVenues();
        CalculateCityCounts();
    }

    // ====== CITY MANAGEMENT ======


    private async Task LoadCities()
    {
        citiesList = await AdminService.GetAllCitiesAsync();
        FilteredCities = citiesList;
    }

    private void ShowAddCityModal()
    {
        editingCity = new CityDto();
        showCityModal = true;
    }

    private void EditCity(CityDto c)
    {
        editingCity = c;
        showCityModal = true;
    }

    private async Task SaveCity(CityDto c)
    {
        try
        {
            // 1️Validate dropdown selections (these stay Guid since Country/State use Guid)
            if (c.CountryId == Guid.Empty)
            {
                toastService.ShowError("Please select a country before saving the city.");
                return;
            }

            if (c.StateId == Guid.Empty)
            {
                toastService.ShowError("Please select a state before saving the city.");
                return;
            }

            if (string.IsNullOrWhiteSpace(c.CityName))
            {
                toastService.ShowError("City name cannot be empty.");
                return;
            }

            //  Build city object (no Guid.NewGuid here — because City.Id is int)
            var city = new CityDto
            {
                Id = c.Id, // leave it as is — backend will assign a new ID if it's 0
                CityName = c.CityName.Trim(),
                CountryId = c.CountryId,
                StateId = c.StateId
            };

            // 3 Save — call Add or Update depending on ID
            if (city.Id == 0)
            {
                await AdminService.AddCityAsync(city);
                toastService.ShowSuccess("City added successfully!");
            }
            else
            {
                await AdminService.UpdateCityAsync(city.Id, city);
                toastService.ShowSuccess("City updated successfully!");
            }

            showCityModal = false;
            await LoadCities();
            CalculateCityCounts();
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Unexpected error: {ex.Message}");
        }
    }


    private async Task DeleteCity(int id)
    {
        await AdminService.DeleteCityAsync(id);
        await LoadCities();
        CalculateCityCounts();
    }
    private void ApplyEventFilters()
    {
        var filtered = Events.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(managerSearch))
            filtered = filtered.Where(e =>
                (e.ManagerName ?? "Admin")
                .Contains(managerSearch, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(selectedCity))
            filtered = filtered.Where(e => e.CityName == selectedCity);

        if (selectedCategories.Any())
            filtered = filtered.Where(e => selectedCategories.Contains(e.EventType));

        if (selectedPriceRange != null)
        {
            var (min, max) = selectedPriceRange.Value;
            filtered = filtered.Where(e => e.TicketPrice >= min && e.TicketPrice <= max);
        }

        filtered = ApplyDateFilter(filtered);
        FilteredEvents = filtered.ToList();
    }


    private void ApplyVenueFilters()
    {
        // If NO filter is applied → return full list
        if (string.IsNullOrWhiteSpace(selectedCity) &&
            string.IsNullOrWhiteSpace(venueSearch))
        {
            FilteredVenues = venues.ToList();
            return;
        }

        var filtered = venues.AsEnumerable();


        if (!string.IsNullOrWhiteSpace(selectedCity))
            filtered = filtered.Where(v =>
                v.CityName.Equals(selectedCity, StringComparison.OrdinalIgnoreCase));


        if (!string.IsNullOrWhiteSpace(venueSearch))
            filtered = filtered.Where(v =>
                v.VenueName.Contains(venueSearch, StringComparison.OrdinalIgnoreCase));

        FilteredVenues = filtered.ToList();
    }




    private void ApplyCityFilters()
    {
        var filtered = citiesList.AsEnumerable();


        if (selectedCountryFilter.HasValue)
            filtered = filtered.Where(c => c.CountryId == selectedCountryFilter.Value);

        if (selectedStateFilter.HasValue)
            filtered = filtered.Where(c => c.StateId == selectedStateFilter.Value);

        if (!string.IsNullOrWhiteSpace(citySearch))
            filtered = filtered.Where(c => c.CityName.Contains(citySearch, StringComparison.OrdinalIgnoreCase));

        FilteredCities = filtered.ToList();

    }


    private void FilterCountry(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        if (!string.IsNullOrWhiteSpace(value) && Guid.TryParse(value, out var id))
        {
            selectedCountryFilter = id;
        }
        else
        {
            selectedCountryFilter = null;

        }

        ApplyFilters();
    }


