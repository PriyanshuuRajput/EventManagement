    }
    private async Task OnVenueChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int venueId))
        {
            editingEvent.VenueId = venueId;


            var city = await Http.GetFromJsonAsync<CityDto>(
                $"api/cities/by-venue/{venueId}"
            );

            editingEvent.CityId = city.Id;
            filteredVenues = venues;

        }
    }


