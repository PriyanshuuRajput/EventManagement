                                        <label class="form-label fw-bold">Ticket Price (₹)<span class="text-danger">*</span></label>
                                        <InputNumber @bind-Value="editingEvent.TicketPrice" class="form-control" />
                                        <ValidationMessage For="@(() => editingEvent.TicketPrice)" class="text-danger small" />
