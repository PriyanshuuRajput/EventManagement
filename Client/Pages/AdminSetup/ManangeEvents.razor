    private void ApplyEventFilters()
    {
        var filtered = Events.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(managerSearch))
            filtered = filtered.Where(e =>
                (e.ManagerName ?? "Admin")
                .Contains(managerSearch, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(selectedCity))
            filtered = filtered.Where(e => e.CityName == selectedCity);

        if (selectedCategoryIds.Any())
            filtered = filtered.Where(e => selectedCategoryIds.Contains(e.EventCategoryId??0));

        if (selectedPriceRange != null)
        {
            var (min, max) = selectedPriceRange.Value;
            filtered = filtered.Where(e => e.TicketPrice >= min && e.TicketPrice <= max);
        }

        filtered = ApplyDateFilter(filtered);
        FilteredEvents = filtered.ToList();
    }


    private void ApplyVenueFilters()
    {
        // If NO filter is applied → return full list
        if (string.IsNullOrWhiteSpace(selectedCity) &&
            string.IsNullOrWhiteSpace(venueSearch))
        {
            FilteredVenues = venues.ToList();
            return;
        }

        var filtered = venues.AsEnumerable();


        if (!string.IsNullOrWhiteSpace(selectedCity))
            filtered = filtered.Where(v =>
                v.CityName.Equals(selectedCity, StringComparison.OrdinalIgnoreCase));


        if (!string.IsNullOrWhiteSpace(venueSearch))
            filtered = filtered.Where(v =>
                v.VenueName.Contains(venueSearch, StringComparison.OrdinalIgnoreCase));

        FilteredVenues = filtered.ToList();
    }




    private void ApplyCityFilters()
    {
        var filtered = citiesList.AsEnumerable();


        if (selectedCountryFilter.HasValue)
            filtered = filtered.Where(c => c.CountryId == selectedCountryFilter.Value);

        if (selectedStateFilter.HasValue)
            filtered = filtered.Where(c => c.StateId == selectedStateFilter.Value);

        if (!string.IsNullOrWhiteSpace(citySearch))
            filtered = filtered.Where(c => c.CityName.Contains(citySearch, StringComparison.OrdinalIgnoreCase));

        FilteredCities = filtered.ToList();

    }

    private void FilterCountry(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        if (!string.IsNullOrWhiteSpace(value) && Guid.TryParse(value, out var id))
        {
            selectedCountryFilter = id;
        }
        else
        {
            selectedCountryFilter = null;

        }

        ApplyFilters();
    }
    private void FilterCategory(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        // All Categories selected
        if (string.IsNullOrWhiteSpace(value))
        {
            selectedCategoryFilterId = null;
            FilteredCategories = categoryList.ToList();
            return;
        }

        if (int.TryParse(value, out int id))
        {
            selectedCategoryFilterId = id;

            FilteredCategories = categoryList
                .Where(c => c.Id == id)
                .ToList();
        }
      
    }
    private void ApplyCategoryFilter()
    {
        if (!selectedCategoryFilterId.HasValue)
        {
            FilteredCategories = categoryList.ToList();
            return;
        }

        FilteredCategories = categoryList
            .Where(c => c.Id == selectedCategoryFilterId.Value)
            .ToList();
    }

    private void ApplyFilters()
    {
        if (activeTab == "events")
            ApplyEventFilters();
        else if (activeTab == "venues")
            ApplyVenueFilters();
        else if (activeTab == "cities")
            ApplyCityFilters();

        else if (activeTab == "categories")
            ApplyCategoryFilter();
            
    }

