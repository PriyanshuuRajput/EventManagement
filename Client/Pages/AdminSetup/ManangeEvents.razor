                            <!-- Description -->
                            <div class="card shadow-sm mb-2">
                                <div class="card-header  text-dark fw-bold">
                                    📝 Description
                                </div>
                                <div class="card-body">
                                    <InputTextArea @bind-Value="editingEvent.Description" class="form-control" rows="3" placeholder="Write a short description..." />
                                </div>
