    private string GetCalculatedDuration()
    {
        if (editingEvent.EndDate < editingEvent.StartDate)
            return "Invalid";

        var diff = editingEvent.EndDate - editingEvent.StartDate;

        return $"{diff.Days} Days {diff.Hours} Hours {diff.Minutes} Min";
    }

    private bool ConvertDurationInput()
    {
        editingEvent.DurationError = null;

        if (string.IsNullOrWhiteSpace(editingEvent.DurationInput))
        {
            editingEvent.Duration = null;
            //editingEvent.DurationError = "Duration is required.";
            return true;
        }

        if (!TimeSpan.TryParse(editingEvent.DurationInput, out var ts))
        {
            editingEvent.DurationError = "Invalid format. Use HH:mm (e.g., 02:30).";
            return false;
        }

        if (ts.TotalMinutes < 20)
        {
            editingEvent.DurationError = "Minimum Duration is 20 minutes.";
            return false;
        }

        editingEvent.Duration = ts;
        return true;
    }

    private async Task SaveEvent()
    {
        isProcessing = true;
        StateHasChanged();

        try
        {
            var evt = editingEvent;  

            // SINGLE DAY EVENT 
            if (eventDay == "single")
            {
                if (!ConvertDurationInput() || evt.Duration == null || evt.Duration == TimeSpan.Zero)
                {
                    toastService.ShowError("Please enter valid duration.");
                    return;
                }

                evt.EndDateOnly = evt.StartDateOnly;
                evt.EndTime = evt.StartTime + evt.Duration.Value;
            }

            // MULTIPLE DAY EVENT 
            if (eventDay == "multi")
            {
                if (evt.EndDate < evt.StartDate)
                {
                    toastService.ShowError("End date cannot be earlier than start date.");
                    return;
                }

                evt.Duration = evt.EndDate - evt.StartDate;
            }

            var content = new MultipartFormDataContent();

            content.Add(new StringContent(evt.Title ?? ""), "Title");
            content.Add(new StringContent(evt.Description ?? ""), "Description");
            content.Add(new StringContent(evt.EventCategoryId!.Value.ToString()), "EventCategoryId");
            content.Add(new StringContent(evt.Language ?? ""), "Language");

            if (evt.VenueId > 0)
                content.Add(new StringContent(evt.VenueId.ToString()), "VenueId");

            content.Add(new StringContent(evt.CityId?.ToString() ?? "0"), "CityId");

            content.Add(new StringContent(evt.Duration.Value.ToString(@"hh\:mm\:ss")), "Duration");

            content.Add(new StringContent(evt.StartDateOnly.ToString("yyyy-MM-dd")), "StartDateOnly");
            content.Add(new StringContent(evt.StartTime.ToString(@"hh\:mm\:ss")), "StartTime");

            content.Add(new StringContent(evt.EndDateOnly?.ToString("yyyy-MM-dd") ?? ""), "EndDateOnly");
            content.Add(new StringContent(evt.EndTime.ToString(@"hh\:mm\:ss")), "EndTime");


            content.Add(new StringContent(evt.TicketPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)), "TicketPrice");

            if (selectedImageFile != null)
            {
                var stream = selectedImageFile.OpenReadStream(10_000_000);
                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType =
                    new System.Net.Http.Headers.MediaTypeHeaderValue(selectedImageFile.ContentType);

                content.Add(fileContent, "ImageFile", selectedImageFile.Name);
            }
            // else
            // {
            //     content.Add(new StringContent(evt.ImageUrl ?? ""), "ImageUrl");
            // }

            // MANAGER (Very Important)
            if (editingEvent.ManagerId.HasValue && editingEvent.ManagerId > 0)
            {
                var m = managers.FirstOrDefault(x => x.Id == editingEvent.ManagerId.Value);

                if (m != null)
                {
                    editingEvent.ManagerName = m.ManagerName ?? "Unknown";
                    editingEvent.ManagerEmail = m.Email ?? "";
                }

                content.Add(new StringContent(editingEvent.ManagerId.Value.ToString()), "ManagerId");
                content.Add(new StringContent(editingEvent.ManagerName ?? ""), "ManagerName");
            }
            else
            {
                content.Add(new StringContent("0"), "ManagerId");
                content.Add(new StringContent(""), "ManagerName");
            }

            if (isManager)
            {
                HttpResponseMessage response;

                if (evt.Id > 0)
                    response = await Http.PutAsync($"api/ManagerEvent/update/{evt.Id}", content);
                else
                    response = await Http.PostAsync("api/ManagerEvent/create", content);

                var body = await response.Content.ReadAsStringAsync();
                if (!response.IsSuccessStatusCode)
                {
                    toastService.ShowError(body);
                    return;
                }

                toastService.ShowSuccess("Event saved successfully.");
                await LoadManagerEvents();
                showEventModal = false;
                selectedImageFile = null;
                return;
            }

            if (isAdmin)
            {
                HttpResponseMessage response;

                if (evt.Id > 0)
                    response = await Http.PutAsync($"api/events/update/{evt.Id}", content);
                else
                    response = await Http.PostAsync("api/events/create", content);

                if (!response.IsSuccessStatusCode)
                {
                    var body = await response.Content.ReadAsStringAsync();
                    toastService.ShowError(body);
                    return;
                }

                toastService.ShowSuccess("Event saved successfully!");
                await LoadAdminEvents();
                showEventModal = false;
                selectedImageFile = null;
                return;
            }

        }
        catch (Exception ex)
        {
            toastService.ShowError("Error: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }
