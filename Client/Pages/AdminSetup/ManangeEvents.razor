    private void SetDateFilter(string filter)
    {
        selectedDateFilter = filter;
        isCustomRangeEnabled = false;
        ApplyFilters();
    }

    private void ClearDateFilter()
    {
        selectedDateFilter = "all";
        isCustomRangeEnabled = false;
        customStartDate = null;
        customEndDate = null;
        ApplyFilters();
    }

    private IEnumerable<EventDto> ApplyDateFilter(IEnumerable<EventDto> events)
    {
        var today = DateTime.Today;
        var tomorrow = today.AddDays(1);
        var saturday = today.AddDays(-(int)today.DayOfWeek + 6);
        var sunday = saturday.AddDays(1);

        return selectedDateFilter switch
        {
            "today" => events.Where(e => e.StartDateOnly.Date == today),
            "tomorrow" => events.Where(e => e.StartDateOnly.Date == tomorrow),
            "weekend" => events.Where(e =>
                e.StartDateOnly.Date == saturday ||
                e.StartDateOnly.Date == sunday),

            "custom" when customStartDate.HasValue && customEndDate.HasValue =>
                events.Where(e =>
                    e.StartDateOnly.Date >= customStartDate.Value.Date &&
                    e.StartDateOnly.Date <= customEndDate.Value.Date),

            _ => events
        };
    }


