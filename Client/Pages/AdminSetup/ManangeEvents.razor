    private string GetPriceButtonClass(decimal min, decimal max)
    {
        if (selectedPriceRange.HasValue && selectedPriceRange.Value.min == min && selectedPriceRange.Value.max == max)
            return "btn btn-outline-danger btn-sm active";
        return "btn btn-outline-secondary btn-sm";
    }



    private void CalculateCityCounts()
    {
        if (citiesList == null || citiesList.Count == 0)
            return;

        foreach (var city in citiesList)
        {
            city.VenueCount = venues.Count(v => v.CityId == city.Id);
            city.EventCount = Events.Count(e => e.CityId == city.Id);
        }
    }

    private void CalculateVenueEventCounts()
    {
        foreach (var venue in venues)
        {
            venue.EventCount = Events.Count(e => e.VenueId == venue.Id);

        }
    }

