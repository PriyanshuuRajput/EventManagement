        if (rounded < now)
            rounded = rounded.AddHours(1);

        editingEvent.StartDateOnly = rounded;
        showEventModal = true;
    }

    private void ShowEditEventModal(EventDto evt)
    {
        editingEvent = new EventDto
        {
            Id = evt.Id,
            Title = evt.Title,
            EventCategoryId = evt.EventCategoryId,
            CategoryName = evt.CategoryName,
            Description = evt.Description,
            Language = evt.Language,
            VenueId = evt.VenueId,
            TicketPrice = evt.TicketPrice,
            ImageUrl = evt.ImageUrl,
            StartDateOnly = evt.StartDateOnly,
            StartTime = evt.StartTime,
            EndDateOnly = evt.EndDateOnly,
            EndTime = evt.EndTime,
