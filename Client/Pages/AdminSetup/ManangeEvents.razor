    private async Task SaveCity(CityDto c)
    {
        try
        {
            // 1️Validate dropdown selections (these stay Guid since Country/State use Guid)
            if (c.CountryId == Guid.Empty)
            {
                toastService.ShowError("Please select a country before saving the city.");
                return;
            }

            if (c.StateId == Guid.Empty)
            {
                toastService.ShowError("Please select a state before saving the city.");
                return;
            }

            if (string.IsNullOrWhiteSpace(c.CityName))
            {
                toastService.ShowError("City name cannot be empty.");
                return;
            }

            //  Build city object (no Guid.NewGuid here — because City.Id is int)
            var city = new CityDto
            {
                Id = c.Id, // leave it as is — backend will assign a new ID if it's 0
                CityName = c.CityName.Trim(),
                CountryId = c.CountryId,
                StateId = c.StateId
            };

            // 3 Save — call Add or Update depending on ID
            if (city.Id == 0)
            {
                await AdminService.AddCityAsync(city);
                toastService.ShowSuccess("City added successfully!");
            }
            else
            {
                await AdminService.UpdateCityAsync(city.Id, city);
                toastService.ShowSuccess("City updated successfully!");
            }

            showCityModal = false;
            await LoadCities();
            CalculateCityCounts();
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Unexpected error: {ex.Message}");
        }
    }

