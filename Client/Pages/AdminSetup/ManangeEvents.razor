    private void ApplyFilters()
    {
        if (activeTab == "events")
            ApplyEventFilters();
        else if (activeTab == "venues")
            ApplyVenueFilters();
        else if (activeTab == "cities")
            ApplyCityFilters();
    }

    private void ClearAllFilters()
    {
        managerSearch = string.Empty;
        // Event Filters
        selectedDateFilter = "all";
        isCustomRangeEnabled = false;
        customStartDate = null;
        customEndDate = null;
        selectedCategories.Clear();
        selectedCity = string.Empty;
        selectedPriceRange = null;
        FilteredEvents = Events;

        // Venue Filters
        venueSearch = string.Empty;
        FilteredVenues = venues;

        // City Filters
        selectedCountryFilter = null;
        citySearch = string.Empty;
        FilteredCities = citiesList;
    }

    private void SetDateFilter(string filter)
    {
        selectedDateFilter = filter;
        isCustomRangeEnabled = false;
        ApplyFilters();
    }

    private void ClearDateFilter()
    {
        selectedDateFilter = "all";
        isCustomRangeEnabled = false;
        customStartDate = null;
        customEndDate = null;
        ApplyFilters();
    }

    private IEnumerable<EventDto> ApplyDateFilter(IEnumerable<EventDto> events)
    {
        var today = DateTime.Today;
        var tomorrow = today.AddDays(1);
        var saturday = today.AddDays(-(int)today.DayOfWeek + 6);
        var sunday = saturday.AddDays(1);

        return selectedDateFilter switch
        {
            "today" => events.Where(e => e.ShowDate.Date == today),
            "tomorrow" => events.Where(e => e.ShowDate.Date == tomorrow),
            "weekend" => events.Where(e =>
                e.ShowDate.Date == saturday ||
                e.ShowDate.Date == sunday),

            "custom" when customStartDate.HasValue && customEndDate.HasValue =>
                events.Where(e =>
                    e.ShowDate.Date >= customStartDate.Value.Date &&
                    e.ShowDate.Date <= customEndDate.Value.Date),

            _ => events
        };
    }


    private string GetDateButtonClass(string filter)
    => selectedDateFilter == filter ? "btn btn-outline-danger btn-sm active" : "btn btn-outline-secondary btn-sm";

    private void ToggleCategory(string category)
    {
        if (selectedCategories.Contains(category))
            selectedCategories.Remove(category);
        else
            selectedCategories.Add(category);
        ApplyFilters();
    }

    private void FilterCity(ChangeEventArgs e)
    {
        selectedCity = e.Value?.ToString() ?? string.Empty;
        ApplyFilters();
    }

    private void SetPriceRange(decimal min, decimal max)
    {
        selectedPriceRange = (min, max);
        ApplyFilters();
    }

    private string GetPriceButtonClass(decimal min, decimal max)
    {
        if (selectedPriceRange.HasValue && selectedPriceRange.Value.min == min && selectedPriceRange.Value.max == max)
            return "btn btn-outline-danger btn-sm active";
        return "btn btn-outline-secondary btn-sm";
    }



    private void CalculateCityCounts()
    {
        if (citiesList == null || citiesList.Count == 0)
            return;

        foreach (var city in citiesList)
        {
            city.VenueCount = venues.Count(v => v.CityId == city.Id);
            city.EventCount = Events.Count(e => e.CityId == city.Id);
        }
    }
    private void CalculateVenueEventCounts()
    {
        foreach (var venue in venues)
        {
            venue.EventCount = Events.Count(e => e.VenueId == venue.Id);

        }
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        selectedImageFile = e.File;


        using var stream = selectedImageFile.OpenReadStream(5_000_000);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        editingEvent.ImageUrl =
            $"data:{selectedImageFile.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private async Task OnCityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int cityId))
        {
            editingEvent.CityId = cityId;

            filteredVenues = await Http.GetFromJsonAsync<List<VenueDto>>(
    $"api/venues/by-city/{cityId}"
            );
        }
    }
    private async Task OnVenueChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int venueId))
        {
            editingEvent.VenueId = venueId;


            var city = await Http.GetFromJsonAsync<CityDto>(
                $"api/cities/by-venue/{venueId}"
            );

            editingEvent.CityId = city.Id;
            filteredVenues = venues;

        }
    }






