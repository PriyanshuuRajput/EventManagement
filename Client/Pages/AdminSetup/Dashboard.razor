@page "/admin-dashboard"
@using Domains.Entities
@using EventBooking.Client.Components
@inject AdminService adminService
@inject NavigationManager Navigation

@inject IJSRuntime JS



<style>

    .summary-card {
        min-width: 200px;
        width: calc(25% - 20px);
        border-radius: 12px;
        transition: transform 0.2s ease;
        cursor: pointer;
    }

        .summary-card:hover 
        {
            transform: translateY(-4px);
            box-shadow: 0 4px 16px rgba(0,0,0,0.15);
        }

    .dashboard-card {
        position: relative;
        border-radius: 12px;
        color: #fff;
        padding: 20px;
        overflow: hidden;
        min-width: 260px;
        width: calc(25% - 20px);
        cursor: pointer;
        transition: 0.3s ease;
    }

        .dashboard-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
        }

    .dashboard-icon-bg {
        position: absolute;
        right: -10px;
        top: 0;
        opacity: 0.40;
        z-index: 0;
        width: 70px;
        height: 70px;
        border-radius: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(45deg, #d53a3a, #f8d7da);
        color: #fff;
        font-size: 32px;
        margin-bottom: 15px;
        box-shadow: -20px 19px 0px 20px rgba(0,0,0,0.15);
    }

    .content {
        position: relative;
        z-index: 2;
    }


    .number {
        font-size: 50px;
        font-weight: 800;
        margin-bottom: 30px;
    }

    
    .title {
        font-size: 24px;
        font-weight: 600;
    }

   
    .card-footer {
        margin-top: 100px;
        font-size: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .dashboard-footer i {
            font-size: 18px;
        }

    /* Color variations */
    .bg-red {
        background-color: #dc3545;
    }

    .bg-blue {
        background-color: #007bff;
    }

    .bg-green {
        background-color: #28a745;
    }

    .bg-orange {
        background-color: #fd7e14;
    } 


    .notification-list {
        max-height: 360px; 
        overflow-y: auto;
    }

    .notify-card 
    {
        border-radius: 10px;
        padding: 3px 4px;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: start;
        transition: transform .3s ease;
    }
        .notify-card:hover 
        {

            transform: translateX(5px);
        }

    .notification-list::-webkit-scrollbar {
        width: 6px;
    }

    .row.g-4 > div {
        display: flex;
    }

    .card {
        height: 100%;
    }

    .notification-list::-webkit-scrollbar-thumb {
        background: #dc3545;
        border-radius: 10px;
    }
    .event-table th {
        background: #f8f9fa;
        font-weight: 600;
        padding: 14px 12px !important;
        white-space: nowrap;
    }

    .event-table td {
        padding: 12px 12px !important;
        vertical-align: middle;
        font-size: 14px;
    }

    .event-table tr:hover {
        background-color: #fff5f5;
/*        transform: scale(1.002);*/
        transition: 0.2s ease;
    }

    .event-title {
        font-weight: 600;
        font-size: 15px;
    }

    .event-sub {
        font-size: 13px;
        color: #6c757d;
    }

    .status-badge {
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .price-badge {
        padding: 7px 12px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 13px;
        background: #f1f3f4;
        color: #333;
    }

    .table-container {
        max-height: 420px;
        overflow-y: auto;
        border-radius: 10px;
    }

        .event-row
        {
            transition: all 0.2s ease-in-out;
            cursor: pointer;
        }

            .event-row:hover
            {
                background-color: #fff5f5 !important;
                transform: scale(1.01);
            }

        .card-header input:focus
        {
            box-shadow: 0 0 8px rgba(255, 0, 0, 0.3) !important;
        }

        /*.event-scroll-box {
            display: flex;
            gap: 15px;
            overflow-x: auto;*/ /* Horizontal scroll */
            /*overflow-y: hidden;
            white-space: nowrap;
            scroll-snap-type: x mandatory;*/ /* Smooth auto snap */
            /*-webkit-overflow-scrolling: touch;*/ /* Smooth drag */
            /*scrollbar-width: none;
        }*/

/*            .event-scroll-box::-webkit-scrollbar
            {
                display: none !important; 
            }*/

        .event-card {
            scroll-snap-align: start;
            flex: 0 0 auto; 
        }

        .smooth-collapse {
            overflow: hidden;
            transition: max-height 0.35s ease;
        }


        .collapse-height 
        {
            max-height: 0;
        }


        .expand-height {
            max-height: 800px;
        }

        .table-fade {
            opacity: 0;
            transform: translateY(15px) scale(0.98);
            transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1), transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
        }

            .table-fade.show 
            {
                opacity: 1;
                transform: translateY(0);
            }

    .event-card .card-body h5,
    .event-card .card-body p {
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        white-space: normal;
    }

    .event-card .card-body h5 {
        -webkit-line-clamp: 2;
        font-size: 1.05rem;
        line-height: 1.2rem;
        min-height: 2.4rem;
    }


    .event-card .card-body p {
        -webkit-line-clamp: 1;
        font-size: 0.9rem;
    }

    .event-card {
        width: 260px;
        height: 330px;
    }

        .event-card .card-body {
            padding: 10px !important;
        }

    .card-img-top {
        width: 100%;
        height: 180px;
        object-fit: cover;
    }

</style>


<div class="container-fluid">

    <!--Header-->
    @*<div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-semibold text-dark mb-0">Dashboard</h3>
            <button class="btn btn-outline-danger shadow-lg" style="margin-left:auto;margin-right:20px" @onclick="GoToManageEvents">
                <i class="bi bi-calendar-plus me-1"></i> Manage Events
            </button>
            <button class="btn btn-outline-danger shadow-lg" @onclick="GoToManageManagers">
                <i class="bi bi-calendar-plus me-1"></i>  Manage Managers
            </button>
        </div>*@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-semibold text-dark mb-0">
        <i class="bi bi-speedometer2 me-2"></i>
        Dashboard
        </h3>
        
     </div>

    <div class="row g-4 mb-4 ">
        <!-- Left Side: Summary Cards -->
        <div class="col-lg-9 col-md-12">
            <div class="d-flex flex-wrap gap-2">

                @foreach (var card in SummaryCards)
                {
                    <div class="dashboard-card " style="background-color: #ffefef">

                        
                        <i class="@card.Icon dashboard-icon-bg"></i>

                        <!-- Content -->
                        <div class="content text-dark">
                            <div class="number">@card.Value</div>
                            <div class="title">@card.Title</div>

                            <div class="card-footer">
                                <span>Details</span>
                                <i class="bi bi-arrow-right"></i>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>


        <!-- Right Side: Notifications -->
        <div class="col-lg-3 col-md-12 ">
            <div class="card shadow-lg rounded-2 border-0 " style="background-color:#ffefef">
                <div class="card-header bg-secondary-subtle fw-semibold rounded-top-2" >
                    Notifications
                </div>
                <div class="card-body  p-3 notification-list">
                    @if (!Notifications.Any())
                    {
                        <div class="text-center text-muted py-4 small">
                            <i class="bi bi-bell-slash fs-2 d-block mb-2 text-danger"></i>
                            No notifications yet
                        </div>
                    }
                    else
                    {
                        @foreach (var note in Notifications)
                        {
                            string colorClass = "bg-light";

                            if (note.Message.Contains("Pending") || note.Message.Contains("request"))
                                colorClass = "bg-warning-subtle text-dark";

                            else if (note.Message.Contains("waiting for payment"))
                                colorClass = "bg-info-subtle text-dark";

                            else
                                colorClass = "bg-primary-subtle text-dark";

                            <div class="notify-card @colorClass shadow-sm">
                                <div>
                                    <div class="fw-semibold" style="font-size:14px">
                                        @((MarkupString)note.Message)
                                    </div>
                                    <div class="text-muted small">@note.Date.ToString("dd MMM yyyy, hh:mm tt")</div>
                                </div>
                                <i class="bi bi-bell-fill text-danger"></i>
                            </div>
                        }

                    }
                </div>
            </div>
        </div>
    </div>

        @*<div class="col-md-6 mb-3 mb-md-0 mt-2">
                <div class="input-group shadow-sm">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search"></i>
                    </span>
                    <input class="form-control"
                           placeholder="Search event name or email..."
                           @bind="SearchTerm"
                           @bind:event="oninput" />
                </div>
            </div>*@


        <!-- Search box -->
        <div class="row mb-3 align-items-center">
            <div class="col-md-6 mb-3 mb-md-0 mt-2">
                <div class="input-group shadow-sm">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-search"></i>
                    </span>
                    <input class="form-control"
                           placeholder="Search by event name , manager name or address..."
                           @bind="SearchTerm"
                           @bind:event="oninput" />
                </div>
            </div>
        </div>

        <!-- FILTER BUTTONS (Always Below) -->
        <div class="d-flex gap-3 flex-wrap py-2 mb-2" style="margin-left:45px">

            <!-- ALL -->
            <button class="btn btn-sm @(selectedStatus == "" ? "btn-danger" : "btn-outline-secondary") rounded-3"
                    @onclick="@( () => SetStatus(""))">
                All
            </button>

            <!-- PENDING -->
            <button class="btn btn-sm @(selectedStatus == "Pending" ? "btn-warning" : "btn-outline-secondary") rounded-3"
                    @onclick="@( () => SetStatus("Pending") )">
                Pending (@PendingCount)
            </button>

            <!-- APPROVED -->
            <button class="btn btn-sm @(selectedStatus == "Approved" ? "btn-success" : "btn-outline-secondary") rounded-3"
                    @onclick="@( () => SetStatus("Approved"))">
                Approved (@ApprovedCount)
            </button>

            <!-- REJECTED -->
            <button class="btn btn-sm @(selectedStatus == "Rejected" ? "btn-danger" : "btn-outline-secondary") rounded-3"
                    @onclick="@( () => SetStatus("Rejected"))">
                Rejected (@RejectedCount)
            </button>

        </div>

        <!--Events table-->
        <div class="card mb-4 border-0 rounded-0">
            <!--<div class="card-header d-flex justify-content-between align-items-center text-white bg-danger rounded-top-3">
        <h6 class="fw-bold mb-0">Recent Events</h6>-->
            @*<input class="form-control form-control-sm shadow-sm " placeholder=" Search event, manager, city..."
        @bind="SearchTerm" @bind:event="oninput" style="width: 300px;" />*@

            <!--</div>-->
            <div class="card-body p-0">
                <div class="table-container">
                    <table class="table event-table table-hover mb-0">
                        <thead class="sticky-top shadow-sm" style="top:0; z-index:10;">
                            <tr>
                                <th>Event Name</th>
                                <th>Manager Name</th>
                                <th>Address</th>
                                <th>Event Date</th>
                                <th>Created</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody class="table-fade @(fadeClass)">
                            @if (!filteredEvents.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        No events found
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var evt in filteredEvents)
                                {
                                    <tr>

                                        <!-- Event Name -->
                                        <td>
                                            <div class="event-title">@evt.Title</div>
                                            <div class="event-sub">@evt.EventType</div>
                                        </td>

                                        <!-- Manager -->
                                        <td class="event-title">
                                            @(string.IsNullOrWhiteSpace(evt.ManagerName) ? "Admin" : evt.ManagerName)
                                        </td>

                                        <!-- Address -->
                                        <td>
                                            <div class="event-title">@evt.VenueName</div>
                                            <div class="event-sub">@evt.CityName</div>
                                        </td>

                                        <!-- Event Date -->
                                        <td>
                                            <div class="event-title">@evt.ShowDate.ToString("dd-MMM-yyyy")</div>
                                            <div class="event-sub">@evt.ShowDate.ToString("hh:mm tt")</div>
                                        </td>

                                        <!-- Created -->
                                        <td class="event-sub">@evt.CreatedAt.ToString("dd MMM yyyy")</td>

                                        <!-- Price -->
                                        <td>
                                            <span class="price-badge">₹ @evt.EventAmount</span>
                                        </td>

                                        <!-- Status -->
                                        <td>
                                        <td>
                                            @if (evt.Status == EventStatus.Pending)
                                            {
                                                <button class="badge bg-warning text-dark"
                                                        style="cursor:pointer"
                                                        @onclick="(() => EventApprove(evt.Id))">
                                                    Pending
                                                </button>
                                            }
                                            else if (evt.Status == EventStatus.AdminApproved)
                                            {
                                                <span class="badge bg-success">Approved</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Rejected</span>
                                            }
                                        </td>

                                        </td>

                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <Pagination Page="@CurrentPage"
                        PageSize="@PageSize"
                        TotalItems="@filteredEventsFull.Count"
                        PageChanged="OnPageChanged" />
        </div>

        <!-- Ongoing Events Accordion -->
        <div class="mb-3">
            <div class="card shadow-sm bg-secondary text-dark border-0 rounded-4" style="cursor: pointer; background-color:#f8d7da" @onclick="ToggleOngoing">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Ongoing Events (Today)</span>
                    <i class="bi bi-chevron-down" style="transition: transform 0.3s; transform: rotate(@(showOngoing ? 180 : 0)deg)"></i>
                </div>
            </div>

            <div class="smooth-collapse @(showOngoing ? "expand-height" : "collapse-height") mt-2">
                @if (OngoingEvents.Any())
                {
                    <div class="event-scroll-box">
                        <div class="d-flex gap-3 flex-nowrap">
                            @foreach (var evt in OngoingEvents)
                            {
                                <div class="event-card" style="width:260px">
                                    <div class="card border-0 shadow-sm rounded-4 h-100">
                                        <img src="@evt.ImageUrl" class="card-img-top rounded-top-4" style="height:180px; object-fit:cover;" alt="@evt.Title" />
                                        <div class="card-body">
                                            <h5 class="fw-bold text-primary">@evt.Title</h5>
                                            <p class="mb-1 text-muted">@evt.VenueName, @evt.CityName</p>
                                            <p class="mb-1"><strong>Date:</strong> @evt.ShowDate.ToString("dd MMM yyyy")</p>
                                            <p class="mb-0"><strong>Ticket Price:</strong> @evt.TicketPrice.ToString("C")</p>
                                        </div>   
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center my-2">No ongoing events</p>
                }
            </div>
        </div>

        <!-- Upcoming Events Accordion -->
        <div class="mb-3">
            <div class="card shadow-sm  text-dark rounded-4 border-0" style="cursor: pointer ; background-color:#f8d7da" @onclick="ToggleUpcoming">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Upcoming Events (Next 10 Days)</span>
                    <i class="bi bi-chevron-down" style="transition: transform 0.3s; transform: rotate(@(showUpcoming ? 180 : 0)deg)"></i>
                </div>
            </div>

            <div class="smooth-collapse @(showUpcoming ? "expand-height" : "collapse-height") mt-2">
                @if (UpcomingEvents.Any())
                {<div class="event-scroll-box">
                        <div class="d-flex gap-3 flex-nowrap">
                            @foreach (var evt in UpcomingEvents)
                            {
                                <div class="event-card" style="width:260px">
                                    <div class="card border-0 shadow-sm rounded-4 h-100">
                                        <img src="@evt.ImageUrl" class="card-img-top rounded-top-4" style="height:180px; object-fit:cover;" alt="@evt.Title" />
                                        <div class="card-body">
                                            <h5 class="fw-bold text-secondary">@evt.Title</h5>
                                            <p class="mb-1 text-muted">@evt.VenueName, @evt.CityName</p>
                                            <p class="mb-1"><strong>Date:</strong> @evt.ShowDate.ToString("dd MMM yyyy")</p>
                                            <p class="mb-0"><strong>Price:</strong> ₹@evt.TicketPrice.ToString()</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center my-2">No upcoming events</p>
                }
            </div>
        </div>
    </div>

    @code {
        private List<EventDto> Events = new();
        private List<ManagerProfileDto> Managers = new();
        private List<(string Message, DateTime Date)> Notifications = new();
        private List<EventDto> filteredEvents = new();
        private DateTime? filterDate = null;
        private string searchTerm = "";
        private string selectedStatus { get; set; } = "";
        private int PendingCount => Events.Count(e => e.Status == EventStatus.Pending);
        private int ApprovedCount => Events.Count(e => e.Status == EventStatus.AdminApproved);
        private int RejectedCount => Events.Count(e => e.Status == EventStatus.Rejected);
        //private int TotalCount => Events.Count;



        private int PageSize = 8;
        private int CurrentPage = 1;
        private int TotalPages => (int)Math.Ceiling(filteredEventsFull.Count / (double)PageSize);

        private List<EventDto> filteredEventsFull = new();
        private string fadeClass = "show";



        string isActive(string route)
        {
            return Navigation.Uri.Contains(route) ? "active" : "";
        }


        private bool showOngoing = false;
        private bool showUpcoming = false;

        private int BookingsCount = 0;
        private int CurrentEvents = 0;

        private List<EventDto> OngoingEvents => Events.Where(e => e.ShowDate <= DateTime.Today && e.ShowDate.AddDays(1) >= DateTime.Today).ToList();
        private List<EventDto> UpcomingEvents => Events.Where(e => e.ShowDate > DateTime.Today && e.ShowDate <= DateTime.Today.AddDays(10)).ToList();

        private List<(string Title, string Icon, int Value,string color)> SummaryCards = new();


        private void SetStatus(string status)
        {
            selectedStatus = status;
            ApplyFilters();
        }

        protected override async Task OnInitializedAsync()
        {
            Events = await adminService.GetAllEventsAsync();
            BookingsCount = 42;
            Managers = await adminService.GetAllManagersAsync();
            CurrentEvents = Events.Count(e => e.ShowDate >= DateTime.Today);

            SummaryCards = new()
{
    ("Total Events",     "bi bi-calendar-event",    Events.Count,      "bg-blue"),
    ("Live Events",   "bi bi-calendar2-event",   CurrentEvents,     "bg-green"),
    ("Total Bookings",   "bi bi-ticket-detailed",   BookingsCount,     "bg-orange"),
    ("Total Managers",   "bi bi-people-fill",       Managers.Count,    "bg-red")
};


            filteredEventsFull = new List<EventDto>(Events);
            BuildNotifications();


            ApplyFilters();
        }

        private void BuildNotifications()
        {
            Notifications.Clear();

            foreach (var evt in Events)
            {
                if (evt.Status == EventStatus.Pending)
                {
                    Notifications.Add((
                        $"Pending Event Approval: <span class='text-muted'>{evt.Title}</span>",
                        evt.CreatedAt
                    ));
                }
            }
            foreach (var manager in Managers)
            {
                if ((DateTime.UtcNow - manager.CreatedAt).TotalHours <= 48)
                {
                    Notifications.Add((
                        $"New Manager Request !!",
                        manager.CreatedAt
                    ));
                }
            }
            Notifications = Notifications
                .OrderByDescending(n => n.Date)
                .ToList();
        }


        [JSInvokable]
        public void OnDateChanged(string selectedDate)
        {
            if (DateTime.TryParse(selectedDate, out var dt))
                filterDate = dt;
            else
                filterDate = null;

            ApplyFilters();
        }

        private void ApplyFilters()
        {
            var term = searchTerm?.Trim().ToLower() ?? "";

            filteredEventsFull = Events
                .Where(e =>

                    (
                        string.IsNullOrEmpty(selectedStatus)
                        || (selectedStatus == "Approved" && e.Status == EventStatus.AdminApproved)
                        || (selectedStatus == "Pending" && e.Status == EventStatus.Pending)
                        || (selectedStatus == "Rejected" && e.Status == EventStatus.Rejected)
                    )
                    &&
                    (
                        string.IsNullOrWhiteSpace(term)
                        ||
                        (
                            (e.Title?.ToLower().Contains(term) ?? false)
                            || (e.ManagerName?.ToLower().Contains(term) ?? false)
                            || (e.VenueName?.ToLower().Contains(term) ?? false)
                            || (e.CityName?.ToLower().Contains(term) ?? false)
                            || (e.EventType?.ToLower().Contains(term) ?? false)
                            || (e.EventAmount.ToString().Contains(term))
                        )
                    )
                )
                .OrderByDescending(e => e.CreatedAt)
                .ToList();

            CurrentPage = 1;
            ApplyPagination();
        }

        private async Task OnPageChanged(int page)
        {
            CurrentPage = page;
            ApplyPagination();
        }

        private async void ApplyPagination()
        {
            fadeClass = "";
            StateHasChanged();
            await Task.Delay(100);

            filteredEvents = filteredEventsFull
                .Skip((CurrentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();


            fadeClass = "show";
            StateHasChanged();
        }


        private void ToggleOngoing() => showOngoing = !showOngoing;
        private void ToggleUpcoming() => showUpcoming = !showUpcoming;

        private string SearchTerm
        {
            get => searchTerm;
            set { searchTerm = value; ApplyFilters(); }
        }

        private void EventApprove(int eventId)
        {
            Navigation.NavigateTo($"/approval-manager-events/{eventId}");
        }
        private void GoToManageEvents()
        {
            Navigation.NavigateTo("/manage-events");
        }
        private void GoToManageManagers()
        {
            Navigation.NavigateTo("/managers");
        }
    }
