@page "/admin-dashboard"
@using Domains.Entities
@using EventBooking.Client.Components
@inject AdminService adminService

@inject IJSRuntime JS



<style>
        .event-row
        {
            transition: all 0.2s ease-in-out;
            cursor: pointer;
        }

            .event-row:hover
            {
                background-color: #fff5f5 !important;
                transform: scale(1.01);
            }

        .card-header input:focus
        {
            box-shadow: 0 0 8px rgba(255, 0, 0, 0.3) !important;
        }

        .event-scroll-box {
            display: flex;
            gap: 15px;
            overflow-x: auto; /* Horizontal scroll */
            overflow-y: hidden;
            white-space: nowrap;
            scroll-snap-type: x mandatory; /* Smooth auto snap */
            -webkit-overflow-scrolling: touch; /* Smooth drag */
            scrollbar-width: none;
        }

            .event-scroll-box::-webkit-scrollbar
            {
                display: none !important; /* Hide scrollbar Chrome */
            }
        .event-card {
            scroll-snap-align: start;
            flex: 0 0 auto; /* Keeps cards inline for dragging */
        }

        .smooth-collapse {
            overflow: hidden;
            transition: max-height 0.35s ease;
        }


        .collapse-height {
            max-height: 0;
        }


        .expand-height {
            max-height: 800px;
        }

        .table-fade {
            opacity: 0;
            transform: translateY(15px) scale(0.98);
            transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1), transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
        }

            .table-fade.show {
                opacity: 1;
                transform: translateY(0);
            }
    .notify-card {
        border-radius: 10px;
        padding: 2px 6px;
        margin-bottom: 8px;
        animation: fadeSlide .3s ease;
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-right:-10px;
    }


</style>


    <div class="container-fluid py-4">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-semibold text-dark mb-0">Dashboard</h3>
            <button class="btn btn-outline-danger shadow-lg" @onclick="GoToManageEvents">
                <i class="bi bi-calendar-plus me-1"></i> Manage Events
            </button>
        </div>

        <div class="row g-4 mb-4">
            <!-- Left Side: Summary Cards -->
            <div class="col-lg-9 col-md-12 ">
                <div class="d-flex flex-wrap gap-4 mb-3">
                    @foreach (var card in SummaryCards)
                    {
                        <div class="card-body text-dark p-4 rounded-4 shadow-lg fw-semibold" style="min-width:180px; font-size:1.25rem;">
                            <i class="@card.Icon me-2 text-danger"  style="font-size:1.6rem;"></i>
                            @card.Title: @card.Value
                        </div>
                    }
                </div>
            </div>

            <!-- Right Side: Notifications -->
            <div class="col-lg-3 col-md-12">
                <div class="card shadow-lg rounded-2 border-0">
                    <div class="card-header border-danger text-dark fw-semibold rounded-top-2">
                        Notifications
                    </div>
                    <div class="card-body p-3" style="max-height: 250px; overflow-y: auto;">
                        @if (!Notifications.Any())
                        {
                            <div class="text-center text-muted py-4 small">
                                <i class="bi bi-bell-slash fs-2 d-block mb-2 text-danger"></i>
                                No notifications yet
                            </div>
                        }
                        else
                        {
                            @foreach (var note in Notifications)
                            {
                                string colorClass = "bg-light";

                                if (note.Message.Contains("Pending") || note.Message.Contains("request"))
                                    colorClass = "bg-warning-subtle text-warning";

                                else if (note.Message.Contains("waiting for payment"))
                                    colorClass = "bg-info-subtle text-info";

                                else
                                    colorClass = "bg-light text-dark";

                                <div class="notify-card @colorClass shadow-sm">
                                    <div>
                                        <div class="fw-semibold">@note.Message</div>
                                        <div class="text-muted small">@note.Date.ToString("dd MMM yyyy, hh:mm tt")</div>
                                    </div>
                                    <i class="bi bi-bell-fill text-danger"></i>
                                </div>
                            }

                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Events Table -->
        <div class="card shadow-lg mb-4 border-0 rounded-3">
            <div class="card-header d-flex justify-content-between align-items-center text-white bg-danger rounded-top-3">
                <h6 class="fw-bold mb-0">Recent Events</h6>
                <input class="form-control form-control-sm shadow-sm " placeholder=" Search event, manager, city..."
                       @bind="SearchTerm" @bind:event="oninput" style="width: 300px;" />

            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table align-middle table-hover mb-0">
                        <thead class="table-secondary sticky-top shadow-sm fw-bold" style="top:0; z-index:10;">
                            <tr class="text-secondary">
                                <th>Event Name</th>
                                <th>Manager Name</th>
                                <th>Location</th>
                                <th>Event Date</th>
                                <th>Created</th>
                                <th>Event Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody class="table-fade @(fadeClass)">
                            @if (!filteredEvents.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">No events found</td>
                                </tr>
                            }
                            else
                            {

                                @foreach (var evt in filteredEvents)
                                {
                                    <tr>

                                        <td>
                                            <div class="d-flex flex-column">
                                                <strong>@evt.Title</strong>
                                                <small class="text-muted">@evt.EventType</small>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <strong>@evt.ManagerName</strong>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@evt.VenueName</div>
                                            <small class="text-muted">@evt.CityName</small>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <strong>@evt.ShowDate.ToString("dd-MMM-yyyy")</strong>
                                                <small class="text-muted">@evt.ShowDate.ToString("hh:mm tt")</small>
                                            </div>
                                        </td>
                                        <td>
                                            <span>@evt.CreatedAt.ToString("dd MMM yyyy")</span>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill bg-light text-dark px-3 py-2 shadow-sm">
                                                ₹ @evt.EventAmount
                                            </span>
                                        </td>

                                        <td>
                                            @if (evt.Status == EventStatus.Pending)
                                            {
                                                <span class="badge bg-warning text-dark">Pending Approval</span>
                                            }
                                            else if (evt.Status == EventStatus.AdminApproved && evt.IsAmountAccepted == false)
                                            {
                                                <span class="badge bg-info text-dark">Waiting For Payment</span>
                                            }
                                            else if (evt.Status == EventStatus.PaymentConfirmed)
                                            {
                                                <span class="badge bg-success">Approved & Live</span>
                                            }
                                            else if (evt.Status == EventStatus.Rejected)
                                            {
                                                <span class="badge bg-danger">Rejected</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <Pagination Page="@CurrentPage"
                        PageSize="@PageSize"
                        TotalItems="@filteredEventsFull.Count"
                        PageChanged="OnPageChanged" />
        </div>

        <!-- Ongoing Events Accordion -->
        <div class="mb-3">
            <div class="card shadow-sm bg-secondary text-white rounded-4" style="cursor:pointer;" @onclick="ToggleOngoing">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Ongoing Events</span>
                    <i class="bi bi-chevron-down" style="transition: transform 0.3s; transform: rotate(@(showOngoing ? 180 : 0)deg)"></i>
                </div>
            </div>

            <div class="smooth-collapse @(showOngoing ? "expand-height" : "collapse-height") mt-2">
                @if (OngoingEvents.Any())
                {
                    <div class="event-scroll-box">
                        <div class="d-flex gap-3 flex-nowrap">
                            @foreach (var evt in OngoingEvents)
                            {
                                <div class="event-card" style="width:260px">
                                    <div class="card border-0 shadow-sm rounded-4 h-100">
                                        <img src="@evt.ImageUrl" class="card-img-top rounded-top-4" style="height:180px; object-fit:cover;" alt="@evt.Title" />
                                        <div class="card-body">
                                            <h5 class="fw-bold text-primary">@evt.Title</h5>
                                            <p class="mb-1 text-muted">@evt.VenueName, @evt.CityName</p>
                                            <p class="mb-1"><strong>Date:</strong> @evt.ShowDate.ToString("dd MMM yyyy")</p>
                                            <p class="mb-0"><strong>Ticket Price:</strong> @evt.TicketPrice.ToString("C")</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center my-2">No ongoing events</p>
                }
            </div>
        </div>

        <!-- Upcoming Events Accordion -->
        <div class="mb-3">
            <div class="card shadow-sm bg-secondary text-white rounded-4" style="cursor:pointer;" @onclick="ToggleUpcoming">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Upcoming Events (Next 10 Days)</span>
                    <i class="bi bi-chevron-down" style="transition: transform 0.3s; transform: rotate(@(showUpcoming ? 180 : 0)deg)"></i>
                </div>
            </div>

            <div class="smooth-collapse @(showUpcoming ? "expand-height" : "collapse-height") mt-2">
                @if (UpcomingEvents.Any())
                {     <div class="event-scroll-box">
                    <div class="d-flex gap-3 flex-nowrap">
                        @foreach (var evt in UpcomingEvents)
                        {
                            <div class="event-card" style="width:260px">
                                <div class="card border-0 shadow-sm rounded-4 h-100">
                                    <img src="@evt.ImageUrl" class="card-img-top rounded-top-4" style="height:180px; object-fit:cover;" alt="@evt.Title" />
                                    <div class="card-body">
                                        <h5 class="fw-bold text-secondary">@evt.Title</h5>
                                        <p class="mb-1 text-muted">@evt.VenueName, @evt.CityName</p>
                                        <p class="mb-1"><strong>Date:</strong> @evt.ShowDate.ToString("dd MMM yyyy")</p>
                                        <p class="mb-0"><strong>Price:</strong> ₹@evt.TicketPrice.ToString()</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                }
                else
                {
                    <p class="text-muted text-center my-2">No upcoming events</p>
                }
            </div>
        </div>
    </div>

    @code {
        private List<EventDto> Events = new();
        private List<(string Message, DateTime Date)> Notifications = new();
        private List<EventDto> filteredEvents = new();
        private DateTime? filterDate = null;
        private string searchTerm = "";


        private int PageSize = 8;
        private int CurrentPage = 1;
        private int TotalPages => (int)Math.Ceiling(filteredEventsFull.Count / (double)PageSize);

        private List<EventDto> filteredEventsFull = new();
        private string fadeClass = "show";




        private bool showOngoing = false;
        private bool showUpcoming = false;

        private int BookingsCount = 0;
        private int Managers = 0;
        private int CurrentEvents = 0;

        private List<EventDto> OngoingEvents => Events.Where(e => e.ShowDate <= DateTime.Today && e.ShowDate.AddDays(1) >= DateTime.Today).ToList();
        private List<EventDto> UpcomingEvents => Events.Where(e => e.ShowDate > DateTime.Today && e.ShowDate <= DateTime.Today.AddDays(10)).ToList();

        private List<(string Title, string Icon, int Value)> SummaryCards = new();


        protected override async Task OnInitializedAsync()
        {
            Events = await adminService.GetAllEventsAsync();
            BookingsCount = 42;
            Managers = 380;
            CurrentEvents = Events.Count(e => e.ShowDate >= DateTime.Today);

            SummaryCards = new()
    {
        ("Total Events", "bi bi-calendar-event", Events.Count),
        ("Total Bookings", "bi bi-ticket-detailed", BookingsCount ),
        ("Current Events", "bi bi-calendar2-event", CurrentEvents),
        ("Total Managers", "bi bi-calender-events",Managers)
    };

            filteredEventsFull = new List<EventDto>(Events);
            BuildNotifications();


            ApplyFilters();
        }

        private void BuildNotifications()
        {
            Notifications.Clear();

            foreach (var evt in Events)
            {
                if (evt.Status == EventStatus.Pending)
                {
                    Notifications.Add(($"New event request : {evt.Title}", evt.CreatedAt));
                }
                else if (evt.Status == EventStatus.AdminApproved && evt.IsAmountAccepted == false)
                {
                    Notifications.Add(($"Event approved & waiting for payment : {evt.Title}", evt.ApprovedAt ?? evt.CreatedAt));

                }
                //else if (evt.Status == EventStatus.PaymentConfirmed)
                //{
                //    Notifications.Add(($"Event is now LIVE: {evt.Title}", evt.PrizePaidAt ?? evt.ApprovedAt ?? evt.CreatedAt));
                //}

            }
            Notifications = Notifications.OrderByDescending(n => n.Date).ToList();
        }

        [JSInvokable]
        public void OnDateChanged(string selectedDate)
        {
            if (DateTime.TryParse(selectedDate, out var dt))
                filterDate = dt;
            else
                filterDate = null;

            ApplyFilters();
        }

        private void ApplyFilters()
        {
            var term = searchTerm?.Trim().ToLower() ?? "";

            filteredEventsFull = Events
                .Where(e =>
                    string.IsNullOrWhiteSpace(term)
                    ||
                    (
                        (e.Title?.ToLower().Contains(term) ?? false) ||
                        (e.ManagerName?.ToLower().Contains(term) ?? false) ||
                        (e.VenueName?.ToLower().Contains(term) ?? false) ||
                        (e.CityName?.ToLower().Contains(term) ?? false) ||
                        (e.EventType?.ToLower().Contains(term) ?? false) ||
                        (e.EventAmount.ToString().Contains(term)) ||
                        (e.Status.ToString().ToLower().Contains(term))
                    )
                )
                .OrderByDescending(e => e.CreatedAt)
                .ToList();

            CurrentPage = 1;
            ApplyPagination();
        }
        private async Task OnPageChanged(int page)
        {
            CurrentPage = page;
            ApplyPagination();
        }

        private async void ApplyPagination()
        {
            fadeClass = "";
            StateHasChanged();
            await Task.Delay(100);

            filteredEvents = filteredEventsFull
                .Skip((CurrentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();


            fadeClass = "show";
            StateHasChanged();
        }


        private void ToggleOngoing() => showOngoing = !showOngoing;
        private void ToggleUpcoming() => showUpcoming = !showUpcoming;

        private string SearchTerm
        {
            get => searchTerm;
            set { searchTerm = value; ApplyFilters(); }
        }

        private void GoToManageEvents()
        {
            Navigation.NavigateTo("/manage-events");
        }
    }
