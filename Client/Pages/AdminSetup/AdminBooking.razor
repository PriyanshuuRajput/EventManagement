@page "/admin-booking"
@using EventBooking.Client.SpinnerService

@inject SpinnerService spinnerService
@inject HttpClient http
@attribute [Authorize(Roles = "Admin")]

<PageTitle>EventiGo-bookings</PageTitle>

<div class="container-fluid py-3">

    <!-- PAGE TITLE -->
    <div class="d-flex justify-content-between align-items-center m-2 mb-4">
        <h3 class="fw-bold " sttyle="font-size:30px">
            Bookings & Revenue Overview
        </h3>
    </div>

    <!-- SUMMARY STRIP -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <p class="text-muted mb-1">My Events</p>
                    <h3 class="fw-bold">@TotalEvents</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <p class="text-muted mb-1"> My Tickets Sold</p>
                    <h3 class="fw-bold">@TotalTicketsSold</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <p class="text-muted mb-1">My Earnings</p>
                    <h3 class="fw-bold text-success">@TotalRevenue</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <p class="text-muted mb-1">Managers & Payout</p>
                    <div class="mt-4">
                        <h5 class="fw-bold">Manager Payout Summary</h5>

                        @foreach (var m in ManagerEarnings)
                        {
                            <div class="d-flex justify-content-between border-bottom py-2">
                                <span>@m.ManagerName</span>
                                <strong class="text-danger">₹@m.TotalEarning</strong>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>


    <!-- FILTER BAR -->
    <div class="row g-3 align-items-end">
        <!-- Search Event -->
        <div class="col-md-3">
            <div class="float">
                <input class="form-control"
                       placeholder=" "
                       @bind="selectedEvent" />
                <label>Search Event</label>
            </div>
        </div>

        <!-- Manager -->
        <div class="col-md-3">
            <div class="float">
                <select class="form-select"
                        @bind="SelectedManagerId">
                    <option value="">All Managers</option>
                    @* @foreach (var m in managers)
                    {
                        <option value="@m.Id">@m.Name</option>
                    } *@
                </select>
                <label>Manager</label>
            </div>
        </div>

        <!-- Status -->
        <div class="col-md-2">
            <div class="float">
                <select class="form-select"
                        @bind="SelectedStatus">
                    <option value="">All Status</option>
                    <option>Confirmed</option>
                    <option>Cancelled</option>
                </select>
                <label>Status</label>
            </div>
        </div>

        <!-- Date -->
        <div class="col-md-2">
            <div class="float">
                <input type="date"
                       class="form-control"
                       @bind="FilterDate" />
                <label>Date</label>
            </div>
        </div>

        <div class="col-md-2">
            <button class="btn btn-danger w-100"
                    @onclick="ClearFilters">
                Clear
            </button>
        </div>
    </div>


    <!-- BOOKINGS TABLE -->
    <table class="table align-middle mb-0">
        <thead class="table-secondary">
            <tr>
                <th>Event </th>
                <th>Manager</th>
                <th>Date & Time</th>
                <th class="text-center">Tickets Sold</th>
                <th class="text-center">Ticket Price</th>
                <th>Revenue</th>
            </tr>
        </thead>

        <tbody>
            @if (!Bookings.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        No bookings found
                    </td>
                </tr>
            }
            else
            {
                @foreach (var b in Bookings)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@b.EventName</div>
                            <small class="text-muted">@b.CategoryName</small>
                            <small class="text-muted">@b.VenueName</small>
                        </td>
                       <td>
    <span class="fw-semibold">
        @b.ManagerName
    </span>
</td>
                        <td>
                           <div>@b.EventStartDate.ToString("dd MMM yyyy")</div>
                           <span class="text-muted">Time</span>
                        </td>

                        <td class="text-center">@b.TicketCount</td>

                        <td class="text-center">₹@b.TicketPrice</td>

                        <td class="fw-bold text-success">
                            ₹@b.GrossAmount
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
@code {
    private List<BookingDto> Bookings = new();

    private string selectedEvent = "";
    private int? SelectedManagerId;
    private string? SelectedStatus;
    private DateTime? FilterDate;

    private int TotalEvents;
    private int TotalTicketsSold;
    private decimal TotalRevenue;

    private List<(string ManagerName, decimal TotalEarning)> ManagerEarnings = new();


    protected override async Task OnInitializedAsync()
    {
        await LoadBookings();
    }

    private async Task LoadBookings()
    {
        spinnerService.Show();

        Bookings = await http
            .GetFromJsonAsync<List<BookingDto>>("api/Booking/admin/earning")
            ?? new();

        // 🔹 ADMIN BOOKINGS (ManagerId == null)
        var adminBookings = Bookings
            .Where(b => b.ManagerId == null)
            .ToList();

        // ✅ SUMMARY CARDS (ADMIN ONLY)
        TotalEvents = adminBookings
            .Select(b => b.EventId)
            .Distinct()
            .Count();

        TotalTicketsSold = adminBookings.Sum(b => b.TicketCount);

        TotalRevenue = adminBookings.Sum(b => b.GrossAmount);

        // 🔹 MANAGER PAYOUT (ManagerId != null)
        ManagerEarnings = Bookings
            .Where(b => b.ManagerId != null)
            .GroupBy(b => b.ManagerName)
            .Select(g => (
                ManagerName: g.Key ?? "Unknown Manager",
                TotalEarning: g.Sum(x => x.ManagerEarning)
            ))
            .ToList();

        spinnerService.Hide();
    }

    private async Task ClearFilters()
    {
        selectedEvent = "";
        SelectedManagerId = null;
        SelectedStatus = null;
        FilterDate = null;

        await LoadBookings();
    }
}
