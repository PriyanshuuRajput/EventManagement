@page "/admin-booking"
@using EventBooking.Client.SpinnerService

@inject SpinnerService spinnerService
@inject HttpClient http
@attribute [Authorize(Roles = "Admin")]

<PageTitle>EventiGo-bookings</PageTitle>

<div class="container-fluid py-3">

    <!-- PAGE TITLE -->
    <div class="d-flex justify-content-between align-items-center m-2 mb-4">
        <h3 class="fw-bold " sttyle="font-size:30px">
            Bookings 
        </h3>
    </div>

    <!-- SUMMARY STRIP -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Total Bookings</div>
                    <div class="fs-3 fw-bold">1,248</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Today</div>
                    <div class="fs-3 fw-bold text-success">48</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">This Week</div>
                    <div class="fs-3 fw-bold text-primary">312</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Cancelled</div>
                    <div class="fs-3 fw-bold text-danger">26</div>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <input class="form-control"
                           placeholder="Search booking, user, event..." />
                </div>

                <div class="col-md-3">
                    <select class="form-select">
                        <option>Status</option>
                        <option>Confirmed</option>
                        <option>Cancelled</option>
                        <option>Refunded</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <input type="date" class="form-control" />
                </div>

                <div class="col-md-2">
                    <button class="btn btn-danger w-100">
                        Apply
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- BOOKINGS TABLE -->
    <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Booking ID</th>
                            <th>Event</th>
                            <th>Tickets</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                <tbody>
                    @if (!bookings.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                No bookings found
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in bookings)
                        {
                            <tr>
                                <td>@b.TicketNumber</td>
                                <td>@b.EventName</td>
                                <td>@b.TicketCount</td>
                                <td>₹@b.TotalAmount</td>
                                <td>
                                    <span class="badge @(b.Status == BookingStatus.Cancelled ? "bg-danger" : "bg-success")">
                                        @b.Status
                                    </span>
                                </td>
                                <td>@b.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => ViewBooking(b.Id)">
                                        View
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

                </table>
            </div>
            
        </div>
</div>

@code
{
    private List<BookingDto> bookings = new();



    protected override async Task OnInitializedAsync()
    {
        spinnerService.Show();
        try
        {
            bookings = await http.GetFromJsonAsync<List<BookingDto>>("api/Booking") ?? new();
        }
        catch
        {
            bookings = new();
        }

        spinnerService.Hide();
    }

    private async Task ViewBooking(int Id)
    {
        
    }

}