@code {
    [Parameter] public int eventId { get; set; }

    private EventDto? evtDetails;
    private List<EventDto> suggestedEvents = new();
    // private List<SeatCategory> seatCategories = new();
    private List<string> selectedSeats = new();

    // private decimal Subtotal => seatCategories.Sum(c => c.Quantity * c.Price);
    // private decimal ServiceFee => Math.Round(Subtotal * 0.1m, 2);
    // private decimal Total => Subtotal + ServiceFee;
    private int ticketCount = 0;
    private int maxTickets = 0;
    private decimal Subtotal => ticketCount * evtDetails!.TicketPrice;
    private decimal ServiceFee => Math.Round(Subtotal * 0.1m, 2);
    private decimal Total => Subtotal + ServiceFee;
    private bool IsLoggedIn = false;




    private int interestedCount = 0;
    private bool isInterested = false;
    private string interestKey => $"event_{eventId}_interested";

    protected override async Task OnParametersSetAsync()
    {
        spinnerService.Show();
        await CheckLoginStatusAsync();

        evtDetails = null;
        // seatCategories.Clear();
        suggestedEvents.Clear();

        evtDetails = await Http.GetFromJsonAsync<EventDto>(
    $"api/events/{eventId}");

        if (evtDetails != null)
        {
            maxTickets = evtDetails.TotalTickets
                         - evtDetails.SoldTickets;
            if (maxTickets < 0)
                maxTickets = 0;

            ticketCount = maxTickets > 0 ? 1 : 0;
        }
        await LoadSuggestedEvents();

        spinnerService.Hide();
    }
    private async Task CheckLoginStatusAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        IsLoggedIn = !string.IsNullOrWhiteSpace(token);
    }


    private void IncreaseTicket()
    {
        if (ticketCount < maxTickets)
            ticketCount++;
    }

    private void DecreaseTicket()
    {
        if (ticketCount > 1)
            ticketCount--;
    }

    private async Task LoadSuggestedEvents()
    {
        var allEvents = await Http.GetFromJsonAsync<List<EventDto>>("api/Events/approved");

        suggestedEvents = allEvents?
            .Where(e => e.Id != eventId &&
                        (e.EventCategoryId == evtDetails?.EventCategoryId || e.CityName == evtDetails?.CityName))
            .Take(8) // show more events for horizontal scroll
            .ToList() ?? new List<EventDto>();
    }

    private void ViewEvent(int id)
    {
        Nav.NavigateTo($"/book-event/{id}");
    }
    // private void OpenLoginPopup()
    // {
    //     MainLayout.Instance?.ShowLoginOverlay();
    // }

    private async Task ProceedToCheckout()
    {
        if (ticketCount <= 0)
        {
            await JS.InvokeVoidAsync("alert", "Please select at least one ticket.");
            return;
        }

        var booking = new BookingRequest
        {
            EventId = eventId,
            // UserId = 1,
            TicketCount = ticketCount
        };

        var response = await Http.PostAsJsonAsync("api/Booking", booking);

        if (response.IsSuccessStatusCode)
        {
            await JS.InvokeVoidAsync("alert", "✅ Booking initiated!");
            Nav.NavigateTo("/events");
        }
        else
        {
            var msg = await response.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"❌ Booking failed: {msg}");
        }
    }
    private void GoToCheckout()
    {
        Nav.NavigateTo($"/book-event/{eventId}/checkout");
    }



    // private void ToggleSeat(SeatCategory category, string seatId)
    // {
    //     if (selectedSeats.Contains(seatId))
    //     {
    //         selectedSeats.Remove(seatId);
    //         category.Quantity--;
    //     }
    //     else
    //     {
    //         selectedSeats.Add(seatId);
    //         category.Quantity++;
    //     }
    // }
    // private string GetSeatDescription(string category)
    // {
    //     return category switch
    //     {
    //         "Regular" => "Standard seating for casual comfort",
    //         "Premium" => "Mid-level seats with excellent view",
    //         "VIP" => "Front row seats with exclusive access",
    //         "Balcony" => "Top view, relaxed experience",
    //         _ => "General seating"
    //     };
    // }

    private async Task LoadInterestAsync()
    {
        try
        {
            isInterested = await SessionStorage.GetItemAsync<bool>(interestKey);

            interestedCount = new Random().Next(500, 900);
            if (isInterested)
            {
                interestedCount += 1;
            }
        }
        catch
        {
            interestedCount = 0;
        }
    }

    private async Task MarkInterested()
    {
        if (isInterested)
            return;

        isInterested = true;
        interestedCount++;

        await SessionStorage.SetItemAsync(interestKey, true);

        // await JS.InvokeVoidAsync("alert", "👍 You’ve marked this event as interested!");
    }

    // public class SeatCategory
    // {
    //     public string Category { get; set; } = "";
    //     public decimal Price { get; set; }
    //     public int Quantity { get; set; } = 0;
    //     public int Available { get; set; } = 0;
    // }
}
