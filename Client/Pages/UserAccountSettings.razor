@page "/user-account-settings"
@attribute [Authorize(Roles = "User")]

@using Applications.Dto.UserDto
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Headers
@using Applications.Dto
@inject HttpClient Http
@inject IJSRuntime JS


<style>
    .profile-banner {
        width: 100%;
        height: 170px;
        border-radius: 30px;
        background-size: cover;
        background-position: center;
        filter: blur(2px);
        transform: scale(1.02);
        opacity: 0.85;
        margin-top: 30px;
    }

    .camera-btn {
        background: rgba(0,0,0,0.6);
        color: #fff;
        transition: all 0.2s ease;
    }

        .camera-btn i {
            font-size: 18px;
        }

        .camera-btn:hover {
            transform: scale(1.05);
            background: rgba(0,0,0,0.8);
        }

    /* CARD */
    .settings-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        .settings-card h3 {
            margin-bottom: 0;
        }

        .settings-card.muted {
            opacity: 0.6;
        }

        /* INPUT */
        .settings-card .form-control {
            border-radius: 10px;
            padding: 10px 14px;
        }

    /* BUTTONS */
    .btn-primary {
        margin-top: 10px;
        padding: 10px;
        border-radius: 10px;
        border: none;
        background: #e53935;
        color: #fff;
        font-weight: 500;
    }

    .btn-danger {
        margin-top: 10px;
        padding: 10px;
        border-radius: 10px;
        border: none;
        background: #d32f2f;
        color: #fff;
        font-weight: 500;
    }

    .btn-outline {
        margin-top: 10px;
        padding: 10px;
        border-radius: 10px;
        border: 1px dashed #ccc;
        background: transparent;
    }

    /* FLOATING LABEL */
    .floating-group {
        position: relative;
        margin-bottom: 18px;
    }

        .floating-group .form-control {
            padding: 14px;
            height: 48px;
        }

        .floating-group textarea.form-control {
            height: auto;
            padding-top: 18px;
        }

        .floating-group label {
            position: absolute;
            top: 50%;
            left: 14px;
            transform: translateY(-50%);
            font-size: 14px;
            color: #777;
            pointer-events: none;
            transition: all 0.2s ease;
            background: #fff;
            padding: 0 10px;
        }

        .floating-group .form-control:focus + label,
        .floating-group .form-control:not(:placeholder-shown) + label {
            top: 0;
            font-size: 12px;
            color: #dc3545;
        }

        .floating-group .form-control::placeholder {
            color: transparent;
        }
</style>


<PageTitle>EventiGo - Account Settings</PageTitle>

<EditForm Model="@Model">
    <DataAnnotationsValidator />

    <!-- HEADER -->
    <div class="profile-banner" style="background-image:url('@GetImage()')"></div>

    <!-- PROFILE HEADER -->
    <div style="position:relative; margin-top:-90px; padding:0 80px">
        <div style="display:flex; gap:30px; align-items:center">

            <div style="position:relative;">
                <img src="@GetImage()" style="width:150px;height:150px;border-radius:50%;object-fit:cover;" />
                <label for="profileImageInput" class="camera-btn"
                       style="position:absolute; bottom:8px; right:8px; width:40px; height:40px;
              border-radius:50%; display:flex; align-items:center;
              justify-content:center; cursor:pointer;">
                    <i class="bi bi-camera-fill"></i>
                </label>
                <InputFile id="profileImageInput"
                           OnChange="OnImageUpload"
                           accept="image/*"
                           style="display:none" />

            </div>

            <div>
                <h1 style="margin-top:20px">@Model.FirstName @Model.LastName</h1>
                <div style="display:flex; gap:20px;margin-top:20px; font-size:18px;">
                    <span><i class="bi bi-geo-alt text-danger"></i> @Model.Address</span>
                    <span><i class="bi bi-envelope text-secondary"></i> @Model.Email</span>
                </div>
            </div>
        </div>
    </div>

    <!-- SETTINGS -->
    <div class="container-fluid mt-4" style="padding-left:200px">
        <div class="row g-4">

            <!-- PROFILE -->
            <div class="col-md-4">
                <div class="settings-card shadow-lg">

                    <div class="d-flex justify-content-between">
                        <h3>Profile</h3>
                        @if (activeEdit != Edit.Profile)
                        {
                            <button class="btn btn-link text-danger"
                                    @onclick="() => EnableEdit(Edit.Profile)">
                                Edit
                            </button>
                        }
                    </div>

                    <hr />

                    @if (activeEdit != Edit.Profile)
                    {
                          <div class="mb-3">
                            <strong style="font-size:16px">Full name:</strong> @Model.FirstName @Model.LastName
                        </div>
                        <div class="mb-3">
                            <strong style ="font-size:16px">Address:</strong> @Model.Address
                        </div>

                        <div class="mb-3">
                            <strong style="font-size:16px">Mobile number:</strong> @Model.Mobile
                        </div>
                        <div class="mb-3">
                            <strong style="font-size:16px">Email:</strong> @Model.Email
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <div class="floating-group">
                                    <InputText class="form-control"
                                               placeholder=" "
                                               @bind-Value="Model.FirstName" />
                                    <label>First Name<span class="text-danger"> *</span></label>
                                    <ValidationMessage For="@(() => Model.FirstName)" class="text-danger small"/>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="floating-group">
                                    <InputText class="form-control"
                                               placeholder=" "
                                               @bind-Value="Model.LastName" />
                                    <label>Last Name</label>
                                </div>
                            </div>
                        </div>

                        <div class="floating-group">
                            <InputTextArea class="form-control" rows="2" placeholder=" " @bind-Value="Model.Address" />
                            <label>Address<span class="text-danger"> *</span></label>
                            <ValidationMessage For="@(() => Model.Address)" class="text-danger small" />
                        </div>

                        <div class="floating-group">
                            <InputText class="form-control"
                                       placeholder=" "
                                       @bind-Value="Model.Mobile"
                                       inputmode="numeric"
                                       pattern="[0-9]*"
                                       maxlength="10"
                                       oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                            <label>Mobile Number<span class="text-danger"> *</span></label>
                            <ValidationMessage For="@(() => Model.Mobile)" class="text-danger small" />
                        </div>
                        <div class="d-flex justify-content-end" style="gap:10px">
                            <button type="button" class="btn-outline" @onclick="CancelEdit">
                                Cancel
                            </button>
                            <button type="button" class="btn-primary" style="padding:10px 14px" disabled="@isSaving" @onclick="Save">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Save
                            </button>

                        </div>
                    }
                </div>
            </div>

            <!-- PASSWORD -->
            <div class="col-md-4">
                <div class="settings-card shadow-lg">

                    <div class="d-flex justify-content-between">
                        <h3>Password</h3>
                        @if (activeEdit != Edit.Password)
                        {
                            <button class="btn btn-link text-danger"
                                    @onclick="() => EnableEdit(Edit.Password)">
                                Change Password
                            </button>
                        }
                    </div>

                    <hr />

                    @if (activeEdit != Edit.Password)
                    {
                        <div class="mb-3">
                            <strong style="font-size:16px">Current password: ********</strong>
                        </div>
                    }
                    @if (activeEdit == Edit.Password)
                    {
                        <div class="floating-group">
                            <InputText type="password" class="form-control" placeholder=" " @bind-Value="Model.OldPassword" />
                            <label>Current Password<span class="text-danger"> *</span></label>
                            <ValidationMessage For="@(() => Model.OldPassword)" />
                        </div>

                        <div class="floating-group">
                            <InputText type="password" class="form-control" placeholder=" " @bind-Value="Model.NewPassword" />
                            <label>New Password<span class="text-danger"> *</span></label>
                            <ValidationMessage For="@(() => Model.NewPassword)"  />
                        </div>

                        <div class="floating-group">
                            <InputText type="password" class="form-control" placeholder=" " @bind-Value="Model.ConfirmPassword" />
                            <label>Confirm Password<span class="text-danger"> *</span></label>
                            <ValidationMessage For="@(() => Model.ConfirmPassword)"  />
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger mt-2">
                                @errorMessage
                            </div>
                        }

                        <div class="d-flex justify-content-end" style="gap:10px">
                            <button type="button" class="btn-outline" @onclick="CancelEdit">
                                Cancel
                            </button>
                            <button class="btn-primary" style="padding:10px 14px" @onclick="Save">Save</button>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</EditForm>

<!--Confirm Modal-->

@if (showConfirmPopup)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:9999;">
        <div style="
                    background:#fff;
                    border-radius:14px;
                    padding:24px;
                    width:320px;
                    text-align:center;
                ">
            <h4>Update Profile Image</h4>
            <p style="font-size:14px;color:#666;">
                Do you want to save this image as your profile image?
            </p>

            <div style="display:flex; gap:12px; margin-top:20px;">
                <button class="btn-outline w-100"
                        @onclick="CancelImageChange">
                    Cancel
                </button>

                <button class="btn-primary w-100" disabled="@isUpdate"
                        @onclick="ConfirmImageChange">
                    @if (isUpdate)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Update
                </button>

            </div>
        </div>
    </div>
} 

@code {

    private RealUserDto Model = new();
    private bool isSaving;

    private bool showConfirmPopup = false;
    private IBrowserFile? selectedImage;
    private string? imagePreview;
    private bool isUpdate = false;

    private enum Edit { None, Profile, Password }
    private Edit activeEdit = Edit.None;
    private string? errorMessage;



    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", token);

        var response = await Http.GetAsync("api/user/profile");

        if (response.IsSuccessStatusCode)
        {
            Model = await response.Content.ReadFromJsonAsync<RealUserDto>()??new();
        }
        else
        {
            Console.WriteLine("Profile not found");
        }

    }

    private void EnableEdit(Edit edit) => activeEdit = edit;
    private void CancelEdit() => activeEdit = Edit.None;

    private async Task Save()
    {
        if (isSaving) return;

        isSaving = true;
        errorMessage = null;

        var response = await Http.PutAsJsonAsync(
            "api/user/profile-update",
            Model
        );

        isSaving = false;
         if (response.IsSuccessStatusCode)
    {
        activeEdit = Edit.None;
    }
    else
    {
        var error = await response.Content.ReadFromJsonAsync<ApiError>();
        errorMessage = error?.Message ?? "Something went wrong";
    }

    }

    private string GetImage()
    {
        if (!string.IsNullOrEmpty(imagePreview))
            return imagePreview;

        if (!string.IsNullOrEmpty(Model.Image))
            return Model.Image.StartsWith("http")
                ? Model.Image
                : $"{Http.BaseAddress}{Model.Image}";

        return "/avtar.png";
    }

    private async Task<string> GetImagePreview(IBrowserFile file)
    {
        using var stream = file.OpenReadStream(5_000_000);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        return $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private async Task OnImageUpload(InputFileChangeEventArgs e)
    {
        selectedImage = e.File;
        if (selectedImage == null) return;

        imagePreview = await GetImagePreview(selectedImage);
        showConfirmPopup = true;
    }


    private async Task ConfirmImageChange()
    {
        if (isUpdate || selectedImage == null) return;

        isUpdate = true;

        var content = new MultipartFormDataContent();
        content.Add(
            new StreamContent(selectedImage.OpenReadStream(5_000_000)),
            "file",
            selectedImage.Name
        );

        var response = await Http.PostAsync("api/user/upload-image", content);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<ImageDto>();
            Model.Image = result!.Image;

            showConfirmPopup = false;
            imagePreview = null;
            selectedImage = null;

            StateHasChanged();
        }

        isUpdate = false;
    }

    private void CancelImageChange()
    {
        imagePreview = null;
        showConfirmPopup = false;
    }

    public class ApiError
    {
        public string Message { get; set; } = "";
    }

}
