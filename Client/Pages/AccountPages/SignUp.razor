@using Applications.Dto.AccountDto
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="position-relative">
    <!-- Close Icon -->
    <button type="button" class="btn-close position-absolute top-0 end-0 m-0"
            aria-label="Close" @onclick="OnCancelClicked"></button>

    <EditForm Model="@signupModel" OnValidSubmit="@HandleSignup">
        <DataAnnotationsValidator />

        
        <!-- Email -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Email</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-envelope-fill"></i></span>
                <InputText type="email" class="form-control" placeholder="Enter email" @bind-Value="signupModel.Email" />
            </div>
            <ValidationMessage For="@(() => signupModel.Email)" />
        </div>

        <!-- Phone -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Phone Number</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-telephone-fill"></i></span>
                <InputText type="tel" class="form-control" placeholder="Enter phone number" @bind-Value="signupModel.PhoneNumber" />
            </div>
        </div>

        <!-- Password -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Password</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-lock-fill"></i></span>
                <InputText type="password" class="form-control" placeholder="Enter password" @bind-Value="signupModel.Password" />
            </div>
            <ValidationMessage For="@(() => signupModel.Password)" />
        </div>

        <!-- Role -->
        @*<div class="mb-3">
            <label class="form-label fw-semibold">Role</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-people-fill"></i></span>
                <InputSelect class="form-select" @bind-Value="signupModel.Role">
                    <option value="">Select a role</option>
                    <option value="User">User</option>
                    <option value="Organizer">Organizer</option>
                </InputSelect>
            </div>
        </div>*@

        <button type="submit" class="btn btn-danger w-100 fw-semibold mt-2">
            <i class="bi bi-person-plus-fill me-2"></i> Sign Up
        </button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3 small text-center">@errorMessage</div>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success mt-3 small text-center">@successMessage</div>
        }

        <div class="text-center mt-3">
            <span class="text-muted small">Already have an account?</span>
            <a href="javascript:void(0)" class="fw-semibold text-decoration-none text-primary"
               @onclick="SwitchToLogin"> Login</a>
        </div>
    </EditForm>
</div>

@code {
    private SignUpDto signupModel = new SignUpDto();
    private string errorMessage = "";
    private string successMessage = "";

    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnSwitchToLogin { get; set; }


    private async Task HandleSignup()
    {
        errorMessage = "";
        successMessage = "";

        try
        {
            var response = await Http.PostAsJsonAsync("https://localhost:7239/api/Account/signup", signupModel);

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Signup successful! Redirecting to login...";
                StateHasChanged();
                await Task.Delay(2000);
                if (OnSwitchToLogin.HasDelegate)
                    await OnSwitchToLogin.InvokeAsync();
            }
            else
            {
                var resp = await response.Content.ReadAsStringAsync();
                errorMessage = $"Signup failed: {resp}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred: " + ex.Message;
        }
    }

    private async Task OnCancelClicked() => await OnCancel.InvokeAsync();

    private async Task SwitchToLogin() => await OnSwitchToLogin.InvokeAsync();
}
