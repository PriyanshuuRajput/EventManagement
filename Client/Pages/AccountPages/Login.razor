@page "/login"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject CustomAuthStateProvider AuthStateProvider

@inject NavigationManager Navigation
@inject IJSRuntime JS


<div class="container d-flex justify-content-center align-items-center min-vh-120 ">
    <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5" style="max-width: 500px; width: 100%;">
        <h3 class="text-center text-danger fw-bold mb-4">Welcome Back 👋</h3>
        <p class="text-center text-muted mb-4">Login to continue to <strong>EventiGO</strong></p>

        <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
            <DataAnnotationsValidator />

            <!-- Username / Email / Phone -->
            <div class="mb-3">
                <label class="form-label fw-semibold">Username / Email / Phone</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-person-fill"></i></span>
                    <InputText class="form-control" placeholder="Enter your details " @bind-Value="loginModel.Identifier" />
                </div>
                <ValidationMessage For="@(() => loginModel.Identifier)" />
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label class="form-label fw-semibold">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-lock-fill"></i></span>
                    <InputText type="password" class="form-control" placeholder="Enter your password" @bind-Value="loginModel.Password" />
                </div>
                <ValidationMessage For="@(() => loginModel.Password)" />
            </div>

            <!-- Login Button -->
            <button type="submit" class="btn btn-outline-danger w-100 fw-semibold py-2 mt-2">
                <i class="bi bi-box-arrow-in-right me-2"></i>Login
            </button>

            <!-- Error Message -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3 text-center small">@errorMessage</div>
            }

            <!-- Divider -->
            <div class="text-center my-3 position-relative">
                <hr class="text-muted" />
                <span class="bg-white px-3 text-muted small position-absolute top-50 start-50 translate-middle">OR</span>
            </div>

            <!-- Signup Redirect -->
            <div class="text-center">
                <span class="text-muted small">Don't have an account?</span>
                <a href="/signup" class="fw-semibold text-decoration-none text-primary"> Sign Up</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private LoginDto loginModel = new LoginDto();
    private string errorMessage = "";

    private async Task HandleLogin()
    {
        errorMessage = "";
        try
        {
            var response = await Http.PostAsJsonAsync("https://localhost:7239/api/Account/login", loginModel);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();

                if (result != null && !string.IsNullOrEmpty(result.Token))
                {
                    //Save Jwt and role to localStorage
                    await JS.InvokeVoidAsync("localStorage.setItem", "authToken", result.Token);
                    await JS.InvokeVoidAsync("localStorage.setItem", "userRole", result.Role ?? "");

                    // ✅ Notify authentication state
                    AuthStateProvider.NotifyUserAuthentication(result.Token);

                    //Redirect based on role
                    if (result.Role?.Equals("Admin", StringComparison.OrdinalIgnoreCase) == true)
                        Navigation.NavigateTo("/admin-dashboard");
                    else
                        Navigation.NavigateTo("/");
                }
                else
                {
                    errorMessage = "Invalid login";
                }
            }
            else
            {
                var resp = await response.Content.ReadAsStringAsync();
                errorMessage = $"Login failed: {resp}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred: " + ex.Message;
        }
    }
    private class LoginResponse
    {
        public string? Token { get; set; }
        public string? Role { get; set; }
    }
}
