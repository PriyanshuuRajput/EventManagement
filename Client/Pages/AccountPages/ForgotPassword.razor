<EditForm Model="@model" OnValidSubmit="SendResetLink">
    <DataAnnotationsValidator />

    <h4 class="text-center mb-2 fw-bold fs-5">Forgot Password</h4>

    <div class="mb-3 fw-semibold ">
        <label class="form-label ">Email<span class="text-danger">*</span></label>
        <div class="input-group">
            <span class="input-group-text bg-white">
                <i class="bi bi-envelope-fill"></i>
            </span>
            <input class="form-control"placeholder="Enter your email"
                @bind="model.Email" />
        </div>
        <small class="text-muted">
            We’ll send a password reset link to this email if it exists.
        </small>
        <ValidationMessage For="@(() => model.Email)" class= "text-danger small"/>
    </div>

    <button class="btn btn-danger w-100" disabled="@isSending">
        @if (isSending)
        {
            <span class="spinner-border spinner-border-sm me-2"></span>
        }
        Send Reset Link
    </button>

    <button type="button"
            class="btn btn-link w-100 mt-2"
            @onclick="BackToLogin">
        Back to Login
    </button>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-success mt-3 small text-center">
            @message
        </div>
    }
</EditForm>
@code {
    private ForgotPasswordDto model = new();
    private bool isSending;
    private string? message;

    [Parameter] public EventCallback OnBack { get; set; }

    private async Task SendResetLink()
    {
        isSending = true;
        message = null;

        var response = await Http.PostAsJsonAsync(
            "api/Account/forgot-password", model);

        message = "Please Check your Email , reset link has been sent.";
        isSending = false;
    }

    private async Task BackToLogin()
        => await OnBack.InvokeAsync();
}
