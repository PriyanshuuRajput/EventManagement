
@using System.Text;
@using Applications.Dto.AccountDto
@inherits LoginBase

<EditForm Model="@loginModel" OnValidSubmit="@HandleLoginForm">
    <DataAnnotationsValidator />

    <button type="button" class="btn-close position-absolute top-0 end-0 m-3"
            aria-label="Close" @onclick="OnCancelClicked"></button>


    <div class="mb-3">
        <label class="form-label fw-semibold">Username / Email</label>
        <div class="input-group">
            <span class="input-group-text bg-white">
                <i class="bi bi-envelope-fill"></i>
            </span>
            <input class="form-control" placeholder="Enter username or Email"
                       @bind="loginModel.Identifier" />
        </div>
        <ValidationMessage For="@(() => loginModel.Identifier)" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Password</label>
        <div class="input-group">
            <span class="input-group-text bg-white">
                <i class="bi bi-lock-fill"></i>
            </span>
            <input class="form-control" type="@PasswordInputType" placeholder="Enter password"
                       @bind="loginModel.Password" />   
            <button type="button" class="input-group-text bg-white" @onclick="()=>showPassword =! showPassword">
                <i class=@EyeIcon></i>
            </button>
        </div>
        <ValidationMessage For="@(() => loginModel.Password)" />
    </div>

    <button type="submit" class="btn btn-danger w-100 mb-2"
            disabled ="@isProcessing">
        @if(isProcessing){
        <span class="spinner-border spinner-border-sm me-2"></span>
        }
        <i class="bi bi-box-arrow-in-right me-2"></i> Login
    </button>

    <div class="text-center">
        <span class="text-muted small">Don't have an account?</span>
        <a href="javascript:void(0)"
           class="fw-semibold text-decoration-none text-primary ms-1"
           @onclick="async () => await OnSwitchToSignup.InvokeAsync()">
            Sign Up
        </a>
    </div>


    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3 small text-center">@errorMessage</div>
    }
</EditForm>

    @code {
    [Parameter] public EventCallback OnSuccess { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnSwitchToSignup { get; set; }
    [Parameter] public string? email { get; set; }

    private bool showPassword = false;
    private bool isProcessing = false;

    private string PasswordInputType => showPassword ? "text" : "password";
    private string EyeIcon => showPassword ? "bi-eye-fill" : "bi-eye-slash-fill";

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(email))
        {

            try
            {
                var decodeBytes = Convert.FromBase64String(email);
                var decodeEmail = Encoding.UTF8.GetString(decodeBytes);

                loginModel.Identifier = decodeEmail;
            }
            catch
            {

                loginModel.Identifier = email;
            }
        }
    }


    private async Task HandleLoginForm()
    {
        if (isProcessing)
            return;

        isProcessing = true;
        StateHasChanged();

        try
        {
            var http = new HttpClient();
            var response = await http.PostAsJsonAsync("https://localhost:7239/api/Account/login", loginModel);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                loginModel = new LoginDto();
                StateHasChanged();
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<ManagerLoginResponseDto>();

            if (result == null)
            {
                errorMessage = "Unexpected server response.";
                return;
            }

            if (result.ChangePassword == true)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "authToken", result.Token);
                Navigation.NavigateTo("/manager-profile-change-password", true);
                return;
            }

            await JS.InvokeVoidAsync("localStorage.setItem", "authToken", result.Token);

            if (AuthStateProvider is CustomAuthStateProvider customProvider)
            {
                customProvider.NotifyUserAuthentication(result.Token);
            }

            await OnSuccess.InvokeAsync();
        }
        finally
        {
            loginModel = new LoginDto();
            
            isProcessing = false;
            StateHasChanged();
        }
    }


    private async Task OnCancelClicked() => await OnCancel.InvokeAsync();


}