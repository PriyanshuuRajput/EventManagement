@code {

    private List<EventCategoryDto> categories = new();
    private List<EventDto> events = new();
    private List<HomeBannerDto> homeBanners = new();

    //Search bar
    private string searchText = "";
    private bool showSuggestions = false;
    private List<EventDto> suggestionList = new();
    private List<EventDto> allEvents = new();
    // private CancellationTokenSource? debounceCts;
    private ElementReference scrollContainer;
    private ElementReference scrollArtistContainer;





    protected override async Task OnInitializedAsync()
    {
        try
        {
            spinnerService.Show();

            await Task.Delay(200);

            categories = await Http.GetFromJsonAsync<List<EventCategoryDto>>(
                "api/EventCategory") ?? new();

            allEvents = await Http.GetFromJsonAsync<List<EventDto>>(
                "api/Events/approved") ?? new();

            events = allEvents
                .Where(e => e.StartDate >= DateTime.Now)
                .OrderBy(e => e.StartDate)
                .Take(10)
                .ToList();

            homeBanners = await Http.GetFromJsonAsync<List<HomeBannerDto>>(
                "api/HomeBanner/active") ?? new();

            homeBanners = homeBanners
                .OrderBy(b => b.Position)
                .Take(5)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            spinnerService.Hide();
        }
    }


    string GetCategoryImage(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
            return "/images/category-placeholder.png";

        // absolute URL → return as-is
        if (imageUrl.StartsWith("http"))
            return imageUrl;

        // relative path → attach API base URL
        return $"{Http.BaseAddress}{imageUrl.TrimStart('/')}";
    }

    string GetEventImage(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
            return "/images/event-placeholder.png";

        if (imageUrl.StartsWith("http"))
            return imageUrl;

        return $"{Http.BaseAddress}{imageUrl.TrimStart('/')}";
    }
    string GetBannerImagePath(string? image)
    {
        if (string.IsNullOrWhiteSpace(image))
            return "/images/default-banner.jpg";

        if (image.StartsWith("http"))
            return image;

        return $"{Http.BaseAddress}{image.TrimStart('/')}";
    }

    string GetBannerImage(HomeBannerDto banner)
    {
        if (banner.EventId != null)
        {
            var ev = allEvents.FirstOrDefault(e => e.Id == banner.EventId);
            return ev != null
                ? GetEventImage(ev.ImageUrl)
                : "/images/default-banner.jpg";
        }

        return GetBannerImagePath(banner.Image);
    }
    void OnBannerClick(HomeBannerDto banner)
    {
        if (banner.EventId != null)
        {
            Navigation.NavigateTo($"/book-event/{banner.EventId}");
        }
        else if (!string.IsNullOrWhiteSpace(banner.Link))
        {
            Navigation.NavigateTo(banner.Link, forceLoad: true);
        }
    }



    private async Task ScrollLeft()
    {
        await JS.InvokeVoidAsync("scrollByAmount", scrollContainer, -300);
    }

    private async Task ScrollRight()
    {
        await JS.InvokeVoidAsync("scrollByAmount", scrollContainer, 300);
    }
    private async Task ScrollArtistLeft()
    {
        await JS.InvokeVoidAsync("scrollByAmount", scrollArtistContainer, -300);
    }

    private async Task ScrollArtistRight()
    {
        await JS.InvokeVoidAsync("scrollByAmount", scrollArtistContainer, 300);
    }


    void GoToEventDetails(int eventId)
    {
        Navigation.NavigateTo($"/book-event/{eventId}");
    }

    void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    void GoToEvent()
    {
        Navigation.NavigateTo("/events",forceLoad:true);
    }

    void GoToCategory(string categorySlug)
    {
        Navigation.NavigateTo($"/events?category={categorySlug}");
    }


    
}