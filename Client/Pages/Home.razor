@page "/"

@using Applications.Dto
@inject HttpClient Http

@inject NavigationManager Navigation




<PageTitle>EventiGo-Home</PageTitle>

<style>
    .hero-carousel-item {
        height: 60vh;
        min-height: 350px;
        max-height: 500px;
        position: relative;
        overflow:hidden;

    }

    .hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        filter: brightness(85%);
        transition: transform 0.6s ease;
        will-change: transform; 
    }


.hero-carousel-item:hover .hero-img {
    transform: scale(1.05);
}


    .hero-carousel-item::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient( to right, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.25) 35%, transparent 65% );
        pointer-events: none;
    }


.carousel-caption {
    bottom: 20px;
    right:auto;
    text-align: left;
    left: 100px;
}

.carousel-caption h1 {
    font-size: 2rem;
    font-weight: 600;
    text-shadow: 0 2px 10px rgba(0,0,0,0.6);
}

/* Modern buttons */
.carousel-caption button {
    padding: 10px 20px;
    font-size: 1rem;
    border-radius: 6px;
}

/* Indicators  */
    .carousel-indicators {
        bottom: 18px;
        gap: 8px;
    }

        .carousel-indicators [data-bs-target] 
        {
            width: 22px;
            height: 6px;
            border-radius: 10px;
            background-color: rgba(255, 255, 255, 0.5);
            border: none;
            transition: all 0.3s ease;
        }

        .carousel-indicators .active 
        {
            width: 40px;
            background-color: #dc3545; 
        }

    .icon-only-control {
        width: auto !important;
        pointer-events: none; 
        opacity: 1;
    }

        .icon-only-control span {
            pointer-events: auto;
            width: 44px;
            height: 44px;
            cursor: pointer;
            filter: drop-shadow(0 0 8px rgba(0,0,0,0.9));
        }
    .carousel-control-prev.icon-only-control {
        left: 20px;
    }

    .carousel-control-next.icon-only-control {
        right: 20px;
    }

    .category-img {
        height: 180px;
        object-fit: cover;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

.category-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
}

.category-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 30px rgba(0,0,0,0.15);
}
.popular-badge{
        position: absolute;
        top: 55%;
        right: 4px;
        z-index:2;
        color: #dc3545;
        font-size: 0.75rem;
        font-weight: 600;
}
    .scroll-container {
        overflow-x: auto;
        overflow-y: hidden;
        scroll-behavior: smooth;
        padding-bottom: 10px;
        scrollbar-width: none; 
        gap:36px
        /* -ms-overflow-style: none; */
    }

        .scroll-container::-webkit-scrollbar {
            height: 6px;
            display: none;
        }

        .scroll-container::-webkit-scrollbar-thumb {
            background: #ccc;
            border-radius: 10px;
        }
    .event-card {
        transition: transform .25s ease, box-shadow .25s ease;
        width:200px
    }

        .event-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,.15);
        }


</style>

<section class="p-0">
    <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000" data-bs-pause="false">
        <div class="carousel-inner">

            @if (events.Any())
            {
                @for (int i = 0; i < events.Count; i++)
                {
                    var evt = events[i];

                    <div class="carousel-item hero-carousel-item @(i == 0 ? "active" : "")">
                        <img src="@GetEventImage(evt.ImageUrl)"
                             class="hero-img d-block w-100"
                             alt="@evt.Title">

                        <div class="carousel-caption d-none d-md-block text-start">
                            <h1 class="display-4 fw-bolder text-uppercase">
                                @evt.Title
                            </h1>
                            <p class="small">
                                @evt.StartDate.ToString("dd MMM yyyy, hh:mm tt")
                            </p>
                            <button class="btn btn-danger btn-lg"
                                    @onclick="() => GoToEventDetails(evt.Id)">
                                Explore 
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- fallback slide -->
                <div class="carousel-item active hero-carousel-item">
                    <img src="/images/default-banner.jpg"
                         class="hero-img d-block w-100">
                </div>
            }

        </div>
        <div class="carousel-indicators">
            @for (int i = 0; i < events.Count; i++)
            {
                <button type="button"
                        data-bs-target="#heroCarousel"
                        data-bs-slide-to="@i"
                        class="@(i == 0 ? "active" : "")"
                        aria-current="@(i == 0 ? "true" : "false")">
                </button>
            }
        </div>
        <button class="carousel-control-prev icon-only-control"
                type="button"
                data-bs-target="#heroCarousel"
                data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>

        <button class="carousel-control-next icon-only-control"
                type="button"
                data-bs-target="#heroCarousel"
                data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>

    </div>
</section>
<section>
    <div class="container" style="margin-top:40px">
        <h2 class="mt-4 mb-4 fw-bold">EventiGo Category</h2>

        <div class="row text-center">
            @foreach (var category in categories)
            {
                <div class="col-6 col-md-3 mb-4">
                    <div class="card h-100 shadow category-card"
                         @onclick='() => GoToCategory(category.Slug)'>

                        <img src="@GetCategoryImage(category.ImageUrl)"
                             class="card-img-top category-img"
                             alt="@category.Name">

                        <div class="card-body d-flex align-items-center justify-content-center">
                            <h5 class="card-title mb-0">
                                @category.Name
                            </h5>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="bg-light py-4">
    <div class="container">
        <h2 class="m-4 fw-bold">Popular Events</h2>

        <div class="d-flex flex-nowrap scroll-container">
        
            @foreach (var ev in events)
            {
                @* <div class="col-6 col-md-2 mb-4"> *@
                    <div class="card shadow-sm event-card position-relative flex-shrink-0"
                         @onclick="() => GoToEventDetails(ev.Id)">

                        @if (ev.IsPromoted)
                        {
                            <span class="badge popular-badge px-2 bg-light">
                                Promoted
                            </span>
                        }

                        <img src="@GetEventImage(ev.ImageUrl)"
                             class="card-img-top"
                             style="height:180px; object-fit:cover;"
                             alt="@ev.Title">

                        <div class="card-body d-flex flex-column mt-2">
                            <h5 class="card-title fw-bold">@ev.Title</h5>
                            @* <p class="card-text text-muted text-truncate">
                                @ev.Description
                            </p> *@

                            <button class="mt-auto btn btn-danger"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => GoToEventDetails(ev.Id)">
                                View Details
                            </button>
                        </div>
                    </div>
                @* </div> *@
            }
            @* <button class="btn btn-light arrow left"
                    @onclick="ScrollLeft">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="btn btn-light arrow right"
                    @onclick="ScrollRight">
                <i class="bi bi-chevron-right"></i>
            </button> *@

        </div>
    </div>
</section>

