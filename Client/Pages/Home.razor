@page "/"
@using Applications.Dto
@using EventBooking.Client.SpinnerService

@inject HttpClient Http
@inject SpinnerService spinnerService
@inject NavigationManager Navigation




<PageTitle>EventiGo-Home</PageTitle>

<style>
    .hero-carousel-item {
        height: 60vh;
        min-height: 350px;
        max-height: 500px;
        position: relative;
        overflow:hidden;

    }

    .hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        filter: brightness(85%);
        transition: transform 0.6s ease;
        will-change: transform; 
    }


.hero-carousel-item:hover .hero-img {
    transform: scale(1.05);
}


    .hero-carousel-item::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient( to right, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.15) 100%, transparent 100% );
        pointer-events: none;
    }

    .hero-placeholder {
        width: 100%;
        height: 100%;
        box-shadow:inset 0px 0px 20px 20px rgba(0,0,0,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }

        .hero-placeholder i {
            font-size: 4rem;
            opacity: 0.9;
        }


.carousel-caption {
    bottom: 20px;
    right:auto;
    text-align: left;
    left: 100px;
}

.carousel-caption h1 {
    font-size: 2rem;
    font-weight: 600;
    text-shadow: 0 2px 10px rgba(0,0,0,0.6);
}

/* Modern buttons */
.carousel-caption button {
    padding: 10px 20px;
    font-size: 1rem;
    border-radius: 6px;
}

/* Indicators  */
    .carousel-indicators {
        bottom: 18px;
        gap: 8px;
    }

        .carousel-indicators [data-bs-target] 
        {
            width: 22px;
            height: 6px;
            border-radius: 10px;
            background-color: rgba(255, 255, 255, 0.5);
            border: none;
            transition: all 0.3s ease;
        }

        .carousel-indicators .active 
        {
            width: 40px;
            background-color: #dc3545; 
        }

    .icon-only-control {
        width: auto !important;
        pointer-events: none; 
        opacity: 1;
    }

        .icon-only-control span {
            pointer-events: auto;
            width: 44px;
            height: 44px;
            cursor: pointer;
            filter: drop-shadow(0 0 8px rgba(0,0,0,0.9));
        }
    .carousel-control-prev.icon-only-control {
        left: 20px;
    }

    .carousel-control-next.icon-only-control {
        right: 20px;
    }
    .brand-placeholder {
        height: 180px; 
        width: 100%;
        border-radius: 5px 5px 0 0;
        background: linear-gradient( to right, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.15) 100%, transparent 100% );
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .brand-placeholder img {
            width: 48px;
            height: 48px;
            object-fit: contain;
            opacity: 0.95;
        }
    /* GLASS CONTAINER */
    .logo-hover {
        position: relative;
        overflow: hidden;
    }

        .logo-hover::after {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(8px);
            opacity: 0;
            transition: opacity 0.35s ease;
            pointer-events: none;
        }

        .logo-hover img {
            transition: transform 0.9s ease, filter 0.4s ease;
            will-change: transform;
        }
        .logo-hover:hover::after {
            opacity: 1;
        }

        .logo-hover:hover img {
            transform: rotate(360deg) scale(1.05);
            filter: brightness(1.05);
        }


    .category-img {
        height: 180px;
        object-fit: cover;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

.category-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
}

.category-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 30px rgba(0,0,0,0.15);
}
.popular-badge{
        position: absolute;
        top: 55%;
        right: 4px;
        z-index:2;
        color: #dc3545;
        font-size: 0.75rem;
        font-weight: 600;
}
    .scroll-container {
        overflow-x: auto;
        overflow-y: hidden;
        scroll-behavior: smooth;
        padding-bottom: 10px;
        scrollbar-width: none; 
        gap: 30px
        /* -ms-overflow-style: none; */
    }

        .scroll-container::-webkit-scrollbar {
            height: 6px;
            display: none;
        }

        .scroll-container::-webkit-scrollbar-thumb {
            background: #ccc;
            border-radius: 10px;
        }

    .scroll-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: none;
        background: white;
        box-shadow: 0 4px 10px rgba(0,0,0,.2);
    }

        .scroll-arrow.left {
            left: -20px;
        }

        .scroll-arrow.right {
            right: -20px;
        }

    .event-card {
        transition: transform .25s ease, box-shadow .25s ease;
        width:200px
    }

        .event-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,.15);
        }


</style>

<section class="p-0">
    <div id="heroCarousel" class="carousel slide"
         data-bs-ride="carousel"
         data-bs-interval="3000"
         data-bs-pause="false">

        <div class="carousel-inner">

            @if (homeBanners.Any())
            {
                @for (int i = 0; i < homeBanners.Count; i++)
                {
                    var banner = homeBanners[i];

                    <div class="carousel-item hero-carousel-item @(i == 0 ? "active" : "")"
                         role="button"
                         style="cursor:pointer"
                         @onclick="() => OnBannerClick(banner)">

                        @if (!string.IsNullOrWhiteSpace(GetBannerImage(banner)))
                        {
                            <img src="@GetBannerImage(banner)"
                                 class="hero-img d-block w-100"
                                 alt="@banner.Title"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        }

                        <div class="hero-placeholder" style="display:none;">
                            <i class="bi bi-calendar-event"></i>
                        </div>

                    </div>
                }
            }
            else
            {
                <div class="carousel-item active hero-carousel-item logo-hover">
                    <div class="hero-placeholder">
                        <img src="logo.png"
                             style="width:100px; height:100px; opacity:1; border-radius:6px" />
                    </div>
                </div>
            }

        </div>


        <!-- INDICATORS -->
        <div class="carousel-indicators">
            @for (int i = 0; i < homeBanners.Count; i++)
            {
                <button type="button"
                        data-bs-target="#heroCarousel"
                        data-bs-slide-to="@i"
                        class="@(i == 0 ? "active" : "")"
                        aria-current="@(i == 0)">
                </button>
            }
        </div>

        <button class="carousel-control-prev icon-only-control"
                type="button"
                data-bs-target="#heroCarousel"
                data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next icon-only-control"
                type="button"
                data-bs-target="#heroCarousel"
                data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</section>

<section>
    <div class="container" style="margin-top:40px">
        <h2 class="mt-4 mb-4 fw-bold">EventiGo Category</h2>

        <div class="row text-center">
            @foreach (var category in categories)
            {
                <div class="col-6 col-md-3 mb-4">
                    <div class="card h-100 shadow category-card"
                         @onclick='() => GoToCategory(category.Slug)'>
                        @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
                        {
                            <img src="@GetCategoryImage(category.ImageUrl)"
                                 class="card-img-top category-img"
                                 alt="@category.Name"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        }
                        else
                        {
                            <div class="brand-placeholder logo-hover ">
                                <img src="logo.png" alt="EventiGo" />
                            </div>
                        }

                        <div class="card-body d-flex align-items-center justify-content-center">
                            <h5 class="card-title mb-0">
                                @category.Name
                            </h5>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="bg-light py-4">
    <div class="container">
        <h2 class="m-4 ms-0 fw-bold">Popular Events</h2>
        <div class="position-relative">
            <button class="btn btn-light scroll-arrow left" @onclick="ScrollLeft">
                <i class="bi bi-chevron-left text-danger"></i>
            </button>
            <button class="btn btn-light scroll-arrow right" @onclick="ScrollRight">
                <i class="bi bi-chevron-right text-danger"></i>
            </button>
        <div class="d-flex flex-nowrap scroll-container"
             @ref="scrollContainer">
        
            @foreach (var ev in events)
            {
                    <div class="card shadow-sm event-card position-relative flex-shrink-0"
                         @onclick="() => GoToEventDetails(ev.Id)">

                        @if (ev.IsPromoted)
                        {
                            <span class="badge popular-badge px-2 bg-light text-dark">
                                Promoted
                            </span>
                        }

                        <img src="@GetEventImage(ev.ImageUrl)"
                             class="card-img-top"
                             style="height:180px; object-fit:cover;"
                             alt="@ev.Title">

                        <div class="card-body d-flex flex-column mt-2">
                            <h5 class="card-title fw-bold">@ev.Title</h5>
                            @* <p class="card-text text-muted text-truncate">
                                @ev.Description
                            </p> *@

                            <button class="mt-auto btn btn-danger"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => GoToEventDetails(ev.Id)">
                                View Details
                            </button>
                        </div>
                    </div>  
            }
        </div>
        </div>
    </div>
</section>

