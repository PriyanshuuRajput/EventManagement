@page "/"

@using Applications.Dto
@inject HttpClient Http

@inject NavigationManager Navigation




<PageTitle>EventiGo-Home</PageTitle>

<style>

.hero-carousel-item {
    height: 400px;
    /* overflow: hidden; */
    position: relative;
}


/* .carousel.slide .carousel-item {
    transition: opacity 0.8s ease-in-out;
} */

.hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(80%);
    transition: transform 0.6s ease;
}

.hero-carousel-item:hover .hero-img {
    transform: scale(1.05);
}


.hero-carousel-item::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 35%;
    background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
    pointer-events: none;
}


.carousel-caption {
    bottom: 10px;
    text-align: left;
    left: 40px;
}

.carousel-caption h1 {
    font-size: 2rem;
    font-weight: 600;
    text-shadow: 0 2px 10px rgba(0,0,0,0.6);
}

/* Modern buttons */
.carousel-caption button {
    padding: 10px 20px;
    font-size: 1rem;
    border-radius: 6px;
}

/* Indicators  */
.carousel-indicators [data-bs-target] {
    width: 10px;
    height: 10px;
    background-color: rgba(255,255,255,0.6);
    border-radius: 50%;
    transition: 0.3s ease;
    border-bottom:0px;
    border-top:0px;
}

.carousel-indicators .active {
    width: 16px;
    border-radius: 8px;
    background: #fff;
}

/* Prev/Next arrows */
.carousel-control-prev-icon,
.carousel-control-next-icon {
    filter: drop-shadow(0 0 8px rgba(0,0,0,0.9));
    width: 45px;
    height: 45px;
}

/* Remove the black bg circle */
.carousel-control-prev-icon,
.carousel-control-next-icon {
    background-color: transparent !important;
}

    .category-img {
        height: 180px;
        object-fit: cover;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
    }

.category-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
}

.category-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 30px rgba(0,0,0,0.15);
}


</style>

<section class="p-0">
    <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
        <div class="carousel-inner">

            <div class="carousel-item active hero-carousel-item">
                <img src="concerts-crousel.png" class="hero-img d-block" alt="Live Music Fest">
                <div class="carousel-caption d-none d-md-block text-start">
                    <h1 class="display-4 fw-bolder text-uppercase">LIVE MUSIC FEST</h1>
                    @* <button class="btn btn-danger btn-lg" @onclick="GoToEvent">Explore Concerts</button> *@
                </div>
            </div>

            <div class="carousel-item hero-carousel-item">
                <img src="movie-crousel.png" class="hero-img d-block" alt="Big Game Thrills">
                <div class="carousel-caption d-none d-md-block text-start">
                    <h1 class="display-4 fw-bolder text-uppercase">LIVE MUSIC FEST</h1>
                    @* <button class="btn btn-danger btn-lg" @onclick="GoToEvent">Explore Concerts</button> *@
                </div>
            </div>

            <div class="carousel-item hero-carousel-item">
                <img src="threater-crousel.png" class="hero-img d-block" alt="Drama and Shows">
                <div class="carousel-caption d-none d-md-block text-start">
                    <h1 class="display-4 fw-bolder text-uppercase">DRAMA & SHOWS</h1>
                    @* <button class="btn btn-danger btn-lg" @onclick="GoToEvent">Book Shows</button> *@
                </div>
            </div>

            <div class="carousel-item hero-carousel-item">
                <img src="comedyshow-crousel.png" class="hero-img d-block" alt="Comedy Nights">
                <div class="carousel-caption d-none d-md-block text-start">
                    <h1 class="display-4 fw-bolder text-uppercase">COMEDY NIGHTS</h1>
                    @* <button class="btn btn-danger btn-lg" @onclick="GoToEvent">Find Comedy</button> *@
                </div>
            </div>

        </div>

        <div class="carousel-indicators">
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="3" aria-label="Slide 4"></button>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon bg-dark p-3 rounded-circle" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon bg-dark p-3 rounded-circle" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</section>


