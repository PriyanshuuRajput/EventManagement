@using Applications.Dto
@using EventBooking.Client.SpinnerService;
@using System.Net.Http.Headers

@inject SpinnerService spinnerService
@inject HttpClient Http




<style>
    .custom-modal-content {
        border-radius: 16px !important;
        border: none !important;
        animation: scaleIn 0.25s ease-out;
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    .category-table {
        font-size: 0.95rem;
    }

    .category-row {
        border-bottom: 3px solid #f0f0f0;
    }

        .category-row:last-child {
            border-bottom: none;
        }

    .category-img {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 8px;
        /* border: 1px solid #e6e6e6; */
        background: #f8f9fa;
    }

        .category-img.placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

    .category-row td {
        padding: 14px 16px;
    }

</style>
<div class="fade-in">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-semibold text-dark mb-0" style="font-size:30px">
            Category
        </h3>

        <button class="btn btn-outline-danger"
                @onclick="ShowAddCategoryModal">
            <i class="bi bi-plus-circle me-1"></i>
            Add Category
        </button>
    </div>

    <!-- CATEGORY TABLE -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <table class="table table-borderless align-middle mb-0 category-table">
                <thead class="border-bottom">
                    <tr class="text-muted small text-uppercase">
                        <th style="width:30%">Category</th>
                        <th>Description</th>
                        <th class="text-center" style="width:15%">Actions</th>
                    </tr>
                </thead>


                <tbody>
                    @if (Categories == null || !Categories.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-x fs-4 d-block mb-2"></i>
                                No categories found
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in Categories)
                        {
                            <tr class="category-row">
                                <!-- CATEGORY INFO -->
                                <td>
                                    <div class="d-flex align-items-center gap-5">

                                        <!-- IMAGE -->
                                        @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                                        {
                                            <img src="@GetImageUrl(c.ImageUrl)"
                                                 class="category-img" />
                                        }
                                        else
                                        {
                                            <div class="category-img placeholder">
                                                <i class="bi bi-image text-muted"></i>
                                            </div>
                                        }

                                    <!-- NAME -->
                                    <div style="font-size:16px ; font-weight:600">
                                        <div class="fw-semibold text-dark">
                                            @c.Name
                                        </div>
                                        <div class="text-muted small">
                                            Category
                                        </div>
                                    </div>

                                </div>
                            </td>

                            <!-- DESCRIPTION -->
                            <td class="">
                                @(string.IsNullOrWhiteSpace(c.Description)
                                                            ? "No description provided"
                                                            : c.Description)
                                </td>

                                <!-- ACTIONS -->
                                <td class="text-center">
                                    <div class="d-inline-flex gap-2">
                                        <button class="btn btn-light btn-sm border"
                                                title="Edit"
                                                @onclick="() => EditCategory(c)">
                                            <i class="bi bi-pencil text-warning"></i>
                                        </button>

                                        <button class="btn btn-light btn-sm border"
                                                title="Delete"
                                                @onclick="() => OpenDeleteModal(c.Id)">
                                            <i class="bi bi-trash text-danger"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

<!-- ================= CATEGORY MODAL ================= -->
@if (showCategoryModal)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background:rgba(0,0,0,0.5); backdrop-filter:blur(6px);">

        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content border-0 custom-modal-content">

                <div class="modal-header border-0">
                    <h5 class="modal-title fw-semibold" style="font-size:18px">
                        @(editingCategory.Id == 0 ? "Add Category" : "Edit Category")
                    </h5>
                </div>

                <div class="modal-body">
                    <EditForm Model="editingCategory" OnValidSubmit="SaveCategory">
                        <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Category Name <span class="text-danger">*</span>
                        </label>
                            <InputText class="form-control"
                                       @bind-Value="editingCategory.Name" />
                            <ValidationMessage For="@(() => editingCategory.Name)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <InputTextArea class="form-control"
                       rows="3"
                       @bind-Value="editingCategory.Description" />
                    </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold"> Image
                                @if (editingCategory.Id == 0)
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>
                        <div class="row align-items-center g-3">

                            <div class="col-md-7">
                                <InputFile OnChange="HandleImageSelected"
                                           class="form-control"
                                           accept="image/png,image/jpeg" />
                                <small class="text-muted">
                                    JPG or PNG · Max 2MB
                                </small>
                                    @if (!string.IsNullOrWhiteSpace(imageError))
                                    {
                                        <div class="text-danger small mt-1">
                                            @imageError
                                        </div>
                                    }
                            </div>
                            @* <ValidationMessage For="@(() => editingCategory.ImageUrl)" class="text-danger small" /> *@
                            <div class="col-md-5 text-center">
                                @if (!string.IsNullOrWhiteSpace(imagePreviewUrl) ||!string.IsNullOrWhiteSpace(editingCategory.ImageUrl))
                                {
                                    <img src="@(imagePreviewUrl ?? GetImageUrl(editingCategory.ImageUrl))"
                                    class="shadow-sm"
                                    style="width:140px;height:100px;object-fit:cover;border-radius:8px;border:1px solid #ddd;" />
                                }
                                else
                                {
                                    <div class="border rounded text-muted d-flex align-items-center justify-content-center"
                                    style="width:140px;height:100px;font-size:13px;">
                                        No Image
                                    </div>
                                }
                            </div>


                        </div>
                    </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                    @onclick="CloseCategoryModal">
                                Cancel
                            </button>

                            <button type="submit" class="btn btn-danger"
                                    disabled="@isProcessing">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Save
                            </button>
                        </div>
                    </EditForm>
                </div>
                
            </div>
        </div>
    </div>
}


@if (showDeleteModal)
{
    <div class=" modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5); backdrop-filter:blur(6px);animation: fadein 0.3s ease-out ">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content custom-modal-content">

                <div class="modal-header border-0">
                    <h5 class="modal-title">Confirm Delete !</h5>
                </div>

                <div class="modal-body">
                    <p>
                        <text>Are you sure you want to delete this category permanently?</text>
                    </p>

                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDeleteModal">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteConfirmed">Delete</button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public List<EventCategoryDto> Categories { get; set; } = new();

    // private List<EventCategoryDto> categories = new();


    private EventCategoryDto editingCategory = new();

    private bool showCategoryModal = false;
    IBrowserFile? selectedImageFile;
    string? imagePreviewUrl;
    private bool isProcessing = false;
    private bool showDeleteModal = false;
    int deleteCategoryId;
    string? imageError;

    protected override async Task OnInitializedAsync()
    {
        // spinnerService.Show();
        // await Task.Delay(200);
        Categories = await Http.GetFromJsonAsync<List<EventCategoryDto>>(
            "api/EventCategory"
        ) ?? new();
        // spinnerService.Hide();
    }

    // ================= UI ACTIONS =================

    void ShowAddCategoryModal()
    {
        editingCategory = new EventCategoryDto();
        showCategoryModal = true;
    }

    void EditCategory(EventCategoryDto category)
    {
        editingCategory = new EventCategoryDto
        {
            Id = category.Id,
            Name = category.Name,
            Slug = category.Slug,
            Description = category.Description,
            ImageUrl = category.ImageUrl
        };

        imagePreviewUrl = null; 
        selectedImageFile = null;

        showCategoryModal = true;
    }
    async Task SaveCategory()
    {
        if (editingCategory.Id == 0 && selectedImageFile == null)
        {
            imageError = "Image is required";
            return;
        }

        if (!string.IsNullOrEmpty(imageError))
            return;
        isProcessing = true;
        StateHasChanged();

        var content = new MultipartFormDataContent();

        content.Add(new StringContent(editingCategory.Name), "Name");
        content.Add(new StringContent(editingCategory.Description ?? ""), "Description");

        if (selectedImageFile != null)
        {
            var stream = selectedImageFile.OpenReadStream(2_000_000);
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType =
                new MediaTypeHeaderValue(selectedImageFile.ContentType);

            content.Add(fileContent, "ImageFile", selectedImageFile.Name);
        }

        HttpResponseMessage response = editingCategory.Id == 0
            ? await Http.PostAsync("api/EventCategory", content)
            : await Http.PutAsync($"api/EventCategory/{editingCategory.Id}", content);

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            Console.WriteLine(error);
            isProcessing = false;
            StateHasChanged();
            return;
        }

        Categories = await Http.GetFromJsonAsync<List<EventCategoryDto>>(
            "api/EventCategory"
        ) ?? new();

        CloseCategoryModal();
        isProcessing = false;
        StateHasChanged();
    }

    void CloseCategoryModal()
    {
        showCategoryModal = false;
        editingCategory = new EventCategoryDto();
        selectedImageFile = null;
        imagePreviewUrl = null;
    }
    private void OpenDeleteModal (int id)
    {
        deleteCategoryId = id;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
    }
    private async Task DeleteConfirmed()
    {
        spinnerService.Show();

        try
        {
            await DeleteCategory(deleteCategoryId);
            showDeleteModal = false;
        }
        finally
        {
            spinnerService.Hide();
        }
    }
    async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        imageError = null;
        selectedImageFile = e.File;

        if (selectedImageFile == null)
            return;

        var allowedTypes = new[] { "image/jpeg", "image/png" };

        if (!allowedTypes.Contains(selectedImageFile.ContentType))
        {
            imageError = "Only JPG and PNG images are allowed";
            selectedImageFile = null;
            return;
        }

        if (selectedImageFile.Size > 2_000_000)
        {
            imageError = "Image size must be less than 2MB";
            selectedImageFile = null;
            return;
        }

        using var stream = selectedImageFile.OpenReadStream(2_000_000);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        imagePreviewUrl =
            $"data:{selectedImageFile.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }


    string GetImageUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return "";

        if (url.StartsWith("http"))
            return url;

        return $"{Http.BaseAddress}{url.TrimStart('/')}";
    }



    async Task DeleteCategory(int id)
    {
        await Http.DeleteAsync($"api/EventCategory/{id}");

        Categories = await Http.GetFromJsonAsync<List<EventCategoryDto>>(
            "api/EventCategory"
        ) ?? new();
    }

}
