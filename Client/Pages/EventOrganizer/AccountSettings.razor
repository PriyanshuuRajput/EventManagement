@page "/account-settings"
@attribute [Authorize(Roles="Manager")]

@using System.Net.Http.Headers
@using EventBooking.Client.Components.Profile
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@if (profile == null)
{
    <div class="d-flex justify-content-center align-items-center mt-5">
        <div class="spinner-border text-danger"></div>
    </div>
}
else
{
    <ProfileEdit Model="@model" OnSubmit="SaveProfile"/>
}

@code {
    private ManagerAccountDto model = new();
    private ManagerProfileDto? profile;

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

        if (string.IsNullOrWhiteSpace(token))
        {
            Nav.NavigateTo("/login");
            return;
        }

        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", token);

        profile = await Http.GetFromJsonAsync<ManagerProfileDto>(
            "api/ManagerEvent/profile");

        if (profile != null)
        {
            model = new ManagerAccountDto
            {
                Name = profile.ManagerName,
                Mobile = profile.Mobile,
                Address = profile.Address,
                Image = profile.Image
            };
        }
    }

    private async Task SaveProfile(ManagerAccountDto data)
    {
        await Http.PostAsJsonAsync(
            "api/ManagerEvent/manager-changepassword/accountSettings",
            new ManagerProfileDto
            {
                ManagerName = data.Name,
                Mobile = data.Mobile,
                Address = data.Address,
                Image = data.Image,
                OldPassword = data.OldPassword,
                NewPassword = data.NewPassword,
                ConfirmPassword = data.ConfirmPassword
            });
    }
}
