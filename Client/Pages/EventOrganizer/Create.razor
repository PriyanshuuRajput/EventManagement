@page "/manager-create"
@inject HttpClient Http
@inject NavigationManager Nav

<h3 class="text-danger fw-bold mb-4">
    <i class="bi bi-calendar-plus me-2"></i> Create New Event
</h3>

@if (isSubmitting)
{
    <div class="text-center">
        <div class="spinner-border text-danger" role="status">
            <span class="visually-hidden">Submitting...</span>
        </div>
        <p class="mt-2 text-muted">Submitting event, please wait...</p>
    </div>
}
else
{
    <EditForm Model="@eventModel" OnValidSubmit="@HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- Title -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Event Title</label>
            <InputText class="form-control" @bind-Value="eventModel.Title" />
        </div>

        <!-- Event Type -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Event Type</label>
            <InputText class="form-control" @bind-Value="eventModel.EventType" />
        </div>

        <!-- Description -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Description</label>
            <InputTextArea class="form-control" @bind-Value="eventModel.Description" rows="3" />
        </div>

        <!-- Genre -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Genre</label>
            <InputText class="form-control" @bind-Value="eventModel.Genre" />
        </div>

        <!-- Language -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Language</label>
            <InputText class="form-control" @bind-Value="eventModel.Language" />
        </div>

        <!-- Duration -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Duration (hours)</label>
            <InputNumber class="form-control" @bind-Value="durationHours" />
        </div>

        <!-- Show Date -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Event Date & Time</label>
            <InputDate class="form-control" @bind-Value="eventModel.ShowDate" />
        </div>

        <!-- Venue -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Venue</label>
            <InputNumber class="form-control" @bind-Value="eventModel.VenueId" />
            <div class="form-text text-muted">Enter Venue ID for now (will replace with dropdown)</div>
        </div>

        <!-- Ticket Price -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Ticket Price</label>
            <InputNumber class="form-control" @bind-Value="eventModel.TicketPrice" />
        </div>

        <!-- Image -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Image URL</label>
            <InputText class="form-control" @bind-Value="eventModel.ImageUrl" />
        </div>

        <button type="submit" class="btn btn-danger w-100 mt-3 fw-semibold">
            <i class="bi bi-cloud-upload me-2"></i> Submit Event for Approval
        </button>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success mt-3">@successMessage</div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3">@errorMessage</div>
        }
    </EditForm>
}

@code {
    private EventDto eventModel = new();
    private bool isSubmitting = false;
    private string? successMessage;
    private string? errorMessage;
    private int durationHours = 1;

    private async Task HandleSubmit()
    {
        try
        {
            isSubmitting = true;
            successMessage = errorMessage = null;
            eventModel.Duration = TimeSpan.FromHours(durationHours);

            var response = await Http.PostAsJsonAsync("https://localhost:7239/api/ManagerEvent/create", eventModel);

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Event submitted successfully! Awaiting admin approval.";
                await Task.Delay(1500);
                Nav.NavigateTo("/events");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to submit event: {error}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
