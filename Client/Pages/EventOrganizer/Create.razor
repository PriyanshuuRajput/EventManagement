@page "/create"

<h3>Organizer</h3>


<EditForm Model="_eventDto" OnValidSubmit="SubmitEvent">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>Title</label>
        <InputText @bind-Value="_eventDto.Title" class="form-control" />
    </div>
    <div class="form-group">
        <label>Event Type</label>
        <InputText @bind-Value="_eventDto.EventType" class="form-control" />
    </div>

    <div class="form-group">
        <label>Description</label>
        <InputTextArea @bind-Value="_eventDto.Description" class="form-control" />
    </div>

    <div class="form-group">
        <label>Genre</label>
        <InputText @bind-Value="_eventDto.Genre" class="form-control" />
    </div>

    <div class="form-group">
        <label>Language</label>
        <InputText @bind-Value="_eventDto.Language" class="form-control" />
    </div>

    <div class="form-group">
        <label>Duration (hh:mm:ss)</label>
        <InputText @bind-Value="_durationString" class="form-control" />
    </div>

    <div class="form-group">
        <label>Show Date</label>
        <InputDate @bind-Value="_eventDto.ShowDate" class="form-control" />
    </div>
    <div class="form-group">
        <label>Venue Name</label>
        <InputText @bind-Value="_eventDto.VenueName" class="form-control" />
    </div>

    <div class="form-group">
        <label>City Name</label>
        <InputText @bind-Value="_eventDto.CityName" class="form-control" />
    </div>

    <div class="form-group">
        <label>Ticket Price</label>
        <InputNumber @bind-Value="_eventDto.TicketPrice" class="form-control" />
    </div>

    <div class="form-group">
        <label>Event Image</label>
        <InputFile OnChange="OnFileSelected" />
    </div>

    @if (!string.IsNullOrEmpty(_imagePreview))
    {
    <p>Image Preview:</p>
    <img src="@_imagePreview" style="max-width:300px;" />
    }

    <button type="submit" class="btn btn-primary mt-2">Submit Event</button>
</EditForm>

@if(!string.IsNullOrEmpty(_statusMessage))
{
    <div class="alert alert-info mt-2">@_statusMessage</div>
}

@code {

    private EventDto _eventDto = new EventDto();
    private IBrowserFile? _selectedFile;
    private string? _imagePreview;
    private string? _statusMessage;
    private string _durationString = "30:00";

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        var format = "image/png"; // you can handle multiple types

        using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        var buffer = new byte[_selectedFile.Size];
        stream.Read(buffer, 0, buffer.Length);
        _imagePreview = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
    }

    private async Task SubmitEvent()
    {
        // Parse duration string to TimeSpan
        if (TimeSpan.TryParse(_durationString, out var duration))
        {
            _eventDto.Duration = duration;
        }
        else
        {
            _statusMessage = "Invalid duration format.";
            return;
        }

        var content = new MultipartFormDataContent();

        content.Add(new StringContent(_eventDto.Title), "Title");
        content.Add(new StringContent(_eventDto.EventType), "EventType");
        content.Add(new StringContent(_eventDto.Description ?? ""), "Description");
        content.Add(new StringContent(_eventDto.Genre ?? ""), "Genre");
        content.Add(new StringContent(_eventDto.Language ?? ""), "Language");
        content.Add(new StringContent(_eventDto.Duration.ToString()), "Duration");
        content.Add(new StringContent(_eventDto.VenueName ?? ""), "VenueName");
        content.Add(new StringContent(_eventDto.CityName ?? ""), "CityName");
        content.Add(new StringContent(_eventDto.TicketPrice.ToString()), "TicketPrice");

        if (_selectedFile != null)
        {
            var stream = _selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            content.Add(new StreamContent(stream), "ImageFile", _selectedFile.Name);
        }

        try
        {
            var response = await Http.PostAsync("https://localhost:7239/api/Events/create", content);
            if (response.IsSuccessStatusCode)
            {
                _statusMessage = "Event submitted successfully!";
                var createdEvent = await response.Content.ReadFromJsonAsync<EventDto>();
                if (createdEvent != null)
                {
                    _imagePreview = createdEvent.ImageUrl;
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _statusMessage = $"Error: {error}";
            }
        }
        catch (Exception ex)
        {
            _statusMessage = $"Exception: {ex.Message}";
        }
    }


}
