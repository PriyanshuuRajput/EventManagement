@if (currentStep == 1)
{

    <EditForm Model="@model">
        <DataAnnotationsValidator />

        <div class="step-section d-flex justify-content-center mt-2">
            <div class="form-card">

                <div class="row">
                    <div class="col-md-6 mb-3 float-input">
                        <InputText class="pretty-input" placeholder="" @bind-Value="model.FirstName" />
                        <label>First Name <span class="text-danger">*</span></label>
                        <ValidationMessage For="@(()=>model.FirstName)" class="text-danger small" />
                    </div>

                    <div class="col-6 mb-3 float-input">
                        <InputText class="pretty-input" placeholder=""@bind-Value="model.LastName" />
                        <label>Last Name</label>
                        @*<ValidationMessage For="@(()=>model.LastName)" />*@
                    </div>

                    <div class="col-12 mb-3 float-input">
                        <InputText class="pretty-input" placeholder="" maxlength="10" @bind-Value="model.Mobile" />
                        <label>Mobile Number <span class="text-danger">*</span></label>
                        <ValidationMessage For="@(()=>model.Mobile)" class="text-danger small" />
                    </div>
                </div>

                <div class="section-title mt-2 text-secondary">Update Password</div>

                <div class="row">
                    <div class="col-12 mb-3 float-input">
                        <InputText type="password" class="pretty-input" placeholder="" @bind-Value="model.OldPassword" />
                        <label>Old Password <span class="text-danger">*</span></label>
                        <ValidationMessage For="@(()=>model.OldPassword)" class="text-danger samll" />

                    </div>

                    <div class="col-md-6 mb-3 float-input">
                        <InputText type="password" class="pretty-input" placeholder="" @bind-Value="model.NewPassword" />
                        <label >New Password <span class="text-danger">*</span></label>
                        <ValidationMessage For="@(()=>model.NewPassword)" class="text-danger small" />
                    </div>

                    <div class="col-md-6 mb-3 float-input">
                        <InputText type="password" class="pretty-input" placeholder="" @bind-Value="model.ConfirmPassword" />
                        <label>Confirm Password <span class="text-danger">*</span></label>
                        <ValidationMessage For="@(()=>model.ConfirmPassword)" class="text-danger small" />
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-2">
                    <button class="btn btn-outline-danger px-4" @onclick="NextStep">Next</button>
                    @*<button type="button" class="btn btn-outline-danger px-4" @onclick="NextStep">Next</button>*@

                </div>

            </div>
        </div>
    </EditForm>
}


@if (currentStep == 2)
{

    <EditForm Model="@model">
        <DataAnnotationsValidator />

        <div class="step-section d-flex justify-content-center mt-2">
            <div class="form-card">
                <div class="row">

                    <!-- LEFT COLUMN -->
                    <div class="col-md-6 ">

                        <!-- Organization Name -->
                        <div class="mb-3 float-input">
                            <InputText class="pretty-input" placeholder="" @bind-Value="model.OrganizationName" />
                            <label>Organization Name</label>
                        </div>

                        <!-- PAN -->
                        <div class="mb-3 float-input">
                            <InputText class="pretty-input" placeholder="" @bind-Value="model.PAN" />
                            <label>Pan number</label>
                            <ValidationMessage For="@(()=>model.PAN)" class="text-danger small" />

                        </div>

                        <!-- Alternate Email -->
                        <div class="mb-3 float-input">
                            <InputText class="pretty-input" placeholder=""@bind-Value="model.AlternateEmail" />
                            <label>Alternate email</label>
                            @*<ValidationMessage For="@(() => model.AlternateEmail)" />*@
                        </div>

                        <!-- Profile Image-->
                        <div class="mb-3">
                            <label class="form-label">Profile Image (optional)</label>
                            <InputFile OnChange="HandleImageUpload" class="form-control" />

                            @if (!string.IsNullOrWhiteSpace(uploadError))
                            {
                                <div class="text-danger mt-1">@uploadError</div>
                            }

                            @if (!string.IsNullOrEmpty(model.Image))
                            {
                                <div class="mt-2">
                                    <img src="@model.Image" alt="Profile Image"
                                         style="height:80px;width:120px;object-fit:cover;border-radius:0;border:2px solid #ddd;" />

                                    <button class="btn btn-sm btn-danger mt-2" style=" margin-left: 30px"
                                            @onclick="RemoveImage">
                                        Remove Image
                                    </button>
                                </div>
                            }

                        </div>

                    </div>

                    <!-- RIGHT COLUMN -->
                    <div class="col-md-6">

                        <!-- Country -->
                        <div class="mb-3">
                           
                            <div class="dropdown-container">
                                <label class="form-label">Country <span class="text-danger">*</span></label>
                                <select class="form-control bms-input"
                                        @onclick="ToggleCountryDropdown"
                                        @onblur="CloseCountryDropdown"
                                        @onchange="OnCountryChanged">

                                    <option value="@Guid.Empty">-- Select Country --</option>
                                    @foreach (var c in countries)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                                

                                <span class="dropdown-arrow">
                                    <i class="bi @(isCountryOpen ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                </span>

                                <ValidationMessage For="@(() => model.CountryId)" class="text-danger small" />

                            </div>
                        </div>


                        <!-- State -->
                        <div class="mb-3">
                            
                            <div class="dropdown-container">
                                <label class="form-label">State <span class="text-danger">*</span></label>
                                <select class="form-control bms-input"
                                        @onclick="ToggleStateDropdown"
                                        @onblur="CloseStateDropdown"
                                        @bind="model.StateId">

                                    <option value="@Guid.Empty">-- Select State --</option>
                                    @foreach (var s in states)
                                    {
                                        <option value="@s.Id">@s.Name</option>
                                    }
                                </select>
                                <span class="dropdown-arrow">
                                    <i class="bi @(isStateOpen ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                </span>
                            </div>

                            <ValidationMessage For="@(() => model.StateId)" class="text-danger small " />


                        </div>


                        <!-- Address -->
                        <div class="mb-3 float-input">
                            <InputText class="pretty-input" placeholder="" @bind-Value="model.Address" />
                            <label class="form-label">Address <span class="text-danger">*</span></label>
                            <ValidationMessage For="@(() => model.Address)" class="text-danger small" />

                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button class="btn btn-secondary" @onclick="PrevStep">Back</button>
                    <button class="btn btn-outline-danger px-4" @onclick="NextStep">Next</button>

                    @*<button type="button" class="btn btn-secondary" @onclick="PrevStep">Back</button>
                        <button type="button" class="btn btn-outline-danger px-4" @onclick="NextStep">Next</button>*@

                </div>

            </div>
        </div>
    </EditForm>
}




@if (currentStep == 3)
{

    <EditForm Model="@model">
        <DataAnnotationsValidator />

        <div class="step-section d-flex justify-content-center mt-2">
            <div class="form-card">

                <div class="row align-items-start mb-4 mt-4">

                    <!-- LEFT: IMAGE -->
                    <div class="col-3 text-start p-0">
                        @if (!string.IsNullOrEmpty(model.Image))
                        {
                            <img src="@model.Image"
                                 alt="Profile Image"
                                 style="height:230px;width:170px;object-fit:cover;border-radius:8px;border:3px solid #ddd;" />
                        }
                        else
                        {
                            <div class="text-muted small mt-4">No profile image</div>
                        }
                    </div>

                    <!-- RIGHT: DETAILS -->
                    <div class="col-8">
                        <div class="list-group-item border-0 px-0 py-2">
                            <span class="fw-semibold">Name:</span> @model.ManagerName
                        </div>
                        <div class="list-group-item border-0 px-0 py-2">
                            <span class="fw-semibold">Mobile:</span> @model.Mobile
                        </div>
                        <div class="list-group-item border-0 px-0 py-2">
                            <span class="fw-semibold">Alternate email:</span> @model.AlternateEmail
                        </div>
                        <div class="list-group-item border-0 px-0 py-2">
                            <span class="fw-semibold">PAN:</span> @model.PAN
                        </div>
                        <div class="list-group-item border-0 px-0 py-2">
                            <span class="fw-semibold">Organization:</span> @model.OrganizationName
                        </div>
                        <div class="list-group-item border-0 px-0 py-2">
                            <span class="fw-semibold">Address:</span> @model.Address
                        </div>
                    </div>
                </div>

                <!-- Terms -->
                <div class="form-check mb-4">
                    <InputCheckbox class="form-check-input" @bind-Value="model.AcceptTerms" />
                    <label class="form-check-label ms-2">
                        I have reviewed all information.
                    </label>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-4">
                <button type="button" class="btn btn-secondary" @onclick="PrevStep">Back</button>
                <button type="submit" class="btn btn-danger px-4"
                        @onclick="Submit"
                        disabled="@(!model.AcceptTerms || isSubmitting)">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Submitting...</span>
                    }
                    else
                    {
                        <span>Submit</span>
                    }
                </button>
                </div>
            </div>

        </div>

    </EditForm>
        }





