@page "/manager-profile-change-password"
@layout MainLayout
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@using Applications.Dto.OrganizerDto
@using System.Net.Http.Headers
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Roles="Manager,Admin")]


<style>

    html, body {
        overflow: hidden !important;
    }

    body {
        background: radial-gradient( circle at top, rgba(220, 53, 69, 0.08), rgba(255, 255, 255, 0.9) 40% ), linear-gradient( 180deg, #f9fafb 0%, #f1f3f5 100% );
    }
    .modern-stepper {
        display: flex;
        justify-content: space-between;
        position: relative;
        align-items:flex-start;
    }

    .stepper-line {
        position: absolute;
        top: 22px;
        left: 0;
        right: 0;
        height: 3px;
        background: #c5aaad;
        z-index: 1;
        border-radius: 3px;
    }

    .stepper-line-active {
        position: absolute;
        top: 22px;
        left: 0;
        height: 3px;
        background: #f44a5a;
        z-index: 2;
        transition: width .35s ease;
        border-radius: 3px;
    }

    .stepper-item {
        flex: 1; 
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        text-align: center;
        z-index: 3;
    }

    .step-dot {
        height: 42px;
        width: 42px;
        border-radius: 50%;
        background: #ffffff;
        border: 3px solid #d9d5e7;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: 600;
        font-size: 0.95rem;
        color: #DC3545;
        margin: auto;
        transition: all .3s ease;
    }

        .step-dot.active {
            background: #DC3545;
            border-color: #DC3545;
            color: #fff;
        }

    .step-label {
        margin-top: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        line-height: 1.2;
        max-width: 120px;
    }

    .form-card {
        width: 100%;
        max-width: 860px;
        background: #ffffff;
        padding: 28px 32px;
        box-shadow: 0px 12px 32px rgba(0,0,0,0.08);
        margin: auto;
        border-radius:6px
    }
    .float-input {
        position: relative;
    }

        .flaot-input input,
        .float-input select {
            width: 100%;
            height: 48px;
            padding: 14px 14px 4px 14px;
            font-size: 0.95rem;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            background: #fff;
            box-shadow: 0 6px 18px rgba(0,0,0,0.06);
            transition: all .25s ease;
        }

            .dashboard-input input:focus,
            .dashboard-input select:focus {
                border-color: #dc3545;
                box-shadow: 0 0 0 3px rgba(220,53,69,0.15), 0 8px 22px rgba(0,0,0,0.08);
                outline: none;
            }

        /* FLOATING LABEL */
        .float-input label {
            position: absolute;
            top: 50%;
            left: 14px;
            color: #6b7280;
            font-size: 0.9rem;
            pointer-events: none;
            transform: translateY(-50%);
            transition: all .2s ease;
            background: white;
            padding: 0 8px;
        }

        .float-input input:focus + label,
        .float-input input:not(:placeholder-shown) + label,
        .float-input select:focus + label,
        .float-input select:not([value=""]) + label {
            top: 0;
            transform: translateY(-12px);
            color: #dc3545;
        }


    .pretty-input {
        width: 100%;
        height: 44px;
        border: 1px solid #dcdcdc;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 0.95rem;
        transition: 0.2s ease-in-out;
    }

        .pretty-input:focus {
            border-color: #ff4d4f;
            box-shadow: 0 0 0 3px rgba(255,77,79,0.15);
            outline: none;
        }

    .section-title {
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 10px;
    }

    .dropdown-container {
        position: relative;
    }

    .dropdown-arrow {
        position: absolute;
        right: 15px;
        top: 70%;
        transform: translateY(-50%);
        pointer-events: none;
        font-size: 1rem;
        color: #555;
    }

    .bms-input {
        height: 38px;
        border-radius: 6px;
        font-size: 0.88rem;
        border: 1px solid #e2e4e7;
        background: #fff;
        transition: border-color .12s ease, box-shadow .12s ease;
    }

        .bms-input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
        }

    .disabled-input {
        background: #f8f9fa !important;
        color: #6b7280 !important;
    }


    .btn-next {
        background: #1f2937;
        color: white;
        padding: 6px 22px;
        border-radius: 6px;
        border: none;
        font-weight: 500;
        transition: background .15s ease;
    }

        .next-btn:hover,
        .btn-next:hover {
            background: #1f2937;
        }

    .help-text {
        font-size: 0.8rem;
        color: #6b7280;
    }

    .help-link {
        color: #2563eb;
        text-decoration: none;
    }

        .help-link:hover {
            text-decoration: underline;
        }
</style>





<div class="modern-stepper">

    <div class="stepper-line"></div>
    <div class="stepper-line-active" style="width:@GetLineWidth()"></div>

    <div class="stepper-item">
        <div class="step-dot @(currentStep == 1 ? "active" : "")">1</div>
        <div class="step-label">Basic Information</div>
    </div>

    <div class="stepper-item">
        <div class="step-dot @(currentStep == 2 ? "active" : "")">2</div>
        <div class="step-label">Manager Profile</div>
    </div>

    <div class="stepper-item">
        <div class="step-dot @(currentStep == 3 ? "active" : "")">3</div>
        <div class="step-label">Review</div>
    </div>

</div>

