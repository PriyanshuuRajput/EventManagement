        private async Task NextStep()
        {
            bool valid = currentStep switch
            {
                1 => ValidateStep1(),
                2 => ValidateStep2(),
                _ => true
            };

            if (!valid) return;

            if (currentStep == 1)
                model.ManagerName = $"{model.FirstName} {model.LastName}";

            if (currentStep == 2)
            {
                var st = states.FirstOrDefault(s => s.Id == model.StateId)?.Name;
                var cn = countries.FirstOrDefault(c => c.Id == model.CountryId)?.Name;
                model.Address = $"{model.Address} {st} {cn}";
            }

            currentStep++;
            await Task.CompletedTask;
        }

