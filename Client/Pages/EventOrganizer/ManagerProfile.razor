@page "/manager-profile"
@inject NavigationManager Nav



    <div class="container-fluid py-4">

        <!-- PAGE HEADER -->
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h2 class="fw-bold">Event Manager</h2>
                <span class="text-muted">Manage your events and track performance</span>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-outline-danger" @onclick="CreateEvent">
                    <i class="bi bi-plus-lg me-1"></i> Create Event
                </button>
            </div>
        </div>
        <!-- SUMMARY CARDS -->
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm p-3 border-0 rounded-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box bg-secondary bg-opacity-10 text-danger rounded-3 p-3">
                            <i class="bi bi-calendar-event" style="font-size: 1.5rem;"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0">Total Events</h6>
                            <h3 class="fw-bold">6</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm p-3 border-0 rounded-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box bg-secondary bg-opacity-10 text-danger rounded-3 p-3">
                            <i class="bi bi-ticket-perforated" style="font-size: 1.5rem;"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0">Tickets Sold</h6>
                            <h3 class="fw-bold">0</h3>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm p-3 border-0 rounded-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-box bg-secondary bg-opacity-10 text-danger rounded-3 p-3">
                            <i class="bi bi-currency-dollar" style="font-size: 1.5rem;"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0">Total Revenue</h6>
                            <h3 class="fw-bold">$0</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- SEARCH BAR -->
        <div class="mb-3">
            <div class="input-group shadow-sm" style="max-width: 500px;">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search"></i>
                </span>
                <input class="form-control border-start-0" placeholder="Search events by name, venue, location, or category..." />
            </div>
        </div>


        <!-- FILTER BUTTONS -->
        <div class="d-flex align-items-center gap-3 mb-3">
            <span class="fw-semibold text-muted">Status:</span>

            <button class="btn btn-primary btn-sm rounded-pill px-3">All Events</button>
            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3">Active</button>
            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3">Past</button>
            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3">Sold Out</button>
        </div>


        <!-- TABLE HEADER -->
        <p class="text-muted">Showing 6 of 6 events</p>

        <!-- EVENT LIST ITEM (ONE ROW) -->
        <div class="card shadow-sm rounded-4 border-0 p-3 mb-3">
            <div class="d-flex gap-3">
                <img src="https://picsum.photos/100/80" class="rounded-3" style="width: 100px; height: 80px; object-fit: cover;" />

                <div class="flex-grow-1">
                    <h6 class="fw-bold mb-1">Summer Music Festival 2024</h6>
                    <small class="text-muted">Music</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-eye text-primary" style="cursor:pointer;"></i>
                    <i class="bi bi-pencil text-warning" style="cursor:pointer;"></i>
                    <i class="bi bi-trash text-danger" style="cursor:pointer;"></i>
                </div>
            </div>
        </div>

    </div>
    @code
    {
        private void CreateEvent  ()
        {
            Nav.NavigateTo("/manage-events");
        }
    }

