        background: #c5aaad;
        z-index: 1;
        border-radius: 3px;
    }

    .stepper-line-active {
        position: absolute;
        top: 22px;
        left: 0;
        height: 3px;
        background: #f44a5a;
        z-index: 2;
        transition: width .35s ease;
        border-radius: 3px;
    }

    .stepper-item {
        width: 33%;
        text-align: center;
        z-index: 3;
    }

    .step-dot {
        height: 42px;
        width: 42px;
        border-radius: 50%;
        background: #ffffff;
        border: 3px solid #d9d5e7;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: 600;
        font-size: 0.95rem;
        color: #DC3545;
        margin: auto;
        transition: all .3s ease;
    }

        .step-dot.active {
            background: #DC3545;
            border-color: #DC3545;
            color: #fff;
        }

    .step-label {
        /*        margin-top: 10px;*/
        font-size: 0.85rem;
        font-weight: 600;
        color: #3b3a3f;
    }

    .step-section {
        /*        height: calc(100vh - 100px);*/
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden !important;
        padding: 0;
    }

    .form-card {
        width: 580px;
        background: #ffffff;
        padding: 26px 30px;
        box-shadow: 0px 8px 20px rgba(0,0,0,0.06);
        margin: auto;
        /*        max-height: 85vh;
        overflow-y: auto;
        border-radius: 14px;*/
    }

        .form-card .mb-3 {
            margin-bottom: 12px !important;
        }

        .form-card .section-title {
            margin: 12px 0 8px !important;
        }


    .form-label {
        font-size: 0.9rem;
        margin-bottom: 4px;
    }

    .pretty-input {
        width: 100%;
        height: 44px;
        border: 1px solid #dcdcdc;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 0.95rem;
        transition: 0.2s ease-in-out;
    }

        .pretty-input:focus {
            border-color: #ff4d4f;
            box-shadow: 0 0 0 3px rgba(255,77,79,0.15);
            outline: none;
        }

    .section-title {
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 10px;
    }

    .dropdown-container {
        position: relative;
    }

    .dropdown-arrow {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
        font-size: 1rem;
        color: #555;
    }




    .bms-input {
        height: 38px;
        border-radius: 6px;
        font-size: 0.88rem;
        border: 1px solid #e2e4e7;
        background: #fff;
        transition: border-color .12s ease, box-shadow .12s ease;
    }

        .bms-input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
        }

    .disabled-input {
        background: #f8f9fa !important;
        color: #6b7280 !important;
    }


    .btn-next {
        background: #1f2937;
        color: white;
        padding: 6px 22px;
        border-radius: 6px;
        border: none;
        font-weight: 500;
        transition: background .15s ease;
    }

        .next-btn:hover,
        .btn-next:hover {
            background: #1f2937;
        }

    .help-text {
        font-size: 0.8rem;
        color: #6b7280;
    }

    .help-link {
        color: #2563eb;
        text-decoration: none;
    }

        .help-link:hover {
            text-decoration: underline;
        }
</style>





<div class="modern-stepper">

    <div class="stepper-line"></div>
    <div class="stepper-line-active" style="width:@GetLineWidth()"></div>

    <div class="stepper-item">
        <div class="step-dot @(currentStep == 1 ? "active" : "")">1</div>
        <div class="step-label">Basic Information</div>
    </div>

    <div class="stepper-item">
        <div class="step-dot @(currentStep == 2 ? "active" : "")">2</div>
        <div class="step-label">Manager Profile</div>
    </div>

    <div class="stepper-item">
        <div class="step-dot @(currentStep == 3 ? "active" : "")">3</div>
        <div class="step-label">Review</div>
    </div>

</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>

}



<EditForm Model="@model" OnValidSubmit="Submit">
    <DataAnnotationsValidator />

    @if (currentStep == 1)
    {
        <div class="step-section d-flex justify-content-center">
            <div class="form-card">

                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label">First Name <span class="text-danger">*</span></label>
                        <InputText class="pretty-input" @bind-Value="model.FirstName" />
                        <ValidationMessage For="@(()=>model.FirstName)" />
                    </div>

                    <div class="col-6 mb-3">
                        <label class="form-label">Last Name</label>
                        <InputText class="pretty-input" @bind-Value="model.LastName" />
                        @*<ValidationMessage For="@(()=>model.LastName)" />*@
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label">Mobile Number <span class="text-danger">*</span></label>
                        <InputText class="pretty-input" maxlength="10" @bind-Value="model.Mobile" />
                        <ValidationMessage For="@(()=>model.Mobile)" />
                    </div>
                </div>

                <div class="section-title mt-2 text-secondary">Update Password</div>

                <div class="row">
                    <div class="col-12 mb-3">
                        <label class="form-label">Old Password <span class="text-danger">*</span></label>
                        <InputText type="password" class="pretty-input" @bind-Value="model.OldPassword" />
                        <ValidationMessage For="@(()=>model.OldPassword)" />

                    </div>

                    <div class="col-6 mb-3">
                        <label class="form-label">New Password <span class="text-danger">*</span></label>
                        <InputText type="password" class="pretty-input" @bind-Value="model.NewPassword" />
                        <ValidationMessage For="@(()=>model.NewPassword)" />
                    </div>

                    <div class="col-6 mb-3">
                        <label class="form-label">Confirm Password <span class="text-danger">*</span></label>
                        <InputText type="password" class="pretty-input" @bind-Value="model.ConfirmPassword" />
                        <ValidationMessage For="@(()=>model.ConfirmPassword)" />
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-2">
                    <button class="btn btn-outline-danger px-4" @onclick="NextStep">Next</button>
                </div>

            </div>
        </div>
    }


    @if (currentStep == 2)
    {
        <div class="step-section d-flex justify-content-center">
            <div class="form-card">
                <div class="row">

                    <!-- LEFT COLUMN -->
                    <div class="col-md-6">

                        <!-- Organization Name -->
                        <div class="mb-3">
                            <label class="form-label">Organization Name</label>
                            <InputText class="pretty-input" @bind-Value="model.OrganizationName" />
                        </div>

                        <!-- PAN -->
                        <div class="mb-3">
                            <label class="form-label">Pan number</label>
                            <InputText class="pretty-input" @bind-Value="model.PAN" />
                            <ValidationMessage For="@(()=>model.PAN)" />
                        </div>

                        <!-- Alternate Email -->
                        <div class="mb-3">
                            <label class="form-label">Alternate email</label>
                            <InputText class="pretty-input" @bind-Value="model.AlternateEmail" />
                            @*<ValidationMessage For="@(() => model.AlternateEmail)" />*@
                        </div>

                        <!-- Profile Image-->
                        <div class="mb-3">
                            <label class="form-label">Profile Image (optional)</label>
                            <InputFile OnChange="HandleImageUpload" class="form-control" />

                            @if (!string.IsNullOrWhiteSpace(uploadError))
                            {
                                <div class="text-danger mt-1">@uploadError</div>
                            }

                            @if (!string.IsNullOrEmpty(model.Image))
                            {
                                <div class="mt-2">
                                    <img src="@model.Image" alt="Profile Image"
                                         style="height:100px;width:100px;object-fit:cover;border-radius:0;border:2px solid #ddd;" />

                                    <button type="button"
                                            class="btn btn-sm btn-danger mt-2" style=" margin-left: 30px"
                                            @onclick="RemoveImage">
                                        Remove Image
                                    </button>
                                </div>
                            }
                        </div>

                    </div>

                    <!-- RIGHT COLUMN -->
                    <div class="col-md-6">

                        <!-- Country -->
                        <div class="mb-3 position-relative">
                            <label class="form-label">Country <span class="text-danger">*</span></label>
                            <div class="dropdown-container">
                                <select class="form-control bms-input"
                                        @onclick="ToggleCountryDropdown"
                                        @onblur="CloseCountryDropdown"
                                        @onchange="OnCountryChanged">

                                    <option value="@Guid.Empty">-- Select Country --</option>
                                    @foreach (var c in countries)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>

                                <span class="dropdown-arrow">
                                    <i class="bi @(isCountryOpen ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                </span>

                                <ValidationMessage For="@(() => model.CountryId)" />

                            </div>
                        </div>





                        <!-- State -->
                        <div class="mb-3 position-relative">
                            <label class="form-label">State <span class="text-danger">*</span></label>
                            <div class="dropdown-container">
                                <select class="form-control bms-input"
                                        @onclick="ToggleStateDropdown"
                                        @onblur="CloseStateDropdown"
                                        @bind="model.StateId">

                                    <option value="@Guid.Empty">-- Select State --</option>
                                    @foreach (var s in states)
                                    {
                                        <option value="@s.Id">@s.Name</option>
                                    }
                                </select>

                                <span class="dropdown-arrow">
                                    <i class="bi @(isStateOpen ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                </span>
                            </div>

                            <ValidationMessage For="@(() => model.StateId)" />


                        </div>


                        <!-- Address -->
                        <div class="mb-3">
                            <label class="form-label">Address <span class="text-danger">*</span></label>
                            <InputText class="pretty-input" @bind-Value="model.Address" />
                                <ValidationMessage For="@(() => model.Address)" />
                            
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button class="btn btn-secondary" @onclick="PrevStep">Back</button>
                    <button class="btn btn-outline-danger px-4" @onclick="NextStep">Next</button>
                </div>

            </div>
        </div>
    }




    @if (currentStep == 3)
    {
        <div class="step-section d-flex justify-content-center">
            <div class="form-card">

                @*<div class="d-flex align-items-start mb-3">
            <div class="step-circle">3</div>
            <div class="ms-2">
                <h6 class="step-title">Review and accept terms</h6>   b
                <p class="step-subtitle">Check your details before submitting.</p>
            </div>
        </div>*@

                <div class="list-group mb-3 ">
                    <div class="list-group-item"><span class="fw-semibold">Name:</span> @model.ManagerName</div>
                    <div class="list-group-item"><span class="fw-semibold">Mobile number:</span> @model.Mobile</div>
                    <div class="list-group-item"><span class="fw-semibold">Alternate email: </span>@model.AlternateEmail</div>
                    @*<div class="list-group-item"><span class="fw-semibold">Email:</span> @email</div>*@
                    <div class="list-group-item"><span class="fw-semibold">Pan number:</span> @model.PAN</div>
                    <div class="list-group-item"><span class="fw-semibold">Organization name:</span> @model.OrganizationName</div>
                    <div class="list-group-item"><span class="fw-semibold">Address: </span>@model.Address</div>
                    @*<div class="list-group-item"><b>State Name</b></div>
            <select class="form-control bms-input" @bind="model.CityId">
                <option value="">-- Select City --</option>
                @foreach (var c in cities)
                {
                    <option value="@c.Id">@c.CityName</option>
                }
            </select>
            <select class="form-control bms-input" @bind="model.StateId">
                <option value="">-- Select State --</option>
                @foreach (var s in states)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>*@

                </div>


                <div class="form-check mb-4">
                    <InputCheckbox class="form-check-input" @bind-Value="model.AcceptTerms" />
                    <label class="form-check-label ms-2">
                        I have reviewed all information.
                    </label>
                </div>


                <div class="d-flex justify-content-between">
                    <button class="btn btn-secondary" @onclick="PrevStep">Back</button>
                    <button class="btn btn-danger px-4"
                            @onclick="Submit"
                            disabled="@(model.AcceptTerms == false)">
                        Submit
                    </button>

                </div>

            </div>
        </div>
    }

</EditForm>



@code {
    ManagerProfileDto model = new();
    EditContext? editContext;
    ValidationMessageStore? message;
    string? errorMessage;
    string? email;
    bool isCountryOpen = false;
    bool isStateOpen = false;
    bool show = false;
    public bool AcceptTerms { get; set; }


    string? uploadError;

    int currentStep = 1;

    //List<CityDto> cities = new();
    List<StateDto> states = new();
    List<CountryDto> countries = new();

    private string GetLineWidth()
    {
        return currentStep switch
        {
            1 => "0%",
            2 => "50%",
            3 => "100%",
            _ => "0%"
        };
    }

    protected override async Task OnInitializedAsync()
    {
        email = await JS.InvokeAsync<string>("localStorage.getItem", "email");
        //model.Email = email;

        editContext = new EditContext(model);
        message = new ValidationMessageStore(editContext);
        countries = await Http.GetFromJsonAsync<List<CountryDto>>("api/countries");
        // cities = await Http.GetFromJsonAsync<List<CityDto>>("api/cities");

    }
    void ToggleCountryDropdown()
    {
        isCountryOpen = !isCountryOpen;
    }

    void CloseCountryDropdown()
    {
        isCountryOpen = false;
    }

    void ToggleStateDropdown()
    {
        isStateOpen = !isStateOpen;
    }

    void CloseStateDropdown()
    {
        isStateOpen = false;
    }

    private async Task OnCountryChanged(ChangeEventArgs e)
    {

        if (Guid.TryParse(e?.Value?.ToString(), out var gid))
        {
            model.CountryId = gid;
        }
        else
        {
            model.CountryId = Guid.Empty;
        }

        // load states for this country
        states = await Http.GetFromJsonAsync<List<StateDto>>($"api/State/by-country/{model.CountryId}");

        // reset state selection
        model.StateId = Guid.Empty;

        // ensure validation UI updates (clear country/state messages)
        var countryField = new FieldIdentifier(model, nameof(model.CountryId));
        var stateField = new FieldIdentifier(model, nameof(model.StateId));

        editContext?.NotifyValidationStateChanged();
    }



    private bool ValidateStep1()
    {
        errorMessage = null;


        if (string.IsNullOrWhiteSpace(model.FirstName) ||
            string.IsNullOrWhiteSpace(model.Mobile) ||
            string.IsNullOrWhiteSpace(model.OldPassword) ||
            string.IsNullOrWhiteSpace(model.NewPassword) ||
            string.IsNullOrWhiteSpace(model.ConfirmPassword))
        {
            errorMessage = "All required fields must be filled.";
            return false;
        }

        if (model.NewPassword.Length < 6)
        {
            errorMessage = "New password must be at least 6 characters long.";
            return false;
        }

        if (model.NewPassword != model.ConfirmPassword)
        {
            errorMessage = "New and confirm passwords do not match.";
            return false;
        }


        return true;
    }





    private bool ValidateStep2()
    {
        var results = new List<ValidationResult>();
        var context = new ValidationContext(model);

        // FIX: CLEAR OLD VALIDATIONS
        if (editContext != null)
        {
            var countryField = new FieldIdentifier(model, nameof(model.CountryId));
            var stateField = new FieldIdentifier(model, nameof(model.StateId));

            message?.Clear(countryField);
            message?.Clear(stateField);

            editContext.NotifyValidationStateChanged();
        }

        string[] props = {
        nameof(model.CountryId),
        nameof(model.StateId),
        nameof(model.Address)
    };

        return ValidateProperties(props, context, results);
    }


    private bool ValidateProperties(string[] properties, ValidationContext context, List<ValidationResult> results)
    {
        bool valid = true;

        foreach (var prop in properties)
        {
            context.MemberName = prop;
            var value = model.GetType().GetProperty(prop)?.GetValue(model);

            if (!Validator.TryValidateProperty(value, context, results))
            {
                valid = false;
            }
        }

        return valid;
    }

    private Task NextStep()
    {
        errorMessage = null;
        if (currentStep == 2)
            show = true;
        bool isValid = currentStep switch
        {
            1 => ValidateStep1(),
            2 => ValidateStep2(),
            _ => true
        };

        if (!isValid)
        {
            StateHasChanged();
            return Task.CompletedTask;
        }

        if (currentStep == 1)
        {
            model.ManagerName = $"{model.FirstName} {model.LastName}";
        }

        if (currentStep == 2)
        {
            var selectedState = states.FirstOrDefault(s => s.Id == model.StateId)?.Name;
            var selectedCountry = countries.FirstOrDefault(c => c.Id == model.CountryId)?.Name;

            model.Address = $"{model.Address} {selectedState} {selectedCountry}";
        }

        currentStep++;
        show = false;
        return Task.CompletedTask;
    }

    private Task PrevStep()
    {
        currentStep--;
        return Task.CompletedTask;
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        uploadError = null;
        var file = e.File;

        var allowedFormats = new[] { "image/jpeg", "image/png", "image/jpeg" };

        if (!allowedFormats.Contains(file.ContentType))
        {
            uploadError = "Only Jpeg or Png images are allowed.";

            return;
        }

        long maxSize = 2 * 1024 * 1024;
        if (file.Size > maxSize)
        {
            uploadError = "Image size must be less than 2 Mb.";
        }

        using var stream = file.OpenReadStream(maxAllowedSize: maxSize);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        var bytes = ms.ToArray();

        model.Image = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";



    }
    private void RemoveImage()
    {
        model.Image = null;
    }




    private async Task Submit()
    {
        errorMessage = null;

        try
        {
            string token = await SessionStorage.GetItemAsync<string>("authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                errorMessage = "Session expired. Please login again.";
                Nav.NavigateTo("/", true);
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.PostAsJsonAsync(
                "api/ManagerEvent/manager-changepassword-profilesetup",
                model
            );

            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/manager-profile", true);
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }


}
