@page "/manager-profile-change-password"
@layout ManagerLayout
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

@using Applications.Dto.OrganizerDto
@using System.Net.Http.Headers

<style>

  

    .modern-stepper {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin-bottom: 40px;
        padding: 10px 0;
    }

    .stepper-line {
        position: absolute;
        top: 22px;
        left: 0;
        right: 0;
        height: 3px;
        background: #c5aaad;
        z-index: 1;
        border-radius: 3px;
    }

    .stepper-line-active {
        position: absolute;
        top: 22px;
        left: 0;
        height: 3px;
        background: #f44a5a; 
        z-index: 2;
        transition: width .35s ease;
        border-radius: 3px;
    }

    .stepper-item {
        width: 33%;
        text-align: center;
        z-index: 3;
    }

    .step-dot {
        height: 42px;
        width: 42px;
        border-radius: 50%;
        background: #ffffff;
        border: 3px solid #d9d5e7;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: 600;
        font-size: 0.95rem;
        color: #DC3545;
        margin: auto;
        transition: all .3s ease;
    }

        .step-dot.active {
            background: #DC3545;
            border-color: #DC3545;
            color: #fff;
        }

    .step-label {
        margin-top: 10px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #3b3a3f;
    }

    

    .bms-input {
        height: 38px;
        border-radius: 6px;
        font-size: 0.88rem;
        border: 1px solid #e2e4e7;
        background: #fff;
        transition: border-color .12s ease, box-shadow .12s ease;
    }

        .bms-input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
        }

    .disabled-input {
        background: #f8f9fa !important;
        color: #6b7280 !important;
    }


    .btn-next {
        background: #1f2937;
        color: white;
        padding: 6px 22px;
        border-radius: 6px;
        border: none;
        font-weight: 500;
        transition: background .15s ease;
    }

        .next-btn:hover,
        .btn-next:hover {
            background: #1f2937;
        }

    .help-text {
        font-size: 0.8rem;
        color: #6b7280;
    }

    .help-link {
        color: #2563eb;
        text-decoration: none;
    }

        .help-link:hover {
            text-decoration: underline;
        }
</style>





    <div class="modern-stepper">

        <div class="stepper-line"></div>
        <div class="stepper-line-active" style="width:@GetLineWidth()"></div>

        <div class="stepper-item">
            <div class="step-dot @(currentStep == 1 ? "active" : "")">1</div>
            <div class="step-label">Basic Information</div>
        </div>

        <div class="stepper-item">
            <div class="step-dot @(currentStep == 2 ? "active" : "")">2</div>
            <div class="step-label">Manager Profile</div>
        </div>

        <div class="stepper-item">
            <div class="step-dot @(currentStep == 3 ? "active" : "")">3</div>
            <div class="step-label">Terms & Condition</div>
        </div>

    </div>



    <EditForm Model="@model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (currentStep == 1)
        {
            <div class="step-section">

                @*<div class="d-flex align-items-start mb-3">
                        <div class="step-circle">1</div>
                        <div class="ms-2">
                            <h6 class="step-title">Set up your manager account</h6>
                            <p class="step-subtitle">Fill basic details and update your password.</p>
                        </div>
                    </div>*@

                <div class="row">

                    <div class="col-12 mb-3">
                        <label class="bms-label">Full name <span class="text-danger">*</span></label>
                        <InputText class="form-control bms-input" @bind-Value="model.ManagerName" />
                    </div>

                    <div class="col-12 mb-3">
                        <label class="bms-label">Mobile number <span class="text-danger">*</span></label>
                        <InputText class="form-control bms-input" @bind-Value="model.Mobile" />
                    </div>

                    @*<div class="col-12 mb-3">
                            <label class="bms-label">Email</label>
                            <InputText class="form-control bms-input disabled-input"
                                       @bind-Value="model.Email"
                                       readonly />
                        </div>*@

                    <div class="col-12 mb-3">
                        <label class="bms-label">Old password <span class="text-danger">*</span></label>
                        <InputText type="password" class="form-control bms-input" @bind-Value="model.OldPassword" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="bms-label">New password <span class="text-danger">*</span></label>
                        <InputText type="password" class="form-control bms-input" @bind-Value="model.NewPassword" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="bms-label">Confirm password <span class="text-danger">*</span></label>
                        <InputText type="password" class="form-control bms-input" @bind-Value="model.ConfirmPassword" />
                    </div>

                </div>

                <div class="d-flex justify-content-between mt-4">
                    <span class="help-text">Need help? <a href="#" class="help-link">Contact us</a></span>
                    <button class="btn btn-outline-danger" @onclick="NextStep">Next</button>
                </div>

            </div>
        }

        @if (currentStep == 2)
        {
            <div class="step-section">

                <div class="row">

                    <!-- LEFT COLUMN -->
                    <div class="col-md-6">

                        <!-- Organization Name -->
                        <div class="mb-3">
                            <label class="bms-label">Organization name</label>
                            <InputText class="form-control bms-input" @bind-Value="model.OrganizationName" />
                        </div>

                        <!-- PAN -->
                        <div class="mb-3">
                            <label class="bms-label">Pan number</label>
                            <InputText class="form-control bms-input" @bind-Value="model.PAN" />
                        </div>

                        <!-- Alternate Email -->
                        <div class="mb-3">
                            <label class="bms-label">Alternate email</label>
                            <InputText class="form-control bms-input" @bind-Value="model.AlternateEmail" />
                        </div>

                        <!-- Address -->
                        <div class="mb-3">
                            <label class="bms-label">Address <span class="text-danger">*</span></label>
                            <InputText class="form-control bms-input" @bind-Value="model.Address" />
                        </div>

                    </div>


                    <!-- RIGHT COLUMN -->
                    <div class="col-md-6">

                        <!-- Profile Image Upload -->
                        <div class="mb-3">
                            <label class="bms-label">Profile Image (optional)</label>

                            <InputFile OnChange="HandleImageUpload" class="form-control" />

                            @if (!string.IsNullOrEmpty(model.Image))
                            {
                                <div class="mt-2">
                                    <img src="@model.Image" alt="Profile Image"
                                         style="height:120px;width:120px;object-fit:cover;border-radius:10px;border:1px solid #ddd;" />
                                </div>
                            }
                        </div>

                        <!-- City -->
                        <div class="mb-3">
                            <label class="bms-label">City <span class="text-danger">*</span></label>
                            <select class="form-control bms-input" @bind="model.CityId">
                                <option value="">-- Select City --</option>
                                @foreach (var c in cities)
                                {
                                    <option value="@c.Id">@c.CityName</option>
                                }
                            </select>
                        </div>

                        <!-- State -->
                        <div class="mb-3">
                            <label class="bms-label">State <span class="text-danger">*</span></label>
                            <select class="form-control bms-input" @bind="model.StateId">
                                <option value="">-- Select State --</option>
                                @foreach (var s in states)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>

                    </div>

                </div>


                <div class="d-flex justify-content-between mt-4">
                    <button class="btn btn-secondary" @onclick="PrevStep">Back</button>
                    <button class="btn btn-outline-danger" @onclick="NextStep">Next</button>
                </div>

            </div>
        }



        @if (currentStep == 3)
        {
            <div class="step-section">

                @*<div class="d-flex align-items-start mb-3">
                        <div class="step-circle">3</div>
                        <div class="ms-2">
                            <h6 class="step-title">Review and accept terms</h6>
                            <p class="step-subtitle">Check your details before submitting.</p>
                        </div>
                    </div>*@

                <div class="list-group mb-3 ">
                    <div class="list-group-item"><span class="fw-semibold">Name:</span> @model.ManagerName</div>
                    <div class="list-group-item"><span class="fw-semibold">Mobile number:</span> @model.Mobile</div>
                    <div class="list-group-item"><span class="fw-semibold">Alternate email: </span>@model.AlternateEmail</div>
                    @*<div class="list-group-item"><span class="fw-semibold">Email:</span> @email</div>*@
                    <div class="list-group-item"><span class="fw-semibold">Pan number:</span> @model.PAN</div>
                    <div class="list-group-item"><span class="fw-semibold">Organization name:</span> @model.OrganizationName</div>
                    <div class="list-group-item"><span class="fw-semibold">Address: </span>@model.Address</div>
                    @*<div class="list-group-item"><b>State Name</b></div>
                        <select class="form-control bms-input" @bind="model.CityId">
                            <option value="">-- Select City --</option>
                            @foreach (var c in cities)
                            {
                                <option value="@c.Id">@c.CityName</option>
                            }
                        </select>
                        <select class="form-control bms-input" @bind="model.StateId">
                            <option value="">-- Select State --</option>
                            @foreach (var s in states)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>*@

                </div>


                <div class="form-check mb-4">
                    @*<InputCheckbox class="form-check-input" @bind-Value="model.AcceptTerms" />*@
                    <label class="form-check-label">
                        I agree to the <a href="#" class="help-link">Terms & Conditions</a>.
                    </label>
                </div>

                <div class="d-flex justify-content-between">
                    <button class="btn btn-secondary" @onclick="PrevStep">Back</button>
                    <button class="btn btn-danger w-3" type="submit">Submit</button>
                </div>

            </div>
        }

    </EditForm>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">@errorMessage</div>
    }
@code {
    ManagerProfileDto model = new();
    string? errorMessage;
    string? email;

    int currentStep = 1;

    List<CityDto> cities = new();
    List<StateDto> states = new();

    List<CountryDto> countries = new();
    Guid selectedCountryId = Guid.Empty;

    private string GetLineWidth()
    {
        return currentStep switch
        {
            1 => "0%",
            2 => "50%",
            3 => "100%",
            _ => "0%"
        };
    }


    protected override async Task OnInitializedAsync()
    {
        email = await JS.InvokeAsync<string>("localStorage.getItem", "email");
        model.Email = email;

        countries = await Http.GetFromJsonAsync<List<CountryDto>>("api/countries");

        if (countries != null && countries.Any())
        {
            selectedCountryId = countries.First().Id; // GUID
        }

        cities = await Http.GetFromJsonAsync<List<CityDto>>("api/cities");


        if (selectedCountryId != Guid.Empty)
        {
            states = await Http.GetFromJsonAsync<List<StateDto>>(
                $"api/state/by-country/{selectedCountryId}"
            );
        }
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file != null)
        {
            // Convert image to Base64
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024); // 5MB
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            model.Image = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
        }
    }



    private Task NextStep()
    {
        currentStep++;
        return Task.CompletedTask;
    }

    private Task PrevStep()
    {
        currentStep--;
        return Task.CompletedTask;
    }

    private async Task Submit()
    {
        errorMessage = null;

        try
        {
            string token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            // Submit DTO
            var response = await Http.PostAsJsonAsync(
                "api/account/manager-changepassword-profilesetup", model);

            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/manager-dashboard");
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

}
