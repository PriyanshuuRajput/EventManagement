<!-- Offcanvas Dashboard -->
<div class="offcanvas offcanvas-end text-dark bg-light" tabindex="-1" id="dashboardOffcanvas">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title d-flex align-items-start text-dark">
            <i class="bi bi-person me-2"></i>@GetDashboardTitle()
        </h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body p-0">
        @if (userRole != null)
        {
            <ul class="nav flex-column mt-2">
                @foreach (var item in GetMenuItems(userRole))
                {
                    <li class="nav-item">
                        <NavLink class="nav-link text-dark px-3 py-2 d-flex align-items-center side-link"
                                 href="@item.Url"
                                 Match="NavLinkMatch.Prefix">
                            @if (!string.IsNullOrEmpty(item.Icon))
                            {
                                <i class="@item.Icon me-2"></i>
                            }
                            <span>@item.Label</span>
                        </NavLink>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="p-3 text-center">
                <a href="javascript:void(0)" class="btn btn-danger w-100"
                   @onclick="() => LoginOverlayService.ShowLogin()">
                    Sign In
                </a>
            </div>
        }
    </div>
</div>

@code {
    private string? userRole;
    private string? userName;
    private bool IsCheckout;
    private bool spinLogo;

    private string searchText = "";

    private string SearchText
    {
        get => searchText;
        set
        {
            searchText = value;
            _ = PerformSearch(); 
        }
    }
    private bool showSearchDropdown = false;
    private List<EventDto> allEvents = new();
    private List<EventDto> searchResults = new();
    private CancellationTokenSource? debounceCts;


    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        UpdateCheckoutState();
        //LoginOverlayService.OnShowLogin += ShowLoginOverlay;
        //LoginOverlayService.OnShowManagerSignup += ShowManagerSignup;
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        allEvents = await Http.GetFromJsonAsync<List<EventDto>>("api/Events/approved") ?? new();
        await LoadUserState();
    }

    private async Task LoadUserState()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            userRole = user.FindFirst(c => c.Type == ClaimTypes.Role)?.Value;
            userName = user.Identity.Name ?? "User";
        }
        else
        {
            userRole = null;
            userName = null;
        }

        StateHasChanged();
    }
    private void HandleSearchFocusOut(FocusEventArgs e)
    {
        showSearchDropdown = false;
        StateHasChanged();
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        await LoadUserState();
    }
    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            showSearchDropdown = false;
            searchResults.Clear();
            StateHasChanged();
            return;
        }

        debounceCts?.Cancel();
        debounceCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(300, debounceCts.Token);

            searchResults = allEvents
                .Where(x =>
                    (x.Title?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (x.CategoryName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
                )
                .Take(7)
                .ToList();

            showSearchDropdown = true;
            StateHasChanged();
        }
        catch { }
    }

    private async Task SpinLogo()
    {
        spinLogo = true;
        StateHasChanged();

        await Task.Delay(700); 

        spinLogo = false;
        Navigation.NavigateTo("/");
    }


    private void HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            showSearchDropdown = false;
            Navigation.NavigateTo($"/events?search={Uri.EscapeDataString(searchText)}");
        }
    }
    private void NavigateFromSearch(EventDto evt)
    {
        showSearchDropdown = false;
        Navigation.NavigateTo($"/book-event/{evt.Id}");
    }
    private void ClearSearch()
    {
        searchText = "";
        searchResults.Clear();
        showSearchDropdown = false;

        Navigation.NavigateTo(
            Navigation.Uri.Split('?')[0],
            replace: true
        );
    }



    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
        await JS.InvokeVoidAsync("localStorage.removeItem", "userRole");

        if (AuthStateProvider is CustomAuthStateProvider customProvider)
            customProvider.NotifyUserLogout();

        Navigation.NavigateTo("/");
    }

    private string GetDashboardLabel() => userRole switch
    {
        "Admin" => "Admin Dashboard",
        "Manager" => "Manager Dashboard",
        _ => "My Dashboard"
    };

    private string GetDashboardTitle() => userRole switch
    {
        "Admin" => "Admin Panel",
        "Manager" => "Manager Tools",
        _ => "User Dashboard"
    };

    private List<MenuItem> GetMenuItems(string role) => role switch
    {
        "Admin" => new()
    {
            new("Dashboard", "/admin-dashboard", "bi-speedometer2"),
            new("Manage Events", "/manage-events", "bi-pencil-square"),
            new("Bookings", "/admin-booking", "bi-ticket-detailed"),
            new("Payouts", "/admin-payouts", "bi-wallet2"),
            new("Settings", "/admin-setting", "bi-gear")
        },
        "Manager" => new()
    {
            new("My Events", "/organizer-events", "bi-card-checklist"),
            new("Create Event", "/organizer-create-event", "bi-plus-circle"),
            new("Bookings", "/manager-bookings", "bi-ticket"),
            new("Profile", "/manager-profile", "bi-person-gear")
        },
        "User" => new()
    {
            new("My Tickets", "/user-tickets", "bi-ticket"),
            new("Browse Events", "/events", "bi-calendar"),
            new("Profile", "/profile", "bi-person")
        },
        _ => new()
    };

    private record MenuItem(string Label, string Url, string Icon);

    void ManagerSignup()
    {
        LoginOverlayService.ShowManagerSignup();
    }

    void GoToEvents()
    {
        Navigation.NavigateTo("/events", true);
    }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCheckoutState();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateCheckoutState()
    {
        IsCheckout = Navigation.Uri.Contains("/checkout");
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
