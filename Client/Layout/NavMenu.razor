@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

<style>

    /* Sticky category bar */
    /*.sticky-nav 
    {
        position: sticky;
        top: 60px; 
        z-index: 999;
        background: #f8f9fa;
    }*/
    .nav-logo {
        transition: transform .3s ease, filter .3s ease;
    }

        /* Nav item styles */
        .sticky-nav .nav-link 
        {
            position: relative;
            padding: 12px 18px;
            font-weight: 500;
            color: #444;
            transition: color .3s ease;
        }

            /* Hover color */
            .sticky-nav .nav-link:hover 
            {
                color: #dc3545;
            }

            /* Underline (hidden by default) */
            .sticky-nav .nav-link::after 
            {
                content: '';
                position: absolute;
                bottom: 0px;
                left: 50%;
                width: 0%;
                height: 3px;
                background-color: #dc3545;
                transition: all .3s ease;
                transform: translateX(-50%);
                border-radius: 10px;
            }

            /* Show underline on hover */
            .sticky-nav .nav-link:hover::after 
            {
                width: 80%;
            }

            /* Active underline ALWAYS visible */
            .sticky-nav .nav-link.active 
            {
                color: #dc3545 !important;
            }

                .sticky-nav .nav-link.active::after 
                {
                    width: 80%;
                }
    .dashboard-btn {
        position: relative;
        border: 1px solid rgba(255, 255, 255, 0.4);
        color: #f8f9fa;
        border-radius: 50%;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        background-color: transparent;
    }
    /* Hover: Glow + Scale */
    .dashboard-btn:hover {
        background-color: var(--bs-secondary);
        border-color: var(--bs-secondary);
        color: #fff;
        transform: scale(1.05);
        box-shadow: 0 0 10px rgba(108, 117, 125, 0.6);
    }

    /* Active (click) */
    .dashboard-btn:active {
        transform: scale(0.95);
        box-shadow: 0 0 5px rgba(13,110,253,0.8) inset;
    }

    /* Icon Animation */
    .dashboard-btn i {
        transition: transform 0.3s ease, color 0.3s ease;
    }

    /* Slight spin on hover */
    .dashboard-btn:hover i {
        transform: rotate(90deg);
        color: #fff;
    }

    /* small offcanvas item styling */
    .side-link {
        color: #333;
    }

        .side-link.active {
            background-color: #f8d7da;
            color: #dc3545 !important;
        }
</style>


