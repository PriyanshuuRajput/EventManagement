@using EventBooking.Client.Components.Profile
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject LoginOverlayService LoginOverlayService

<style>
    .nav-logo {
        transition: transform .3s ease, filter .3s ease;
    }

    .logo-btn {
        background: none;
        border: none;
        padding: 15px;
        cursor: pointer;
    }

        .logo-btn.spin .nav-logo {
            animation: logoSpin 0.7s cubic-bezier(.4,0,.2,1);
        }

    @@keyframes logoSpin {
        0% {
            transform: rotate(0deg) scale(1);
        }

        40% {
            transform: rotate(180deg) scale(1.15);
        }

        100% {
            transform: rotate(360deg) scale(1);
        }
    }

    .disabled-link {
        opacity: 0.5;
        cursor: not-allowed;
    }

        .disabled-link .nav-link {
            pointer-events: none;
            color: #6c757d !important;
        }

        /* Nav item styles */
        .sticky-nav .nav-link 
        {
            position: relative;
            padding: 12px 18px;
            font-weight: 500;
            color: #444;
            transition: color .3s ease;
        }

            /* Hover color */
            .sticky-nav .nav-link:hover 
            {
                color: #dc3545;
            }

            /* Underline (hidden by default) */
            .sticky-nav .nav-link::after 
            {
                content: '';
                position: absolute;
                bottom: 0px;
                left: 50%;
                width: 0%;
                height: 3px;
                background-color: #dc3545;
                transition: all .3s ease;
                transform: translateX(-50%);

                border-radius: 10px;
            }

            /* Show underline on hover */
            .sticky-nav .nav-link:hover::after 
            {
                width: 80%;
            }

            /* Active underline ALWAYS visible */
            .sticky-nav .nav-link.active 
            {
                color: #dc3545 !important;
            }

                .sticky-nav .nav-link.active::after 
                {
                    width: 80%;
                }

    .search-dropdown {
        position: absolute;
        top: 110%;
        width: 100%;
        background: #fff;
        border-radius: 6px;
        z-index: 2000;
        max-height: 320px;
        overflow-y: auto;
    }

    .search-item {
        padding: 10px 14px;
        cursor: pointer;
        border-bottom: 1px solid #eee;
    }

        .search-item:hover {
            background: #f8f9fa;
        }

    .dashboard-btn {
        position: relative;
        border: 1px solid rgba(255, 255, 255, 0.4);
        color: #f8f9fa;
        border-radius: 50%;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        background-color: transparent;
    }
    /* Hover: Glow + Scale */
    .dashboard-btn:hover {
        background-color: var(--bs-secondary);
        border-color: var(--bs-secondary);
        color: #fff;
        transform: scale(1.05);
        box-shadow: 0 0 10px rgba(108, 117, 125, 0.6);
    }

    /* Active (click) */
    .dashboard-btn:active {
        transform: scale(0.95);
        box-shadow: 0 0 5px rgba(13,110,253,0.8) inset;
    }

    /* Icon Animation */
    .dashboard-btn i {
        transition: transform 0.3s ease, color 0.3s ease;
    }

    /* Slight spin on hover */
    .dashboard-btn:hover i {
        transform: rotate(90deg);
        color: #fff;
    }

    /* small offcanvas item styling */
    .side-link {
        color: #333;
    }

        .side-link.active {
            background-color: #f8d7da;
            color: #dc3545 !important;
        }
</style>


@if (userRole != "Admin")
{

<nav class="navbar navbar-dark py-1 px-3" style="background-color:#596066">
    <div class="container-fluid">

        <!-- Logo + App Name -->
            @if (IsCheckout)
            {
                <div class="navbar-brand d-flex align-items-center"
                     style="cursor:not-allowed; opacity:.85">
                    <img src="logo.png" height="45" class="me-2" style="border-radius:10px" />
                    <span>EventiGo</span>
                </div>
            }
            else
            {
                <button class="navbar-brand d-flex align-items-center logo-btn @(spinLogo ? "spin" : "")"
                        @onclick="SpinLogo">
                    <img src="logo.png" height="45" class="me-2 nav-logo" style="border-radius:10px" />
                    <span>EventiGo</span>
                </button>
            }


       
         <!---Search bar    -->
         @if(!IsCheckout)
         {
            <div class="d-none d-lg-flex mx-auto position-relative" style="width:450px">

                <input class="form-control pe-5"
                       placeholder="Search events, categories"
                       @bind="SearchText"
                       @bind:event="oninput"
                       @onkeydown="HandleSearchKey" />

                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <button type="button"
                            class="btn position-absolute top-50 end-0 translate-middle-y me-2"
                            style="border:none;background:none"
                            @onclick="ClearSearch">
                        <i class="bi bi-x-circle-fill text-muted"></i>
                    </button>
                }

                @if (showSearchDropdown)
                {
                    <div class="search-dropdown shadow">
                        @foreach (var item in searchResults)
                        {
                            <div class="search-item"
                                 @onclick="() => NavigateFromSearch(item)">
                                <div class="fw-semibold">@item.Title</div>
                                <small class="text-muted">@item.CategoryName</small>
                            </div>
                        }

                        @if (!searchResults.Any())
                        {
                            <div class="search-item text-muted">No results found</div>
                        }
                    </div>
                    }
                    </div>
                    }
        <!-- Right Section: Profile/Login + Dashboard -->
        <div class="d-flex align-items-center " style="margin-right:30px">

            <i class="bi bi-geo-alt me-4"> Location</i>

            <!-- Profile / Login Button first -->
            @if (userRole == null)
            {
                <button class="btn btn-danger d-flex align-items-center justify-content-center"
                        style="width:80px;height:30px"
                        aria-label="Sign In"
                            @onclick="() => LoginOverlayService.ShowLogin()">
                    Sign In
                </button>
            }
            else
            {
                <ProfileMenu/>
            }
            
            <!-- Dashboard Offcanvas Toggle Button (now active) -->
            <!--<button class="btn btn-outline-light rounded-circle p-2 d-flex align-items-center justify-content-center dashboard-btn"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#dashboardOffcanvas"
                    aria-controls="dashboardOffcanvas"
                    aria-label="Dashboard">
                <i class="bi bi-list fs-5"></i>
            </button>-->
        </div>
    </div>
</nav>
}
