@using EventBooking.Client.Components.Profile
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject LoginOverlayService LoginOverlayService

<style>
    /*  Modern Navbar (Top)*/
    .modern-navbar {
        background:#404040;
        border-bottom: 1px solid #eaeaea;
        position: relative;
        z-index: 1055;
    }

        /* Fix Bootstrap overriding brand button */
        .modern-navbar .navbar-brand {
            color: #111;
            border: none;
            padding: 0 10px;
        }

            .modern-navbar .navbar-brand span {
                font-weight: 700;
                letter-spacing: 1.5px;
                color: #fff;
                margin-left:10px;
            }

        /* Nav links */
        .modern-navbar .nav-link {
            color: #ddd !important;
            font-weight: 500;
        }

            .modern-navbar .nav-link:hover {
                color: #fff !important;
            }

    /* Logo animation*/
    .nav-logo {
        transition: transform .25s ease, filter .25s ease;
    }

    .logo-btn {
        background: none;
        border: none;
    }

        .logo-btn:hover .nav-logo {
            transform: scale(1.08);
            filter: drop-shadow(0 0 8px rgba(220,53,69,.6));
        }

    /* Search box*/

    .nav-search.form-control {
        width: 100%;
        background: #f3f3f3;
        color: #222;
        border: 1px solid #e0e0e0;
        padding: 10px 40px 10px 40px;
        font-size: 0.95rem;
        /* Kill Bootstrap defaults */
        box-shadow: none;
        transition: all .25s ease;
    }

        /* Placeholder */
        .nav-search.form-control::placeholder {
            color: #000; 
            opacity: 1;
        }

        /* Focus (beats .form-control:focus) */
        .nav-search.form-control:focus {
            background: #ffffff;
            border-color: #dc3545;
            box-shadow: 0 0 0 2px rgba(220,53,69,.15);
        }



    /* Dropdown results */
    .search-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        width: 100%;
        background: #fff;
        border-radius: 12px;
        z-index: 1050;
        max-height: 320px;
        overflow-y: auto;
        box-shadow: 0 10px 30px rgba(0,0,0,.15);
    }

    .search-item {
        padding: 12px 16px;
        cursor: pointer;
        border-bottom: 1px solid #eee;
    }

        .search-item:last-child {
            border-bottom: none;
        }

        .search-item:hover {
            background: #f8f9fa;
        }

.search-icon-inside {
    position: absolute;
    top: 50%;
    left: 14px;
    transform: translateY(-50%);
    color: #6c757d;
    pointer-events: none;
    font-size: 1rem;
}

.nav-search {
    padding-left: 40px !important;
    padding-right: 42px !important;
}

.clear-search-btn {
    position: absolute;
    top: 50%;
    right: 10px;
    transform: translateY(-50%);
    background: none;
    border: none;
    padding: 0;
}

    /*
       Disabled links*/
    .disabled-link {
        opacity: .45;
        pointer-events: none;
    }

    /* 
       Category / Sticky Nav*/
    .sticky-nav {
        background: #fff;
        border-bottom: 1px solid #eee;
    }

        .sticky-nav .nav-link {
            border-radius: 999px;
            padding: 8px 16px;
            color: #444 !important;
            transition: background .2s ease, color .2s ease;
        }

            /* Active NavLink (Blazor) */
            .sticky-nav .nav-link.active {
                background: #dc3545;
                color: #fff !important;
            }

            /* Hover */
            .sticky-nav .nav-link:hover {
                background: rgba(220,53,69,.12);
                color: #dc3545 !important;
            }

    /* 
       Dashboard button*/
    .dashboard-btn {
        border: 1px solid rgba(255,255,255,.4);
        background: transparent;
        color: #fff;
        border-radius: 50%;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .25s ease;
    }

        .dashboard-btn:hover {
            background: var(--bs-secondary);
            border-color: var(--bs-secondary);
            transform: scale(1.05);
            box-shadow: 0 0 10px rgba(108,117,125,.6);
        }

        .dashboard-btn i {
            transition: transform .25s ease;
        }

        .dashboard-btn:hover i {
            transform: rotate(90deg);
        }

    /* 
       Offcanvas / Side menu*/
    .side-link {
        color: #333 !important;
        border-radius: 10px;
        margin: 4px 8px;
    }

        .side-link:hover {
            background: rgba(220,53,69,.12);
        }

        .side-link.active {
            background: #f8d7da;
            color: #dc3545 !important;
        }
    /* ===============================
       Modern Sign In Button
    ================================*/
    .signin-btn {
        background: linear-gradient( 180deg, #dc3545 0%, #c82333 100% );
        color: #fff;
        border: none;
        padding: 8px 18px;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 6px 14px rgba(220,53,69,.35), inset 0 1px 0 rgba(255,255,255,.25);
        transition: all .25s ease;
    }

        .signin-btn i {
            font-size: 1rem;
        }

        /* Hover */
        .signin-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 24px rgba(220,53,69,.45);
        }

        /* Active */
        .signin-btn:active {
            transform: translateY(0);
            box-shadow: inset 0 2px 6px rgba(0,0,0,.25);
        }

</style>


@if (userRole != "Admin")
{

<nav class="navbar modern-navbar navbar-dark py-2 px-4">
    <div class="container-fluid">

        <!-- Logo + App Name -->
            @if (IsCheckout)
            {
                <div class="navbar-brand d-flex align-items-center"
                     style="cursor:not-allowed; opacity:.85">
                    <img src="Logo.png" height="45" class="me-2" style="border-radius:10px" />
                    <span class="text-danger fw-bold">EventiGo</span>
                </div>
            }
            else
            {
                <button class="navbar-brand d-flex align-items-center logo-btn @(spinLogo ? "spin" : "")"
                        @onclick="SpinLogo">
                    <img src="Logo.png" height="45" class=" nav-logo" style="border-radius:10px" />
                    <span>EventiGo</span>
                </button>
            }


       
         <!---Search bar    -->
         @if(!IsCheckout)
         {
            <div class="d-none d-lg-flex mx-auto position-relative" style="width:500px ">

                <input class="form-control nav-search"
                       placeholder="Search events, categories"
                       style="border-radius : 20px 2px 20px 2px "
                       @bind="SearchText"
                       @bind:event="oninput"
                       @onkeydown="HandleSearchKey"
                       @onfocusout="HandleSearchFocusOut"/>
                    <i class="bi bi-search search-icon-inside"></i>
                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <button type="button"
                            class="btn position-absolute top-50 end-0 translate-middle-y me-2"
                            style="border:none;background:none"
                            @onclick="ClearSearch">
                        <i class="bi bi-x-circle-fill text-muted"></i>
                    </button>
                }

                @if (showSearchDropdown)
                {
                    <div class="search-dropdown shadow">
                        @foreach (var item in searchResults)
                        {
                            <div class="search-item"
                                 @onclick="() => NavigateFromSearch(item)">
                                <div class="fw-semibold">@item.Title</div>
                                <small class="text-muted">@item.CategoryName</small>
                            </div>
                        }

                        @if (!searchResults.Any())
                        {
                            <div class="search-item text-muted">No results found</div>
                        }
                    </div>
                    }
                    </div>
                    }
        <!-- Right Section: Profile/Login + Dashboard -->
        <div class="d-flex align-items-center text-white " style="margin-right:30px;gap:8px">

            <i class="bi bi-person-fill fs-4 text-danger"></i> @userName

            <!-- Profile / Login Button first -->
            @if (userRole == null)
            {
                <button class="btn btn-danger d-flex align-items-center justify-content-center signin-btn"
                        style="width:80px;height:30px"
                        aria-label="Sign In"
                            @onclick="() => LoginOverlayService.ShowLogin()">
                    Sign In
                </button>
            }
            else
            {
                <ProfileMenu/>
            }
            
            <!-- Dashboard Offcanvas Toggle Button (now active) -->
            <!--<button class="btn btn-outline-light rounded-circle p-2 d-flex align-items-center justify-content-center dashboard-btn"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#dashboardOffcanvas"
                    aria-controls="dashboardOffcanvas"
                    aria-label="Dashboard">
                <i class="bi bi-list fs-5"></i>
            </button>-->
        </div>
    </div>
</nav>
}
