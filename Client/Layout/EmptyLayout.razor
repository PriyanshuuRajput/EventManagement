@inherits LayoutComponentBase
@inject NavigationManager Nav

<div class="min-vh-100 d-flex flex-column bg-light">

    <!-- Top bar -->
    <div class="bg-white shadow-sm border-bottom px-4 py-2 d-flex align-items-center">
        <img src="logo2.png"
             alt="EventiGO"
             height="50"
             style="cursor:pointer"
             @onclick="GoHome" />
             <h2 class="fw-bold m-3">EventiGo</h2>
    </div>

    <div class="flex-grow-1">
        @Body
    </div>

</div>

@code {
    private void GoHome()
    {
        Nav.NavigateTo("/");
    }
}
