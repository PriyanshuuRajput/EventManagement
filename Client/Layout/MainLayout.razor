@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject LoginOverlayService LoginOverlayService
@inject SpinnerService SpinnerService


@using System.Text
@using EventBooking.Client.Pages.AccountPages
@using EventBooking.Client.SpinnerService

<style>
    .navbar-blurred {
        filter: blur(6px);
        opacity: 0.6;
        pointer-events: none;
        transition: 0.2s ease;
    }

    .blur-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        backdrop-filter: blur(6px);
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-popup {
        position: relative;
        background: #fff;
        border-radius: 12px;
        padding: 2rem;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.18);
        animation: popupAppear .25s ease;
    }

    .btn-close {
        filter: invert(0.5);
        opacity: 0.8;
        transition: all 0.1s ease;
    }

        .btn-close:hover {
            filter: invert(17%) sepia(94%) saturate(7484%) hue-rotate(345deg) brightness(96%) contrast(102%);
            transform: scale(1.15);
            opacity: 1;
        }


    @@keyframes popupAppear {
        from {
            transform: translateY(-20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
</style>

<div class="d-flex flex-column min-vh-100">

    <!-- Top Navbar -->
    <NavMenu/>

    <!-- Page content -->
    <main class="flex-grow-1 container-fluid  d-flex flex-column @(isAppearance ? "p-0": "p-4")">
        @Body
        <Spinner/>
    </main>

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 3000;">
        <div id="app-toast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="app-toast-message"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 3000;">
        <div id="app-toast"
             class="toast align-items-center border-0"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">
            <div class="d-flex">
                <div id="app-toast-message" class="toast-body">Message here</div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>



    @if (!IsCheckout())
    {
        <!-- Footer -->
        <footer class="bg-dark text-light pt-5 mt-auto">
            <div class="container">
                <div class="row">

                    <!-- Brand -->
                    <div class="col-md-3">
                        <img src="Logo.png" height="30" class="me-2" style="border-radius:10px" />
                        <span class="text-danger fw-bold">EventiGo</span>
                        <p class="small text-light mt-4">
                            Discover events, book tickets, and manage experiences effortlessly.
                        </p>
                    </div>

                    <!-- Explore -->
                    <div class="col-md-3">
                        <h6 class="fw-semibold">Explore</h6>
                        <ul class="list-unstyled small">
                            <li>Events</li>
                            <li>Categories</li>
                            <li>Cities</li>
                            <li>Venues</li>
                        </ul>
                    </div>

                    <!-- Organizers -->
                    <div class="col-md-3">
                        <h6 class="fw-semibold">For Organizers</h6>
                        <ul class="list-unstyled small">
                            <li>Host an Event</li>
                            <li>Manager Signup</li>
                            <li>How It Works</li>
                        </ul>
                    </div>

                    <!-- Support -->
                    <div class="col-md-3">
                        <h6 class="fw-semibold">Support</h6>
                        <ul class="list-unstyled small">
                            <li>Help Center</li>
                            <li>FAQs</li>
                            <li>Contact Us</li>
                        </ul>
                    </div>

                </div>

                <hr class="border-secondary" />

                <div class="d-flex justify-content-between small text-light">
                    <span>© 2026 EventiGo. All rights reserved.</span>
                    <span>Privacy · Terms · Cookies</span>
                </div>
            </div>
        </footer>
    }
</div>

@if (currentView != OverlayView.None)
{
    <div class="blur-overlay" @onclick="CloseOverlay">
        <div class="login-popup" @onclick:stopPropagation>

            @if (currentView == OverlayView.Login)
            {
                <h4 class="text-center text-danger mb-3">Welcome Back</h4>
                <p class="text-center text-muted mb-4">Login to continue</p>

                <UserLogin email="@email"
                           OnSuccess="OnLoginSuccess"
                           OnCancel="CloseOverlay"
                           OnSwitchToSignup="ShowUserSignup"
                           OnForgotPassword="ShowForgotPassword" />
            }
            else if (currentView == OverlayView.Signup)
            {
                @if (SignupMode == "User")
                {
                    <SignUp OnCancel="CloseOverlay"
                            OnSwitchToLogin="ShowLoginOverlay" />
                }
                else
                {
                    <ManagerSignUp OnCancel="CloseOverlay" />
                }
            }
            else if (currentView == OverlayView.ForgotPassword)
            {
                <ForgotPassword OnBack="ShowLoginOverlay" />
            }

        </div>
    </div>
}

@code {

    enum OverlayView
    {
        None,
        Login,
        Signup,
        ForgotPassword
    }
    private OverlayView currentView = OverlayView.None;
    private string SignupMode = "User";

    private bool isAppearance => Navigation.Uri.Contains("/appearance");

    private string? email;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            SpinnerService.Enable();
        }
    }
    protected override void OnInitialized()
    {
        LoginOverlayService.OnShowLogin += ShowLoginOverlay;
        LoginOverlayService.OnShowManagerSignup += ShowManagerSignup;
        LoginOverlayService.OnShowForgetPassword += ShowForgotPassword;

        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        if (query["loginEmail"] != null)
        {
            var encodedEmail = query["loginEmail"];

            try
            {
                var decodedBytes = Convert.FromBase64String(Uri.UnescapeDataString(encodedEmail));
                email = Encoding.UTF8.GetString(decodedBytes);
            }
            catch
            {
                email = encodedEmail;
            }

            currentView = OverlayView.Login;
        }
    }
    private void OnLoginSuccess()
    {
        currentView = OverlayView.None;

        var returnUrl = LoginOverlayService.ReturnUrl;
        LoginOverlayService.ClearReturnUrl();

        if (!string.IsNullOrWhiteSpace(returnUrl))
        {
            Navigation.NavigateTo(returnUrl, replace: true);
        }
        else
        {
            Navigation.NavigateTo("/events");
        }
    }

    public void ShowLoginOverlay()
    {
        currentView = OverlayView.Login;
        StateHasChanged();
    }

    private void ShowUserSignup()
    {
        SignupMode = "User";
        currentView = OverlayView.Signup;
        StateHasChanged();
    }

    public void ShowManagerSignup()
    {
        SignupMode = "Manager";
        currentView = OverlayView.Signup;
        StateHasChanged();
    }

    private void ShowForgotPassword()
    {
        currentView = OverlayView.ForgotPassword;
        StateHasChanged();
    }

    private void CloseOverlay()
    {
        currentView = OverlayView.None;
        StateHasChanged();
    }

    private bool IsCheckout()
    {
        return Navigation.Uri.Contains("/checkout");
    }
    public void Dispose()
    {
        LoginOverlayService.OnShowLogin -= ShowLoginOverlay;
        LoginOverlayService.OnShowManagerSignup -= ShowManagerSignup;
        LoginOverlayService.OnShowForgetPassword -= ShowForgotPassword;
    }


}

