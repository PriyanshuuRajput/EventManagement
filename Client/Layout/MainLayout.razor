@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using System.Text
@using EventBooking.Client.Pages.AccountPages



<style>
    .navbar-blurred {
        filter: blur(6px);
        opacity: 0.6;
        pointer-events: none;
        transition: 0.2s ease;
    }

    .blur-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        backdrop-filter: blur(6px);
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-popup {
        position: relative;
        background: #fff;
        border-radius: 12px;
        padding: 2rem;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.18);
        animation: popupAppear .25s ease;
    }

    .btn-close {
        filter: invert(0.5);
        opacity: 0.8;
        transition: all 0.1s ease;
    }

        .btn-close:hover {
            filter: invert(17%) sepia(94%) saturate(7484%) hue-rotate(345deg) brightness(96%) contrast(102%);
            transform: scale(1.15);
            opacity: 1;
        }


    @@keyframes popupAppear {
        from {
            transform: translateY(-20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
</style>

<div class="d-flex flex-column min-vh-100">

    <!-- Top Navbar -->
    <NavMenu OnShowLogin="ShowLoginOverlay" />


    <!-- Page content -->
    <main class="flex-grow-1 container-fluid p-4">
        @Body
        <Spinner/>
    </main>

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 3000;">
        <div id="app-toast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="app-toast-message"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 3000;">
        <div id="app-toast"
             class="toast align-items-center border-0"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">
            <div class="d-flex">
                <div id="app-toast-message" class="toast-body">Message here</div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>




    <!-- Footer -->
    <footer class="bg-dark text-light text-center py-3 mt-auto">
        <small>© 2025 EventiGO - All rights reserved.</small>
    </footer>
</div>

@if (IsLoginVisible || IsSignupVisible)
{
    <div class="blur-overlay" @onclick="CloseOverlay">
        <div class="login-popup" @onclick:stopPropagation>
            @if (IsLoginVisible)
            {
                <h4 class="text-center text-danger mb-3">Welcome Back</h4>
                <p class="text-center text-muted mb-4">Login to continue</p>

                <!-- Reusable Login Component -->
                <UserLogin email="@email"
                           OnSuccess="CloseOverlay"
                           OnCancel="CloseOverlay"
                           OnSwitchToSignup="ShowUserSignup" />
            }
            else if (IsSignupVisible)
            {
                @if (SignupMode == "User")
                {
                    <SignUp OnCancel="CloseOverlay"
                            OnSwitchToLogin="ShowLoginOverlay" />
                }
                else if (SignupMode == "Manager")
                {
                    <ManagerSignUp OnCancel="CloseOverlay" />
                }
            }

        </div>
    </div>
}

@code {
    private bool IsLoginVisible = false;
    private bool IsSignupVisible = false;

    private string SignupMode = "User";

    public static MainLayout Instance { get; private set; }
    private string? email;
    protected override void OnInitialized()
    {
        Instance = this;

        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        // Detect ?loginEmail=encodedString
        if (query["loginEmail"] != null)
        {
            var encodedEmail = query["loginEmail"];

            try
            {
                var decodedBytes = Convert.FromBase64String(Uri.UnescapeDataString(encodedEmail));
                email = Encoding.UTF8.GetString(decodedBytes);
            }
            catch
            {
                email = encodedEmail;
            }

            IsLoginVisible = true;
            IsSignupVisible = false;
            return;
        }
    }



    public void ShowLoginOverlay()
    {
        IsSignupVisible = false;
        IsLoginVisible = true;
        StateHasChanged();
    }

    private void CloseOverlay()
    {
        IsSignupVisible = false;
        IsLoginVisible = false;
        StateHasChanged();
    }

    private void ShowUserSignup()
    {
        SignupMode = "User";
        IsLoginVisible = false;
        IsSignupVisible = true;
        StateHasChanged();
    }

    public void ShowManagerSignup()
    {
        SignupMode = "Manager";
        IsSignupVisible = true;
        IsLoginVisible = false;
        StateHasChanged();
    }


    //private void ShowSignupOverlay()
    //{
    //    IsLoginVisible = false;
    //    IsSignupVisible = true;
    //    StateHasChanged();
    //}


}

