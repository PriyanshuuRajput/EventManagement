@using EventBooking.Client.SpinnerService

@inject SpinnerService spinnerservice

<style>
    .spinner-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 99999;
        backdrop-filter: blur(3px);
    }

    .equalizer-loader {
        display: flex;
        gap: 6px;
        height: 40px;
    }

        .equalizer-loader div {
            width: 6px;
            background: #dc3545;
            border-radius: 4px;
            animation: sound 0.7s linear infinite;
        }

            .equalizer-loader div:nth-child(1) {
                animation-delay: 0s;
            }

            .equalizer-loader div:nth-child(2) {
                animation-delay: 0.15s;
            }

            .equalizer-loader div:nth-child(3) {
                animation-delay: 0.3s;
            }

            .equalizer-loader div:nth-child(4) {
                animation-delay: 0.45s;
            }

    @@keyframes sound {
        0% {
            height: 10px;
        }

        50% {
            height: 40px;
        }

        100% {
            height: 15px;
        }
    }
</style>

@if (isVisible)
{
    <div class="spinner-overlay">
        <div class="equalizer-loader">
            <div></div><div></div><div></div><div></div>
        </div>
    </div>
}

@code {
    private bool isVisible;

    protected override void OnInitialized()
    {
        spinnerservice.OnShow += ShowSpinner;
        spinnerservice.OnHide += HideSpinner;
    }

    private void ShowSpinner()
    {
        isVisible = true;
        InvokeAsync(StateHasChanged);
    }

    private void HideSpinner()
    {
        isVisible = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        spinnerservice.OnShow -= ShowSpinner;
        spinnerservice.OnHide -= HideSpinner;
    }
}
