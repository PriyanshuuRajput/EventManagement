@code {
    [Parameter] public EventCallback OnClose { get; set; }

    ManagerSignUpDto NewManager = new();
    string? emailError;
    bool isProcessing = false;

    void Close()
    {
        OnClose.InvokeAsync();
    }

    private async Task AddManagerAsync()
    {
        if (isProcessing) return;

        isProcessing = true;
        emailError = null;

        var response = await Http.PostAsJsonAsync("api/Account/manager-signup", NewManager);

        if (response.IsSuccessStatusCode)
        {
            toast.ShowSuccess("Manager added successfully!");

            await OnClose.InvokeAsync(); 
            return;
        }

        var errorText = await response.Content.ReadAsStringAsync();
        try
        {
            using var doc = JsonDocument.Parse(errorText);
            var errors = doc.RootElement.GetProperty("errors");
            emailError = errors.EnumerateObject().First().Value[0].GetString();
        }
        catch
        {
            emailError = errorText;
        }

        toast.ShowError(emailError);
        isProcessing = false;
    }
}
