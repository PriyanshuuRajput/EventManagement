@using Applications.Dto
@using Microsoft.AspNetCore.Components.Forms

@if (Visible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 shadow">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">@(City.Id > 0 ? "Edit City" : "Add City")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>

                <div class="modal-body">
                    <EditForm Model="City" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">City Name</label>
                            <InputText class="form-control" @bind-Value="City.CityName" />
                            <ValidationMessage For="@(() => City.CityName)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">State</label>
                            @*<InputText class="form-control" @bind-Value="City.State" />
                            <ValidationMessage For="@(() => City.State)" />*@
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Country</label>
                            <InputSelect class="form-select" @bind-Value="City.CountryId">
                                <option value="">-- Select Country --</option>
                                @foreach (var country in countries)
                                {
                                    <option value="@country.Id">@country.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => City.CountryId)" />
                        </div>


                        <div class="mt-3 d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="Close">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </EditForm>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public CityDto City { get; set; } = new();
    [Parameter] public EventCallback<CityDto> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    private List<CountryDto> countries = new();

    private async Task HandleValidSubmit()
    {
        await OnSave.InvokeAsync(City);
        await Close();
    }

    private async Task Close()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnClose.InvokeAsync();
    }
}
