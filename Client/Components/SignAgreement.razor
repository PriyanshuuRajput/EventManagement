@namespace EventBooking.Client.Components
@using Applications.Dto

<h4>Sign Agreement</h4>
<p>Please read and accept the agreement.</p>

<textarea readonly rows="10" class="form-control mb-2">
[Agreement Text Here]
</textarea>

<div class="form-check mb-2">
    <InputCheckbox @bind-Value="AccountDto.AgreementAccepted" class="form-check-input" />
    <label class="form-check-label">I accept the agreement</label>
</div>

<div>
    <button class="btn btn-secondary me-2" @onclick="HandleBack">Back</button>
    <button class="btn btn-primary" @onclick="HandleFinish" disabled="!AccountDto.AgreementAccepted">Finish</button>
</div>

@code {
    [Parameter] public AccountSetupDto? AccountDto { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnFinish { get; set; }

    private async Task HandleBack() => await OnBack.InvokeAsync();
    private async Task HandleFinish() => await OnFinish.InvokeAsync();
}
