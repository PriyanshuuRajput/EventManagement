@using EventBooking.Client.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject LoginOverlayService LoginOverlayService


<style>
    .profile-icon {
        width: 40px;
        height: 40px;
        border-radius: 0px 0px 10px 10px ;
        border: 2px solid rgba(220, 53, 69, 0.4);
        color: #dc3545;
        transform-origin: top center;
        transition: transform 0.45s ease, opacity 0.3s ease;
    }
    .profile-icon.open{
            transform: perspective(600px) rotateX(90deg);
            opacity: 0;
    }

        .profile-icon {
            font-size: 24px;
        }

    .profile-img {
        width: 70px;
        height: 70px;
        border-radius: 6px;
        object-fit: cover;
        border: 2px solid rgba(220, 53, 69, 0.4);
    }

    .drawer-panel0 {
        position: fixed;
        top: 0;
        right: 0;
        width: 360px;
        height: 100vh;
        background: #fff;
        display: flex;
        flex-direction: column;
        z-index: 2100;
        animation: slideIn 0.4s ease-out;
    }

    .drawer-header {
        padding: 14px 16px;
        border-bottom: 1px solid #eee;
    }

    .drawer-body {
        flex: 1;
        padding: 16px;
        overflow-y: auto;
    }

    .drawer-footer {
        padding: 14px;
        border-top: 1px solid #eee;
        background: #fff;
    }

    .drawer-item {
        width: 100%;
        text-align: left;
        padding: 12px 14px;
        border-radius: 8px;
        background: #f8f9fa;
        border: none;
        margin-bottom: 10px;
        font-weight: 500;
    }

        .drawer-item:hover:not(:disabled) {
            background: #dc3545;
            color: #fff;
        }


    @@keyframes slideIn {
        from {
            transform: translateX(100%);
        }

        to {
            transform: translateX(0);
        }
    }
  


</style>

<div>
    @if (!isAuthenticated)
    {
        <!-- SIGN IN -->
        <button class="btn btn-danger"
                @onclick="ShowLogin">
            <i class="bi bi-person-circle"></i> Sign In
        </button>
    }
    else
    {
        <!-- PROFILE DROPDOWN -->
        <button class="profile-icon d-flex align-items-center justify-content-center @(openAnimation ?" open":"")"
                aria-label="Profile"
                @onclick="OpenProfile">
            <i class="bi bi-person"></i>
        </button>
    @if (showDrawer)
    {
            <div class="drawer-overlay" @onclick="CloseDrawer"></div>

            <div class="drawer-panel0">

                <!-- HEADER -->
                <div class="drawer-header d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">My Account</h3>
                    <button class="btn-close" @onclick="CloseDrawer"></button>
                </div>

                <!-- BODY -->
                <div class="drawer-body">

                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img src="@ProfileImageUrl" class="profile-img" />
                        <div>
                            <div class="fw-semibold">Hi, @Name</div>
                            <div class="text-muted small">@userEmail</div>

                            <button class="btn btn-outline-secondary btn-sm mt-2" disabled
                                    @onclick="@(() => NavigateTo("/profile/edit"))">
                                <i class="bi bi-pencil-square me-2"></i>Edit
                            </button>
                        </div>
                    </div>

                    <hr />

                    @if (role == "Manager")
                    {
                        <button class="drawer-item" @onclick="@(() => NavigateTo("/manager-profile"))">
                            Dashboard
                        </button>

                        <button class="drawer-item" @onclick="@(() => NavigateTo("/manage-events"))">
                            Manage Events
                        </button>

                        <button class="drawer-item" @onclick="@(() => NavigateTo("/booking-earning"))">
                            Booking & Earnings
                        </button>
                    }

                    <button class="drawer-item" disabled>
                        Account Settings
                    </button>
                </div>

                <!-- FOOTER -->
                <div class="drawer-footer">
                    <button class="btn btn-danger " @onclick="Logout">
                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                    </button>
                </div>

            </div>
    }
}
</div>


@code {

    private bool isAuthenticated;
    private bool openAnimation;
    private bool showDrawer;
    private string? userName;
    private string? userEmail;
    private string? role;
    private string? fullName;
    private string? profileImage;

    private string Name => !string.IsNullOrWhiteSpace(fullName) ? fullName : !string.IsNullOrWhiteSpace(userName) ? userName : "there";

    private string ProfileImageUrl =>!string.IsNullOrWhiteSpace(profileImage)? profileImage: "avtar.png";
    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        await LoadUser();
    }

    private async Task LoadUser()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;

        isAuthenticated = principal.Identity?.IsAuthenticated == true;

        if (isAuthenticated)
        {
            userName = principal.Identity?.Name ?? "User";
            userEmail = principal.FindFirst("email")?.Value ?? "";
            fullName = principal.FindFirst("fullName")?.Value;
            profileImage = principal.FindFirst("profileImage")?.Value;
            role = principal.FindFirst(ClaimTypes.Role)?.Value ?? "User";

        }
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        await LoadUser();
        StateHasChanged();
    }

    private async Task OpenProfile()
    {
        openAnimation = true;
        StateHasChanged();

        await Task.Delay(400);

        showDrawer = true;
        openAnimation = false;
        StateHasChanged();
    }

    private void CloseDrawer()
    {
        showDrawer = false;
    } 
    private void ShowLogin()
    {
        LoginOverlayService.ShowLogin();
    }


    private void NavigateTo(string url)
    {
        showDrawer = false;
        Navigation.NavigateTo(url);
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");

        if (AuthStateProvider is CustomAuthStateProvider customProvider)
        {
            customProvider.NotifyUserLogout();
        }

        Navigation.NavigateTo("/", true);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}
